# Copy to .env.development and fill in the values you need. See
# docs/reference/configuration.md for the full list of supported variables and
# their defaults.

# ─── Required secrets (no defaults — must be set in all environments) ────────
# Generate with: openssl rand -hex 64
RAILS_SECRET_KEY_BASE=replace_with_64_byte_hex_secret

# Generate with: openssl rand -hex 32
CREDENTIALS_SECRET_KEY=replace_with_32_byte_hex_key
CONFIG_ITEMS_SECRET_KEY=replace_with_32_byte_hex_key
INTEGRATIONS_SECRET_KEY=replace_with_32_byte_hex_key
OAUTH_SECRET_KEY=replace_with_32_byte_hex_key

# Admin panel password (used by Web::AdminController)
ADMIN_PASSWORD=replace_with_strong_password

# Docs basic-auth password
DOCS_PASSWORD=replace_with_docs_password
# ─────────────────────────────────────────────────────────────────────────────

# Everything below is optional for a local run.

# Google SSO (OmniAuth) — only needed if you want sign-in via Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App integration — only needed for the GitHub board/webhook features
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_URL=https://github.com/apps/3po-test-dev-app
GITHUB_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----
paste real key here
-----END RSA PRIVATE KEY-----'
GITHUB_WEBHOOK_SECRET=

# Bitbucket and GitLab repository integrations
BITBUCKET_OAUTH_KEY=
BITBUCKET_OAUTH_SECRET=
GITLAB_APP_ID=
GITLAB_APP_SECRET=

# Skills.sh registry (optional) — pulls reusable agent skills
SKILLS_SH_API_KEY=

# Context7 documentation MCP (optional)
CONTEXT7_API_KEY=

# Sentry frontend DSN — set as a build-time env var in CI/CD (VITE_ prefix makes it
# available to the Vite bundle; it is NOT exposed in HTML source at runtime)
VITE_SENTRY_FRONTEND_DSN=
