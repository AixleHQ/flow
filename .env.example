# Copy to .env.development and fill in the values you need. Every variable the
# app reads is defined in config/settings.yml and documented in
# docs/reference/configuration.md; this file covers the ones you are likely to
# need for a local run.

# Concurrent sessions. Set SESSION_CONCURRENCY_LIMIT and the whole installation
# shares one queue of that size; leave it unset and each project gets its own
# queue (and each project-less agent login, its user's). A row in
# session_concurrency_limits for a specific project or user overrides the
# default below — edit those in the admin, not here.
#
# The two defaults are read live, so an edit here takes effect on the next boot.
# SESSION_CONCURRENCY_LIMIT is different: it decides which pool a session
# belongs to, and re-homing live sessions has to be gated on a drain, so it is
# written into the database policy by `bin/rails session_admission:sync` in a
# maintenance window.
# SESSION_CONCURRENCY_LIMIT=4
SESSION_PROJECT_CONCURRENCY_DEFAULT=2
SESSION_USER_CONCURRENCY_DEFAULT=2

# ─── Required in production (config/initializers/required_env.rb) ─────────────
# Generate with: openssl rand -hex 64
RAILS_SECRET_KEY_BASE=replace_with_64_byte_hex_secret

# Generate with: openssl rand -hex 32
CREDENTIALS_SECRET_KEY=replace_with_32_byte_hex_key
CONFIG_ITEMS_SECRET_KEY=replace_with_32_byte_hex_key
INTEGRATIONS_SECRET_KEY=replace_with_32_byte_hex_key
OAUTH_SECRET_KEY=replace_with_32_byte_hex_key
# ─────────────────────────────────────────────────────────────────────────────

# Admin panel password (Web::AdminController)
ADMIN_PASSWORD=replace_with_strong_password

# Docs basic auth
DOCS_LOGIN=docs
DOCS_PASSWORD=replace_with_docs_password

# Google SSO (OmniAuth) — only needed if you want sign-in via Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App integration — only needed for the GitHub board/webhook features
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----
paste real key here
-----END RSA PRIVATE KEY-----'
GITHUB_WEBHOOK_SECRET=

# Raises the api.github.com rate limit for the public skills catalog from 60 to
# 5,000 requests/hour. Needs no scopes; never use a tenant installation token.
GITHUB_PUBLIC_READ_TOKEN=

# Sentry — browser DSN is public by design; the server passes it to the frontend
SENTRY_FRONTEND_DSN=
