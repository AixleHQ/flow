{
  "description": "A spent refresh token presented again at once, before the pair its spend issued was used, is a retry after a lost response: it answers 200 with a fresh pair of the same family, and the pair that was never picked up answers 401 invalid_token.",
  "steps": [
    {"given": "registered_machine", "as": "m"},
    {
      "request": {"method": "POST", "path": "/runner/v1/token", "token": "{{m.refresh_token}}"},
      "response": {
        "status": 200,
        "body": {
          "access_token": {"$prefix": "aracc_"},
          "access_token_expires_at": {"$type": "timestamp"},
          "refresh_token": {"$prefix": "arref_"},
          "refresh_token_expires_at": {"$type": "timestamp"}
        }
      },
      "capture": {"lost.access_token": "/access_token", "lost.refresh_token": "/refresh_token"}
    },
    {
      "request": {"method": "POST", "path": "/runner/v1/token", "token": "{{m.refresh_token}}"},
      "response": {
        "status": 200,
        "headers": {"Cache-Control": "no-store"},
        "body": {
          "access_token": {"$prefix": "aracc_"},
          "access_token_expires_at": {"$type": "timestamp"},
          "refresh_token": {"$prefix": "arref_"},
          "refresh_token_expires_at": {"$type": "timestamp"}
        }
      },
      "capture": {"retried.access_token": "/access_token", "retried.refresh_token": "/refresh_token"}
    },
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{lost.access_token}}"},
      "response": {"status": 401, "body": {"error": "invalid_token", "message": {"$type": "string"}}}
    },
    {
      "request": {"method": "POST", "path": "/runner/v1/token", "token": "{{lost.refresh_token}}"},
      "response": {"status": 401, "body": {"error": "invalid_token", "message": {"$type": "string"}}}
    },
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{retried.access_token}}"},
      "response": {"status": 200, "body": {"ops": []}}
    },
    {
      "request": {"method": "POST", "path": "/runner/v1/token", "token": "{{retried.refresh_token}}"},
      "response": {
        "status": 200,
        "body": {
          "access_token": {"$prefix": "aracc_"},
          "access_token_expires_at": {"$type": "timestamp"},
          "refresh_token": {"$prefix": "arref_"},
          "refresh_token_expires_at": {"$type": "timestamp"}
        }
      }
    }
  ]
}
