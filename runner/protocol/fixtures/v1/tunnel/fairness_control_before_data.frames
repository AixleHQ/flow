# A PING that arrives while a busy stream has data queued is answered before the next DATA frame.
# (format: runner/protocol/fixtures/README.md)
@only relay
@config max_frame=1024 window=4096 buffer=0

> 01 00000000 7b2276223a312c226d61785f6672616d65223a313032342c226d61785f73747265616d73223a36342c2277696e646f77223a343039362c2270696e675f696e74657276616c223a32302c2273657373696f6e5f6964223a6e756c6c7d # relay HELLO {"v":1,"max_frame":1024,"max_streams":64,"window":4096,"ping_interval":20,"session_id":null}
< 01 00000000 7b2276223a312c226d61785f6672616d65223a313032342c226d61785f73747265616d73223a36342c2277696e646f77223a343039362c2272756e6e65725f76657273696f6e223a22312e302e30227d # runner HELLO {"v":1,"max_frame":1024,"max_streams":64,"window":4096,"runner_version":"1.0.0"}
@do open session=123 port=7681
> 02 00000001 7b2273657373696f6e5f6964223a3132332c22706f7274223a373638317d # OPEN {"session_id":123,"port":7681}
@do accept session=123 port=7681
< 03 00000001                                  # OPEN_OK
@do write side=relay data=61{4096}
# The writer holds the first frame; the PING arrives; its PONG goes next, ahead of the three frames left.
< 08 00000000 0000000000000001
> 04 00000001 61{1024}                         # the frame the writer already held
> 09 00000000 0000000000000001                 # control frame: waits for one DATA frame at most
> 04 00000001 61{1024}
> 04 00000001 61{1024}
> 04 00000001 61{1024}
