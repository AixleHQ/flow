< 01 00000000 7b2276223a312c226d61785f6672616d65223a313032342c226d61785f73747265616d73223a36342c2277696e646f77223a323034382c2272756e6e65725f76657273696f6e223a22312e302e30227d # runner HELLO {"v":1,"max_frame":1024,"max_streams":64,"window":2048,"runner_version":"1.0.0"}
@do open session=123 port=7681
