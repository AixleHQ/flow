# The relay resets while its Write is blocked with DATA on the wire.
# (format: runner/protocol/fixtures/README.md)
@config max_frame=1024 window=2048

> 01 00000000 7b2276223a312c226d61785f6672616d65223a313032342c226d61785f73747265616d73223a36342c2277696e646f77223a323034382c2270696e675f696e74657276616c223a32302c2273657373696f6e5f6964223a6e756c6c7d # relay HELLO {"v":1,"max_frame":1024,"max_streams":64,"window":2048,"ping_interval":20,"session_id":null}
< 01 00000000 7b2276223a312c226d61785f6672616d65223a313032342c226d61785f73747265616d73223a36342c2277696e646f77223a323034382c2272756e6e65725f76657273696f6e223a22312e302e30227d # runner HELLO {"v":1,"max_frame":1024,"max_streams":64,"window":2048,"runner_version":"1.0.0"}
@do open session=123 port=7681
> 02 00000001 7b2273657373696f6e5f6964223a3132332c22706f7274223a373638317d # OPEN {"session_id":123,"port":7681}
@do accept session=123 port=7681
< 03 00000001                                  # OPEN_OK
@do write side=relay data=61{4096} reset=cancelled
> 04 00000001 61{1024}                         # first frame
> 04 00000001 61{1024}                         # second frame: the credit (2048) is spent
@quiet
@do reset side=relay code=cancelled
> 07 00000001 01                               # RESET jumps the queue; the blocked Write ends with it
@do read side=runner reset=cancelled
