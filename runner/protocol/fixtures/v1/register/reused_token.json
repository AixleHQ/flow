{
  "description": "A registration token registers one machine only: a second use is 401 invalid_token.",
  "steps": [
    {"given": "registration_token", "as": "reg"},
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"},
          "ephemeral": false
        }
      },
      "response": {"status": 201}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "body": {
          "name": "build-02",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"},
          "ephemeral": false
        }
      },
      "response": {"status": 401, "body": {"error": "invalid_token", "message": {"$type": "string"}}}
    }
  ]
}
