{
  "description": "check-in is refused like every endpoint that takes the access token (PROTOCOL.md \u00a73): a bad header before the token, a token of another kind or an unknown one, a machine that unregistered, and the flag turned off (the credentials stay valid).",
  "steps": [
    {
      "given": "registered_machine",
      "as": "m"
    },
    {
      "given": "registration_token",
      "as": "reg"
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/check-in",
        "token": "{{m.refresh_token}}",
        "body": {
          "os": "linux",
          "arch": "amd64",
          "facts": {}
        }
      },
      "response": {
        "status": 401,
        "body": {
          "error": "invalid_token",
          "message": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/check-in",
        "token": "{{reg}}",
        "body": {
          "os": "linux",
          "arch": "amd64",
          "facts": {}
        }
      },
      "response": {
        "status": 401,
        "body": {
          "error": "invalid_token",
          "message": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/check-in",
        "token": "{{m.access_token}}",
        "body": {
          "os": "linux",
          "arch": "amd64",
          "facts": {}
        },
        "headers": {
          "X-Aixle-Runner-Version": "v1.4"
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": "invalid_runner_version",
          "message": {
            "$type": "string"
          }
        }
      }
    },
    {
      "given": "flag_off"
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/check-in",
        "token": "{{m.access_token}}",
        "body": {
          "os": "linux",
          "arch": "amd64",
          "facts": {}
        }
      },
      "response": {
        "status": 403,
        "body": {
          "error": "runners_disabled",
          "message": {
            "$type": "string"
          }
        }
      }
    },
    {
      "given": "flag_on"
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/check-in",
        "token": "{{m.access_token}}",
        "body": {
          "os": "linux",
          "arch": "amd64",
          "facts": {}
        }
      },
      "response": {
        "status": 200,
        "body": {
          "environment": {
            "id": {
              "$type": "integer"
            },
            "key": {
              "$type": "string"
            },
            "display_name": {
              "$type": "string"
            },
            "state": "registered"
          },
          "config": {
            "upload_max_bytes": {
              "$type": "integer"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "path": "/runner/v1/registration",
        "token": "{{m.access_token}}"
      },
      "response": {
        "status": 204
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/check-in",
        "token": "{{m.access_token}}",
        "body": {
          "os": "linux",
          "arch": "amd64",
          "facts": {}
        }
      },
      "response": {
        "status": 401,
        "body": {
          "error": "invalid_token",
          "message": {
            "$type": "string"
          }
        }
      }
    }
  ]
}
