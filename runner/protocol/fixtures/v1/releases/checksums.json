{
  "description": "The checksums of a pinned release are the digests the platform pins for each of its binaries, by `<os>-<arch>`, not cacheable. They take no token.",
  "steps": [
    {
      "given": "release_pins",
      "min_version": "1.2.0",
      "recommended_version": "1.5.0",
      "binaries": {
        "1.5.0": {
          "linux-amd64": {
            "sha256": "4444444444444444444444444444444444444444444444444444444444444444"
          },
          "linux-arm64": {
            "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/releases/1.5.0/checksums",
        "headers": {
          "X-Aixle-Runner-Protocol": null,
          "X-Aixle-Runner-Version": null
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store"
        },
        "body": {
          "version": "1.5.0",
          "binaries": {
            "linux-amd64": {
              "sha256": "4444444444444444444444444444444444444444444444444444444444444444"
            },
            "linux-arm64": {
              "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            }
          }
        }
      }
    }
  ]
}
