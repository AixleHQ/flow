{
  "description": "X-Aixle-Runner-Version must be a strict Semantic Versioning 2.0 version (PROTOCOL.md §1): a missing value, `latest`, `v1.4.0`, `1.4`, `1.2.3-` and `1.2.3+` are 400 invalid_runner_version, and so are `01.2.3`, `1.2.3-01` and `1.2.3-..`, which SemVer 2.0 refuses. A pre-release with build metadata is accepted.",
  "steps": [
    {"given": "registration_token", "as": "reg"},
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "headers": {"X-Aixle-Runner-Version": null},
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"}
        }
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "headers": {"X-Aixle-Runner-Version": "latest"},
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"}
        }
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "headers": {"X-Aixle-Runner-Version": "v1.4.0"},
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"}
        }
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "headers": {"X-Aixle-Runner-Version": "1.4"},
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"}
        }
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {"given": "registered_machine", "as": "m"},
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}",
        "headers": {"X-Aixle-Runner-Version": "1.2.3-"}
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}",
        "headers": {"X-Aixle-Runner-Version": "1.2.3+"}
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}",
        "headers": {"X-Aixle-Runner-Version": "01.2.3"}
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}",
        "headers": {"X-Aixle-Runner-Version": "1.2.3-01"}
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}",
        "headers": {"X-Aixle-Runner-Version": "1.2.3-.."}
      },
      "response": {"status": 400, "body": {"error": "invalid_runner_version", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "headers": {"X-Aixle-Runner-Version": "1.5.0-rc.1+build.7"},
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"}
        }
      },
      "response": {"status": 201}
    }
  ]
}
