{
  "description": "An image.ensure op is delivered with its {image} payload, a reference by tag or by digest (PROTOCOL.md §6.1). The runner always pulls it and reports whether the pull brought a new image and how long it took. A failed pull is an error result that carries the registry's message.",
  "steps": [
    {"given": "registered_machine", "as": "m"},
    {
      "given": "op_enqueued",
      "machine": "m",
      "as": "pulled",
      "op": "image.ensure",
      "payload": {
        "image": "ghcr.io/aixlehq/flow-agent-claude-code:latest"
     }
   },
    {
      "given": "op_enqueued",
      "machine": "m",
      "as": "missing",
      "op": "image.ensure",
      "payload": {
        "image": "ghcr.io/aixlehq/flow-agent-claude-code@sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
     }
   },
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{m.access_token}}"},
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {"$var": "pulled.id"},
              "sequence": {"$var": "pulled.sequence"},
              "op": "image.ensure",
              "deadline_at": {"$var": "pulled.deadline_at"},
              "payload": {
                "image": "ghcr.io/aixlehq/flow-agent-claude-code:latest"
             }
           },
            {
              "id": {"$var": "missing.id"},
              "sequence": {"$var": "missing.sequence"},
              "op": "image.ensure",
              "deadline_at": {"$var": "missing.deadline_at"},
              "payload": {
                "image": "ghcr.io/aixlehq/flow-agent-claude-code@sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
             }
           }
          ]
       }
     }
   },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{pulled.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "ok", "data": {"pulled": true, "duration_ms": 41250}}
     },
      "response": {"status": 200, "body": {"id": {"$var": "pulled.id"}, "state": "completed"}}
   },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{missing.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "error",
          "error": {
            "class": "image_pull_failed",
            "message": "pulling ghcr.io/aixlehq/flow-agent-claude-code@sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 failed: manifest unknown"
         }
       }
     },
      "response": {"status": 200, "body": {"id": {"$var": "missing.id"}, "state": "failed"}}
   },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after={{missing.sequence}}&wait=0",
        "token": "{{m.access_token}}"
     },
      "response": {"status": 200, "body": {"ops": []}}
   }
  ]
}
