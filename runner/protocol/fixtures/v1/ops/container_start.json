{
  "description": "container.start creates and starts the session's agent container from the image reference it is given (a tag or a digest), with the payload's env, mounts, network, pid and resources (PROTOCOL.md §6.2). Over another session's container it answers session_mismatch, over a container of the environment that names no session container_exists, and a bind that would expose the runner's state directory is refused with forbidden_mount.",
  "steps": [
    {
      "given": "registered_machine",
      "as": "m"
    },
    {
      "given": "session_on_machine",
      "machine": "m",
      "as": "s"
    },
    {
      "given": "session_on_machine",
      "machine": "m",
      "as": "s2"
    },
    {
      "given": "session_on_machine",
      "machine": "m",
      "as": "s3"
    },
    {
      "given": "session_on_machine",
      "machine": "m",
      "as": "s4"
    },
    {
      "given": "op_enqueued",
      "machine": "m",
      "session": "s",
      "as": "started",
      "op": "container.start",
      "payload": {
        "image": "ghcr.io/aixlehq/flow-claude-code:latest",
        "env": {
          "TTYD_CMD": "claude --dangerously-skip-permissions",
          "ROUTE_TOKEN": "rt-1"
        },
        "workspace_volume": true,
        "mounts": [
          {
            "type": "cache",
            "name": "pip",
            "target": "/home/agent/.cache/pip"
          },
          {
            "type": "bind",
            "source": "/opt/toolchains",
            "target": "/opt/toolchains",
            "writable": false
          }
        ],
        "network": "bridge",
        "pid": "private",
        "resources": {
          "cpus": 2,
          "memory_bytes": 8589934592,
          "pids_limit": 4096
        },
        "privilege_escalation": false
      }
    },
    {
      "given": "op_enqueued",
      "machine": "m",
      "session": "s2",
      "as": "other_session",
      "op": "container.start",
      "payload": {
        "image": "ghcr.io/aixlehq/flow-claude-code:latest"
      }
    },
    {
      "given": "op_enqueued",
      "machine": "m",
      "session": "s3",
      "as": "forbidden",
      "op": "container.start",
      "payload": {
        "image": "ghcr.io/aixlehq/flow-claude-code:latest",
        "mounts": [
          {
            "type": "bind",
            "source": "/var/lib",
            "target": "/mnt/lib"
          }
        ]
      }
    },
    {
      "given": "op_enqueued",
      "machine": "m",
      "session": "s4",
      "as": "leftover",
      "op": "container.start",
      "payload": {
        "image": "ghcr.io/aixlehq/flow-claude-code:latest"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}"
      },
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {
                "$var": "started.id"
              },
              "sequence": {
                "$var": "started.sequence"
              },
              "op": "container.start",
              "session_id": {
                "$var": "s.id"
              },
              "deadline_at": {
                "$var": "started.deadline_at"
              },
              "payload": {
                "image": "ghcr.io/aixlehq/flow-claude-code:latest",
                "env": {
                  "TTYD_CMD": "claude --dangerously-skip-permissions",
                  "ROUTE_TOKEN": "rt-1"
                },
                "workspace_volume": true,
                "mounts": [
                  {
                    "type": "cache",
                    "name": "pip",
                    "target": "/home/agent/.cache/pip"
                  },
                  {
                    "type": "bind",
                    "source": "/opt/toolchains",
                    "target": "/opt/toolchains",
                    "writable": false
                  }
                ],
                "network": "bridge",
                "pid": "private",
                "resources": {
                  "cpus": 2,
                  "memory_bytes": 8589934592,
                  "pids_limit": 4096
                },
                "privilege_escalation": false
              }
            },
            {
              "id": {
                "$var": "other_session.id"
              },
              "sequence": {
                "$var": "other_session.sequence"
              },
              "op": "container.start",
              "session_id": {
                "$var": "s2.id"
              },
              "deadline_at": {
                "$var": "other_session.deadline_at"
              },
              "payload": {
                "image": "ghcr.io/aixlehq/flow-claude-code:latest"
              }
            },
            {
              "id": {
                "$var": "forbidden.id"
              },
              "sequence": {
                "$var": "forbidden.sequence"
              },
              "op": "container.start",
              "session_id": {
                "$var": "s3.id"
              },
              "deadline_at": {
                "$var": "forbidden.deadline_at"
              },
              "payload": {
                "image": "ghcr.io/aixlehq/flow-claude-code:latest",
                "mounts": [
                  {
                    "type": "bind",
                    "source": "/var/lib",
                    "target": "/mnt/lib"
                  }
                ]
              }
            },
            {
              "id": {
                "$var": "leftover.id"
              },
              "sequence": {
                "$var": "leftover.sequence"
              },
              "op": "container.start",
              "session_id": {
                "$var": "s4.id"
              },
              "deadline_at": {
                "$var": "leftover.deadline_at"
              },
              "payload": {
                "image": "ghcr.io/aixlehq/flow-claude-code:latest"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{started.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "ok",
          "data": {
            "container_id": "4f1c0a6e9b2d4c8e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e",
            "name": "aixle-aixle-r7-1f2e3d4c-123"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "$var": "started.id"
          },
          "state": "completed"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{other_session.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "error",
          "error": {
            "class": "session_mismatch",
            "message": "environment aixle-r7-1f2e3d4c has the session container aixle-aixle-r7-1f2e3d4c-123 of session 123, not the op's session 124; nothing was started"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "$var": "other_session.id"
          },
          "state": "failed"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{forbidden.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "error",
          "error": {
            "class": "forbidden_mount",
            "message": "the bind source /var/lib would expose the runner's state directory /var/lib/aixle-runner, which holds its credentials"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "$var": "forbidden.id"
          },
          "state": "failed"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{leftover.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "error",
          "error": {
            "class": "container_exists",
            "message": "environment aixle-r7-1f2e3d4c already has a container (aixle-aixle-r7-1f2e3d4c-leftover): run container.stop or env.scrub first"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "$var": "leftover.id"
          },
          "state": "failed"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after={{leftover.sequence}}&wait=0",
        "token": "{{m.access_token}}"
      },
      "response": {
        "status": 200,
        "body": {
          "ops": []
        }
      }
    }
  ]
}
