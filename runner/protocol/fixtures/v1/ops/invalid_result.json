{
  "description": "A result with an unknown or missing `status`, a field of the wrong type, or an `error` that is not exactly {class, message} of strings is 422 invalid_result and changes nothing.",
  "steps": [
    {"given": "registered_machine", "as": "m"},
    {"given": "op_enqueued", "machine": "m", "as": "op", "op": "exec", "payload": {"cmd": ["true"]}},
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "done"}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "ok", "exit_code": "0"}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "ok", "stdout": ["x"]}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "ok", "data": "x"}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "error", "error": {"class": "Timeout"}}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "error", "error": {"class": "Timeout", "message": 1}}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "error", "error": {"class": "Timeout", "message": "late", "detail": "x"}}
      },
      "response": {"status": 422, "body": {"error": "invalid_result", "message": {"$type": "string"}}}
    },
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{m.access_token}}"},
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {"$var": "op.id"},
              "sequence": {"$var": "op.sequence"},
              "op": "exec",
              "deadline_at": {"$var": "op.deadline_at"},
              "payload": {"cmd": ["true"]}
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "ok"}
      },
      "response": {"status": 200, "body": {"id": {"$var": "op.id"}, "state": "completed"}}
    }
  ]
}
