{
  "description": "A session op on an environment with no session container answers an error of the stable class no_session_container (PROTOCOL.md §6.3).",
  "steps": [
    {
      "given": "registered_machine",
      "as": "m"
    },
    {
      "given": "session_on_machine",
      "machine": "m",
      "as": "s"
    },
    {
      "given": "op_enqueued",
      "machine": "m",
      "session": "s",
      "as": "exec",
      "op": "exec",
      "payload": {
        "cmd": [
          "true"
        ]
      }
    },
    {
      "given": "op_enqueued",
      "machine": "m",
      "session": "s",
      "as": "read",
      "op": "read_file",
      "payload": {
        "path": "/tmp/terminal_output.log"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after=0&wait=0",
        "token": "{{m.access_token}}"
      },
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {
                "$var": "exec.id"
              },
              "sequence": {
                "$var": "exec.sequence"
              },
              "op": "exec",
              "session_id": {
                "$var": "s.id"
              },
              "deadline_at": {
                "$var": "exec.deadline_at"
              },
              "payload": {
                "cmd": [
                  "true"
                ]
              }
            },
            {
              "id": {
                "$var": "read.id"
              },
              "sequence": {
                "$var": "read.sequence"
              },
              "op": "read_file",
              "session_id": {
                "$var": "s.id"
              },
              "deadline_at": {
                "$var": "read.deadline_at"
              },
              "payload": {
                "path": "/tmp/terminal_output.log"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{exec.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "error",
          "error": {
            "class": "no_session_container",
            "message": "environment aixle-r7-1f2e3d4c has no session container: run container.start first"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "$var": "exec.id"
          },
          "state": "failed"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{read.id}}/result",
        "token": "{{m.access_token}}",
        "body": {
          "status": "error",
          "error": {
            "class": "no_session_container",
            "message": "environment aixle-r7-1f2e3d4c has no session container: run container.start first"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "$var": "read.id"
          },
          "state": "failed"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/runner/v1/ops?after={{read.sequence}}&wait=0",
        "token": "{{m.access_token}}"
      },
      "response": {
        "status": 200,
        "body": {
          "ops": []
        }
      }
    }
  ]
}
