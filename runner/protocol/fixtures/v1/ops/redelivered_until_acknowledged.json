{
  "description": "A returned op that `after` has not acknowledged, and that has no result, is returned again by the next poll.",
  "steps": [
    {"given": "registered_machine", "as": "m"},
    {"given": "op_enqueued", "machine": "m", "as": "op", "op": "exec", "payload": {"cmd": ["true"]}},
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{m.access_token}}"},
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {"$var": "op.id"},
              "sequence": {"$var": "op.sequence"},
              "op": "exec",
              "deadline_at": {"$var": "op.deadline_at"},
              "payload": {"cmd": ["true"]}
            }
          ]
        }
      }
    },
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{m.access_token}}"},
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {"$var": "op.id"},
              "sequence": {"$var": "op.sequence"},
              "op": "exec",
              "deadline_at": {"$var": "op.deadline_at"},
              "payload": {"cmd": ["true"]}
            }
          ]
        }
      }
    }
  ]
}
