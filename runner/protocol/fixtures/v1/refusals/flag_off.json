{
  "description": "With external_runners off for the company, every endpoint answers 403 runners_disabled. The credentials stay valid: once the flag is back on, the same tokens work.",
  "steps": [
    {"given": "registered_machine", "as": "m"},
    {"given": "registration_token", "as": "reg"},
    {"given": "op_enqueued", "machine": "m", "as": "op", "op": "exec", "payload": {"cmd": ["true"]}},
    {"given": "flag_off"},
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"},
          "ephemeral": false
        }
      },
      "response": {"status": 403, "body": {"error": "runners_disabled", "message": {"$type": "string"}}}
    },
    {
      "request": {"method": "POST", "path": "/runner/v1/token", "token": "{{m.refresh_token}}"},
      "response": {"status": 403, "body": {"error": "runners_disabled", "message": {"$type": "string"}}}
    },
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{m.access_token}}"},
      "response": {"status": 403, "body": {"error": "runners_disabled", "message": {"$type": "string"}}}
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/ops/{{op.id}}/result",
        "token": "{{m.access_token}}",
        "body": {"status": "ok"}
      },
      "response": {"status": 403, "body": {"error": "runners_disabled", "message": {"$type": "string"}}}
    },
    {
      "request": {"method": "DELETE", "path": "/runner/v1/registration", "token": "{{m.access_token}}"},
      "response": {"status": 403, "body": {"error": "runners_disabled", "message": {"$type": "string"}}}
    },
    {"given": "flag_on"},
    {
      "request": {"method": "GET", "path": "/runner/v1/ops?after=0&wait=0", "token": "{{m.access_token}}"},
      "response": {
        "status": 200,
        "body": {
          "ops": [
            {
              "id": {"$var": "op.id"},
              "sequence": {"$var": "op.sequence"},
              "op": "exec",
              "deadline_at": {"$var": "op.deadline_at"},
              "payload": {"cmd": ["true"]}
            }
          ]
        }
      }
    },
    {
      "request": {"method": "POST", "path": "/runner/v1/token", "token": "{{m.refresh_token}}"},
      "response": {
        "status": 200,
        "body": {
          "access_token": {"$prefix": "aracc_"},
          "access_token_expires_at": {"$type": "timestamp"},
          "refresh_token": {"$prefix": "arref_"},
          "refresh_token_expires_at": {"$type": "timestamp"}
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/runner/v1/register",
        "token": "{{reg}}",
        "body": {
          "name": "build-01",
          "os": "linux",
          "arch": "amd64",
          "facts": {"docker": "27.1.0"},
          "ephemeral": false
        }
      },
      "response": {"status": 201}
    }
  ]
}
