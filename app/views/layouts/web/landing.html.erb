/* ---------- hero particle ring (abstract / generative, monochrome) ---------- */
(function(){
  const svg=document.getElementById('particlering');if(!svg)return;
  let out='';const cx=300,cy=300;
  [120,165,205].forEach((r,ri)=>{
    const count=60+ri*22;
    for(let i=0;i<count;i++){
      const a=(i/count)*Math.PI*2+ri*0.3;
      const jitter=(Math.sin(i*12.9898)*43758.5453)%1;
      const rr=r+ (jitter-0.5)*10;
      const x=cx+rr*Math.cos(a),y=cy+rr*Math.sin(a);
      const hot=ri===0&&i%9===0;
      out+=`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${hot?1.6:1}" fill="${hot?'#E0582E':'#5D5B5A'}" opacity="${hot?0.9:(0.25+0.4*Math.abs(jitter))}"/>`;
    }
  });
  svg.innerHTML=out;
})();

/* ---------- reveal on scroll ---------- */
const RV_SEL='.reveal, .section-head>*, .witis>div:first-child>*, .handoffs-head>*, .selfhost-grid>div:first-child>*, .contact-cta>*, .flist-item, .feat-row .feat, .hiw-card, .gap2-card, .footer-col, .stat, .hero-inner>*';
const rvEls=[...document.querySelectorAll(RV_SEL)];
// stagger elements that share a parent so groups cascade
const rvGroups=new Map();
rvEls.forEach(el=>{const p=el.parentNode;(rvGroups.get(p)||rvGroups.set(p,[]).get(p)).push(el);});
rvGroups.forEach(list=>list.forEach((el,i)=>{el.style.transitionDelay=Math.min(i*0.11,0.66)+'s';}));
const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:0.12,rootMargin:'0px 0px -7% 0px'});
rvEls.forEach(el=>io.observe(el));

/* ---------- respect reduced motion for the handoff token (SMIL) ---------- */
if(matchMedia('(prefers-reduced-motion: reduce)').matches){
  document.querySelectorAll('.flowcard animateMotion,.flowcard animate').forEach(el=>el.remove());
}
