<script>
function openContactModal(){document.getElementById('contactOverlay').classList.add('open')}
function closeContactModal(){document.getElementById('contactOverlay').classList.remove('open');document.getElementById('contactMsg').textContent='';document.getElementById('contactMsg').className='form-msg'}
document.getElementById('contactOverlay').addEventListener('click',function(e){if(e.target===this)closeContactModal()});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeContactModal()});
async function submitContact(e){
  e.preventDefault();
  var btn=document.getElementById('contactSubmitBtn'),msg=document.getElementById('contactMsg');
  btn.disabled=true;btn.textContent='Sending…';msg.textContent='';msg.className='form-msg';
  try{
    var res=await fetch('/api/v1/contact_requests',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contact_request:{first_name:document.getElementById('cf-first').value,last_name:document.getElementById('cf-last').value,email:document.getElementById('cf-email').value}})});
    if(res.ok){msg.textContent='Thank you! We\'ll be in touch soon.';msg.className='form-msg success';document.getElementById('contactForm').reset()}
    else{var d=await res.json();msg.textContent=d.error||'Something went wrong. Please try again.';msg.className='form-msg error'}
  }catch(err){msg.textContent='Network error. Please try again.';msg.className='form-msg error'}
  btn.disabled=false;btn.textContent='Send Request';
}
</script>

<script>
// T4-03: Particles
(function(){
  const c=document.getElementById('particles-canvas'),x=c.getContext('2d');
  let ps=[],mouse={x:-1e3,y:-1e3};
  const N=80,CD=120,MD=150;
  function resize(){c.width=innerWidth;c.height=innerHeight}
  resize();addEventListener('resize',resize);
  addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY});
  for(let i=0;i<N;i++)ps.push({x:Math.random()*c.width,y:Math.random()*c.height,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,r:Math.random()*1.5+.5});
  function draw(){
    x.clearRect(0,0,c.width,c.height);
    ps.forEach(p=>{
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0||p.x>c.width)p.vx*=-1;
      if(p.y<0||p.y>c.height)p.vy*=-1;
      let dx=mouse.x-p.x,dy=mouse.y-p.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<MD){let f=(MD-d)/MD;p.vx-=(dx/d)*f*.02;p.vy-=(dy/d)*f*.02}
      p.vx*=.999;p.vy*=.999;
    });
    for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){
      let dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<CD){x.strokeStyle=`rgba(59,130,246,${(1-d/CD)*.15})`;x.lineWidth=.5;x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.stroke()}
    }
    ps.forEach(p=>{
      let d=Math.sqrt((mouse.x-p.x)**2+(mouse.y-p.y)**2);
      x.fillStyle=`rgba(59,130,246,${d<MD?.6:.2})`;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fill();
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

// T1-03: Scroll reveal (multiple directions) — also triggers for already-in-view elements
const revealEls=document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.reveal-scale');
const ro=new IntersectionObserver(e=>{e.forEach(en=>{if(en.isIntersecting){en.target.classList.add('visible');ro.unobserve(en.target)}})},{threshold:.08,rootMargin:'0px 0px -30px 0px'});
revealEls.forEach(el=>ro.observe(el));
requestAnimationFrame(()=>{revealEls.forEach(el=>{const r=el.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0)el.classList.add('visible')})});

// T3-08: Scroll progress bar
addEventListener('scroll',()=>{
  const s=scrollY,h=document.documentElement.scrollHeight-innerHeight;
  document.getElementById('scrollProgress').style.transform=`scaleX(${s/h})`;
  document.getElementById('nav').classList.toggle('scrolled',s>50);
});


// T2-07: Typewriter
function typeWriter(el,text,speed=25){return new Promise(r=>{let i=0;const iv=setInterval(()=>{el.textContent=text.slice(0,++i);if(i>=text.length){clearInterval(iv);r()}},speed)})}
function animateTerminal(){
  const lines=document.querySelectorAll('#hero-terminal .terminal-line');
  lines.forEach(l=>{
    const d=parseInt(l.dataset.delay)||0;
    setTimeout(()=>{l.classList.add('visible');const tw=l.querySelector('[data-typewriter]');if(tw)typeWriter(tw,tw.dataset.typewriter)},d);
  });
}
const ho=new IntersectionObserver(e=>{e.forEach(en=>{if(en.isIntersecting){animateTerminal();ho.disconnect()}})},{threshold:.3});
const ht=document.querySelector('.hero-terminal');if(ht)ho.observe(ht);

// Feature tabs with smooth transition
function switchFeature(f){
  document.querySelectorAll('.feature-nav-item').forEach(e=>e.classList.toggle('active',e.dataset.feature===f));
  const cards=document.querySelectorAll('.feature-card');
  cards.forEach(e=>{
    if(e.id===`feature-${f}`){
      e.style.display='block';
      e.style.animation='none';
      e.offsetHeight;
      e.style.animation='';
      e.classList.add('active');
    } else {
      e.classList.remove('active');
      setTimeout(()=>{if(!e.classList.contains('active'))e.style.display='none'},300);
    }
  });
}

// T2-03: Counters
function animateCounter(el){
  const t=parseFloat(el.dataset.target),dec=parseInt(el.dataset.decimals)||0,dur=2000,start=performance.now();
  function up(now){const p=Math.min((now-start)/dur,1),e=1-Math.pow(1-p,3);el.textContent=dec>0?(t*e).toFixed(dec):Math.round(t*e);if(p<1)requestAnimationFrame(up)}
  requestAnimationFrame(up);
}
const co=new IntersectionObserver(e=>{e.forEach(en=>{if(en.isIntersecting){en.target.querySelectorAll('.counter').forEach(animateCounter);co.unobserve(en.target)}})},{threshold:.5});
document.querySelectorAll('.pipeline-stats').forEach(el=>co.observe(el));

// T3-02: Heatmap
(function(){
  const g=document.getElementById('heatmap');if(!g)return;
  for(let i=0;i<52*7;i++){
    const c=document.createElement('div');c.className='heatmap-cell';
    const r=Math.random();if(r>.7)c.classList.add('l1');if(r>.82)c.classList.add('l2');if(r>.91)c.classList.add('l3');if(r>.96)c.classList.add('l4');
    c.style.animationDelay=`${(i%52)*15}ms`;g.appendChild(c);
  }
})();

// T-NEW: Button ripple effect
document.querySelectorAll('.btn-primary').forEach(btn=>{
  btn.addEventListener('click',function(e){
    const r=document.createElement('span');r.className='ripple';
    const rect=this.getBoundingClientRect();
    r.style.left=(e.clientX-rect.left)+'px';r.style.top=(e.clientY-rect.top)+'px';
    r.style.width=r.style.height=Math.max(rect.width,rect.height)+'px';
    this.appendChild(r);setTimeout(()=>r.remove(),600);
  });
});

// T3-13: Confetti on CTA click
(function(){
  const cv=document.getElementById('confetti-canvas'),cx=cv.getContext('2d');
  function resize(){cv.width=innerWidth;cv.height=innerHeight}
  resize();addEventListener('resize',resize);
  let particles=[];
  const colors=['#3B82F6','#A855F7','#06B6D4','#22C55E','#F59E0B','#EF4444'];
  function burst(x,y){
    for(let i=0;i<60;i++){
      const a=Math.random()*Math.PI*2,v=Math.random()*8+3;
      particles.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v-3,life:1,color:colors[Math.floor(Math.random()*colors.length)],size:Math.random()*6+2,rot:Math.random()*360,rv:(Math.random()-.5)*10});
    }
  }
  function draw(){
    cx.clearRect(0,0,cv.width,cv.height);
    particles=particles.filter(p=>p.life>0);
    particles.forEach(p=>{
      p.x+=p.vx;p.y+=p.vy;p.vy+=.15;p.life-=.012;p.rot+=p.rv;p.vx*=.99;
      cx.save();cx.translate(p.x,p.y);cx.rotate(p.rot*Math.PI/180);
      cx.fillStyle=p.color;cx.globalAlpha=p.life;
      cx.fillRect(-p.size/2,-p.size/2,p.size,p.size*2);
      cx.restore();
    });
    if(particles.length)requestAnimationFrame(draw);
  }
  document.querySelectorAll('#ctaBtn,#ctaBtn2').forEach(b=>{
    b.addEventListener('click',e=>{e.preventDefault();burst(e.clientX,e.clientY);draw()});
  });
})();

// Parallax 3D tilt on hero logo
(function(){
  const logo=document.querySelector('.hero-logo-wrapper');
  if(!logo)return;
  const hero=document.querySelector('.hero');
  hero.addEventListener('mousemove',e=>{
    const rect=hero.getBoundingClientRect();
    const cx=(e.clientX-rect.left)/rect.width-.5;
    const cy=(e.clientY-rect.top)/rect.height-.5;
    logo.style.transform=`perspective(1000px) rotateY(${cx*10}deg) rotateX(${-cy*6}deg)`;
  });
  hero.addEventListener('mouseleave',()=>{
    logo.style.transition='transform .6s var(--ease-out)';
    logo.style.transform='perspective(1000px) rotateY(0) rotateX(0)';
    setTimeout(()=>{logo.style.transition='transform .15s ease'},600);
  });
})();

// Animated heatmap conic border angle
(function(){
  const hw=document.querySelector('.heatmap-wrapper');
  if(!hw)return;
  let angle=0;
  function tick(){angle=(angle+1)%360;hw.style.setProperty('--hm-angle',angle+'deg');requestAnimationFrame(tick)}
  tick();
})();

// Card parallax tilt on hover (bento cards)
document.querySelectorAll('.bento-card').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    const cx=(e.clientX-r.left)/r.width-.5;
    const cy=(e.clientY-r.top)/r.height-.5;
    card.style.transform=`translateY(-2px) perspective(600px) rotateY(${cx*6}deg) rotateX(${-cy*4}deg)`;
  });
  card.addEventListener('mouseleave',()=>{
    card.style.transition='transform .4s var(--ease-out)';
    card.style.transform='';
    setTimeout(()=>{card.style.transition='all var(--dur-norm) var(--ease-out)'},400);
  });
});

// Robot arm conveyor animation
(function(){
  const svg = document.getElementById('robotConveyor');
  if (!svg) return;

  const carriage = document.getElementById('armCarriage');
  const heldPill = document.getElementById('heldPill');
  const heldText = document.getElementById('heldPillText');
  const sparklesG = document.getElementById('sparkles');
  const clawL = document.getElementById('clawL');
  const clawR = document.getElementById('clawR');

  const stationXs = [105, 325, 545, 765, 985];
  const artifacts = ['prd.md', 'tasks.json', 'context.tar', 'pr-142.diff', 'deploy.sh'];
  const stations = svg.querySelectorAll('.conv-station');

  let currentStation = 0;
  let animating = false;
  let armX = stationXs[0];

  const GREEN = '#22C55E', BLUE = '#3B82F6', GRAY = '#3F3F46', GRAY_FILL = '#71717A';

  function setArmPos(x) {
    armX = x;
    carriage.setAttribute('transform', `translate(${x}, 0)`);
  }

  function openClaw() {
    clawL.setAttribute('d', 'M-6 218 L-6 228 L-16 242 L-12 244');
    clawR.setAttribute('d', 'M6 218 L6 228 L16 242 L12 244');
  }
  function closeClaw() {
    clawL.setAttribute('d', 'M-6 218 L-6 228 L-8 242 L-5 244');
    clawR.setAttribute('d', 'M6 218 L6 228 L8 242 L5 244');
  }

  function updateStations(activeIdx) {
    stations.forEach((st, i) => {
      const box = st.querySelector('.st-box');
      const iconEls = st.querySelectorAll('rect:not(.st-box), circle, line, polyline, polygon, path, text');
      if (!box) return;
      if (i < activeIdx) {
        box.setAttribute('stroke', GREEN);
        box.setAttribute('fill', 'rgba(34,197,94,.06)');
        st.setAttribute('opacity', '1');
        iconEls.forEach(el => { if(el.getAttribute('stroke') && el.getAttribute('stroke') !== 'none') el.setAttribute('stroke', GREEN); if(el.getAttribute('fill') && el.getAttribute('fill') !== 'none' && el.tagName !== 'text') el.setAttribute('fill', GREEN); });
      } else if (i === activeIdx) {
        box.setAttribute('stroke', BLUE);
        box.setAttribute('fill', 'rgba(59,130,246,.08)');
        st.setAttribute('opacity', '1');
        iconEls.forEach(el => { if(el.getAttribute('stroke') && el.getAttribute('stroke') !== 'none') el.setAttribute('stroke', BLUE); if(el.getAttribute('fill') && el.getAttribute('fill') !== 'none' && el.tagName !== 'text') el.setAttribute('fill', BLUE); });
      } else {
        box.setAttribute('stroke', GRAY);
        box.setAttribute('fill', '#18181B');
        st.setAttribute('opacity', '.35');
        iconEls.forEach(el => { if(el.getAttribute('stroke') && el.getAttribute('stroke') !== 'none') el.setAttribute('stroke', GRAY_FILL); if(el.getAttribute('fill') && el.getAttribute('fill') !== 'none' && el.tagName !== 'text') el.setAttribute('fill', GRAY_FILL); });
      }
    });
  }

  function spawnSparkles(cx) {
    for (let i = 0; i < 8; i++) {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      const angle = Math.random() * Math.PI * 2;
      const dist = 18 + Math.random() * 25;
      const dx = Math.cos(angle) * dist;
      const dy = Math.sin(angle) * dist;
      c.setAttribute('cx', cx);
      c.setAttribute('cy', '242');
      c.setAttribute('r', 1.5 + Math.random() * 2);
      c.setAttribute('fill', ['#3B82F6','#06B6D4','#A855F7','#22C55E'][Math.floor(Math.random()*4)]);
      c.setAttribute('opacity', '1');
      sparklesG.appendChild(c);
      const startTime = performance.now();
      const dur = 400 + Math.random() * 400;
      function anim(now) {
        const t = (now - startTime) / dur;
        if (t >= 1) { c.remove(); return; }
        c.setAttribute('cx', cx + dx * t);
        c.setAttribute('cy', 242 + dy * t - 12 * t);
        c.setAttribute('opacity', 1 - t);
        requestAnimationFrame(anim);
      }
      requestAnimationFrame(anim);
    }
  }

  function animateArm(fromX, toX, dur) {
    return new Promise(resolve => {
      const start = performance.now();
      function step(now) {
        const t = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        setArmPos(fromX + (toX - fromX) * eased);
        if (t < 1) requestAnimationFrame(step);
        else resolve();
      }
      requestAnimationFrame(step);
    });
  }

  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  async function pickAndPlace() {
    if (animating) return;
    animating = true;

    const fromIdx = currentStation;
    const toIdx = (currentStation + 1) % stationXs.length;
    const fromX = stationXs[fromIdx];
    const toX = stationXs[toIdx];
    const artName = artifacts[fromIdx];

    updateStations(fromIdx);
    openClaw();
    await animateArm(armX, fromX, 800);
    await sleep(250);

    closeClaw();
    await sleep(150);
    spawnSparkles(fromX);
    heldText.textContent = artName;
    heldPill.setAttribute('opacity', '1');
    await sleep(200);

    await animateArm(fromX, toX, 1200);
    await sleep(200);

    openClaw();
    spawnSparkles(toX);
    heldPill.setAttribute('opacity', '0');
    updateStations(toIdx);
    await sleep(600);

    currentStation = toIdx;
    animating = false;
  }

  setArmPos(stationXs[0]);
  openClaw();
  updateStations(0);

  const rObs = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (en.isIntersecting) {
        rObs.disconnect();
        async function loop() {
          while (true) {
            await pickAndPlace();
            await sleep(500);
          }
        }
        loop();
      }
    });
  }, { threshold: 0.3 });
  rObs.observe(svg);
})();

// Smooth scroll
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{const t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'})}});
});
</script>
<style>@keyframes spin{to{transform:rotate(360deg)}}</style>
</body>
</html>
