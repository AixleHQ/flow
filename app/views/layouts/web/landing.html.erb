<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Palad — Agentic SDLC Platform</title>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<link rel="icon" sizes="32x32" href="/favicon.ico">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg-base: #09090B;
  --bg-surface: #18181B;
  --bg-elevated: #27272A;
  --border-default: #3F3F46;
  --border-hover: #52525B;
  --text-primary: #FAFAFA;
  --text-secondary: #A1A1AA;
  --text-muted: #71717A;
  --accent-blue: #3B82F6;
  --accent-blue-dim: rgba(59, 130, 246, 0.15);
  --accent-green: #22C55E;
  --accent-green-dim: rgba(34, 197, 94, 0.15);
  --accent-amber: #F59E0B;
  --accent-amber-dim: rgba(245, 158, 11, 0.15);
  --accent-red: #EF4444;
  --accent-purple: #A855F7;
  --accent-purple-dim: rgba(168, 85, 247, 0.15);
  --accent-cyan: #06B6D4;
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
  --radius-sm: 6px; --radius-md: 8px; --radius-lg: 12px; --radius-xl: 16px; --radius-full: 9999px;
  --dur-fast: 150ms; --dur-norm: 250ms; --dur-slow: 400ms;
  --ease-out: cubic-bezier(0.16,1,0.3,1);
  --ease-spring: cubic-bezier(0.34,1.56,0.64,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:var(--font-sans);background:var(--bg-base);color:var(--text-primary);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:var(--accent-blue);text-decoration:none;transition:color var(--dur-fast) ease}
a:hover{color:#60A5FA}

/* T3-08: Scroll progress bar */
.scroll-progress{position:fixed;top:0;left:0;height:2px;background:linear-gradient(90deg,var(--accent-blue),var(--accent-purple),var(--accent-cyan));z-index:200;transform-origin:left;transform:scaleX(0);transition:none;width:100%}

/* Gradient BG */
.gradient-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.4;background:radial-gradient(ellipse 80% 50% at 20% 40%,rgba(59,130,246,.08),transparent),radial-gradient(ellipse 60% 40% at 80% 20%,rgba(168,85,247,.06),transparent),radial-gradient(ellipse 50% 60% at 60% 80%,rgba(6,182,212,.05),transparent);animation:gradShift 20s ease-in-out infinite alternate}
@keyframes gradShift{0%{filter:hue-rotate(0);opacity:.3}50%{filter:hue-rotate(15deg);opacity:.5}100%{filter:hue-rotate(-10deg);opacity:.35}}

/* Particles canvas */
#particles-canvas{position:fixed;inset:0;z-index:0;pointer-events:none}

/* Reveal */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .7s var(--ease-out),transform .7s var(--ease-out)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .7s var(--ease-out),transform .7s var(--ease-out)}
.reveal-left.visible{opacity:1;transform:translateX(0)}
.reveal-right{opacity:0;transform:translateX(40px);transition:opacity .7s var(--ease-out),transform .7s var(--ease-out)}
.reveal-right.visible{opacity:1;transform:translateX(0)}
.reveal-scale{opacity:0;transform:scale(.9);transition:opacity .7s var(--ease-out),transform .7s var(--ease-out)}
.reveal-scale.visible{opacity:1;transform:scale(1)}
.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.3s}.d4{transition-delay:.4s}.d5{transition-delay:.5s}.d6{transition-delay:.6s}

/* Container */
.container{max-width:1200px;margin:0 auto;padding:0 24px;position:relative;z-index:1}
section{padding:120px 0;position:relative}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:var(--radius-full);font-family:var(--font-sans);font-size:15px;font-weight:500;border:none;cursor:pointer;transition:all var(--dur-norm) var(--ease-out);position:relative;overflow:hidden}
.btn:hover{transform:translateY(-1px) scale(1.02)}.btn:active{transform:translateY(0) scale(.97)}
.btn-primary{background:var(--accent-blue);color:#fff;box-shadow:0 0 20px rgba(59,130,246,.3),inset 0 1px 0 rgba(255,255,255,.1)}
.btn-primary:hover{box-shadow:0 0 30px rgba(59,130,246,.5);background:#4F8FF7}
/* T2-ripple */
.btn-primary .ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.3);transform:scale(0);animation:rippleAnim .6s ease-out}
@keyframes rippleAnim{to{transform:scale(4);opacity:0}}
.btn-secondary{background:transparent;color:var(--text-primary);border:1px solid var(--border-default)}
.btn-secondary:hover{border-color:var(--border-hover);background:var(--bg-elevated)}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 0;background:rgba(9,9,11,.6);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid rgba(63,63,70,.3);transition:all var(--dur-norm) ease}
nav.scrolled{padding:10px 0;background:rgba(9,9,11,.92)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:0 24px}
.nav-logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px;color:var(--text-primary);letter-spacing:-.5px}
.nav-logo svg{height:48px;width:auto;fill:currentColor}
.nav-links{display:flex;align-items:center;gap:32px;list-style:none}
.nav-links a{color:var(--text-secondary);font-size:14px;font-weight:500;letter-spacing:.5px;text-transform:uppercase;transition:color var(--dur-fast) ease;position:relative}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent-blue);transition:width .3s var(--ease-out)}
.nav-links a:hover{color:var(--text-primary)}
.nav-links a:hover::after{width:100%}
.nav-actions{display:flex;gap:12px;align-items:center}

/* ============================================
   HERO with large SVG LOGO
   ============================================ */
.hero{display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:120px 0 60px;position:relative;overflow:hidden}

/* T-NEW: SVG Logo with animated gradient glow */
.hero-logo-wrapper{position:relative;margin-bottom:48px;width:min(500px,75vw)}
.hero-logo-svg{width:100%;height:auto;opacity:0;animation:logoReveal 2s var(--ease-out) .3s forwards;filter:drop-shadow(0 0 30px rgba(59,130,246,.4)) drop-shadow(0 0 60px rgba(168,85,247,.2)) drop-shadow(0 0 100px rgba(6,182,212,.1))}
@keyframes logoReveal{0%{opacity:0;transform:scale(.85);filter:drop-shadow(0 0 60px rgba(59,130,246,.8)) blur(8px)}60%{opacity:1;transform:scale(1.02);filter:drop-shadow(0 0 40px rgba(59,130,246,.5)) blur(0)}100%{opacity:1;transform:scale(1);filter:drop-shadow(0 0 30px rgba(59,130,246,.4)) drop-shadow(0 0 60px rgba(168,85,247,.2)) drop-shadow(0 0 100px rgba(6,182,212,.1))}}
@keyframes heroFadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

/* Glow orbs behind logo */
.hero-orb{position:absolute;border-radius:50%;filter:blur(80px);animation:orbFloat 8s ease-in-out infinite alternate;pointer-events:none}
.hero-orb-1{width:300px;height:300px;background:rgba(59,130,246,.2);top:-50px;left:10%;animation-delay:0s}
.hero-orb-2{width:250px;height:250px;background:rgba(168,85,247,.15);bottom:-30px;right:15%;animation-delay:2s}
.hero-orb-3{width:200px;height:200px;background:rgba(6,182,212,.12);top:20%;right:5%;animation-delay:4s}
@keyframes orbFloat{0%{transform:translate(0,0) scale(1)}50%{transform:translate(20px,-20px) scale(1.1)}100%{transform:translate(-10px,15px) scale(.95)}}

.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;background:var(--accent-blue-dim);border:1px solid rgba(59,130,246,.25);border-radius:var(--radius-full);font-size:13px;font-weight:500;color:var(--accent-blue);margin-bottom:24px}
.pulse-dot{width:8px;height:8px;border-radius:50%;background:var(--accent-blue);position:relative}
.pulse-dot::after{content:'';position:absolute;inset:-3px;border-radius:50%;border:2px solid var(--accent-blue);animation:pulseRing 2s ease-out infinite}
@keyframes pulseRing{0%{transform:scale(.8);opacity:1}100%{transform:scale(2);opacity:0}}
.pulse-dot-green{background:var(--accent-green)}.pulse-dot-green::after{border-color:var(--accent-green)}
.pulse-dot-amber{background:var(--accent-amber)}.pulse-dot-amber::after{border-color:var(--accent-amber)}

.hero h1{font-size:clamp(36px,4.5vw,60px);font-weight:800;line-height:1.1;letter-spacing:-2px;margin-bottom:20px}
/* T-NEW: Gradient text reveal */
.gradient-text{background:linear-gradient(135deg,#fff 0%,var(--accent-blue) 40%,var(--accent-purple) 70%,var(--accent-cyan) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;background-size:200% 200%;animation:gradientTextShift 6s ease infinite}
@keyframes gradientTextShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.hero p{font-size:18px;color:var(--text-secondary);max-width:560px;margin:0 auto 32px;line-height:1.7}
.hero-actions{display:flex;gap:12px;justify-content:center;margin-bottom:48px}

/* T2-07: Typewriter terminal in hero */
.hero-terminal{max-width:640px;width:100%;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(59,130,246,.05);text-align:left}
.terminal-header{display:flex;align-items:center;gap:8px;padding:14px 18px;background:rgba(255,255,255,.02);border-bottom:1px solid var(--border-default)}
.terminal-dot{width:12px;height:12px;border-radius:50%}
.terminal-dot.red{background:#FF5F57}.terminal-dot.yellow{background:#FFBD2E}.terminal-dot.green{background:#28CA41}
.terminal-title{flex:1;text-align:center;font-size:12px;color:var(--text-muted);font-family:var(--font-mono)}
.terminal-body{padding:20px;font-family:var(--font-mono);font-size:13px;line-height:1.9;min-height:260px}
.terminal-line{display:flex;gap:8px;opacity:0;transform:translateY(8px);transition:all .4s var(--ease-out)}
.terminal-line.visible{opacity:1;transform:translateY(0)}
.terminal-prompt{color:var(--accent-green);white-space:nowrap}
.terminal-command{color:var(--text-primary)}
.terminal-output{color:var(--text-muted);padding-left:18px}
.terminal-status{padding-left:18px}
.terminal-success{color:var(--accent-green)}
.terminal-info{color:var(--accent-blue)}
.cursor-blink{display:inline-block;width:8px;height:16px;background:var(--accent-green);margin-left:2px;vertical-align:middle;animation:blink 1s step-end infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

/* SDLC Diagram nodes */
.sdlc-node-full{cursor:pointer;transition:opacity var(--dur-fast) ease}
.sdlc-node-full circle:first-child{transition:stroke-width var(--dur-fast) ease,filter var(--dur-fast) ease}
.sdlc-node-full:hover circle:first-child{stroke-width:3.5}

/* T1-12: Carousel */
.carousel-section{padding:40px 0;border-top:1px solid rgba(63,63,70,.3);border-bottom:1px solid rgba(63,63,70,.3);overflow:hidden;position:relative;z-index:1}
.carousel-label{text-align:center;font-size:13px;text-transform:uppercase;letter-spacing:2px;color:var(--text-muted);margin-bottom:24px}
.carousel-track{display:flex;gap:64px;animation:slide 25s linear infinite;width:max-content}
@keyframes slide{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.carousel-item{display:flex;align-items:center;gap:12px;white-space:nowrap;opacity:.5;transition:opacity var(--dur-norm) ease;font-size:16px;font-weight:500;color:var(--text-secondary)}
.carousel-item:hover{opacity:1}
.carousel-icon{width:36px;height:36px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.ci-claude{background:rgba(204,120,50,.15);color:#CC7832}.ci-cursor{background:rgba(59,130,246,.15);color:#3B82F6}
.ci-codex{background:rgba(34,197,94,.15);color:#22C55E}.ci-gemini{background:rgba(168,85,247,.15);color:#A855F7}
.ci-temporal{background:rgba(6,182,212,.15);color:#06B6D4}.ci-docker{background:rgba(59,130,246,.15);color:#2496ED}
.ci-k8s{background:rgba(50,108,229,.15);color:#326CE5}.ci-github{background:rgba(255,255,255,.1);color:#fff}

/* Section eyebrow / titles */
.section-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;text-transform:uppercase;letter-spacing:2px;color:var(--accent-blue);font-weight:600;margin-bottom:16px}
.section-title{font-size:clamp(32px,4vw,48px);font-weight:700;letter-spacing:-1.5px;line-height:1.15;margin-bottom:16px}
.section-subtitle{font-size:18px;color:var(--text-secondary);max-width:600px;line-height:1.7}

/* T3-04: Sticky features */
.features{padding:120px 0}
.features-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;margin-top:80px;align-items:start}
.features-nav{position:sticky;top:120px}
.feature-nav-item{display:flex;gap:16px;align-items:flex-start;padding:20px 24px;border-left:2px solid var(--border-default);cursor:pointer;transition:all var(--dur-norm) ease;margin-bottom:4px;position:relative}
.feature-nav-item:hover{background:rgba(255,255,255,.03)}
.feature-nav-item.active{border-left-color:transparent;background:var(--accent-blue-dim)}
.feature-nav-item.active::after{content:'';position:absolute;left:-2px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--accent-blue),var(--accent-purple));border-radius:1px}
.feature-num{font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--text-muted);opacity:.25;transition:all var(--dur-norm) ease;min-width:22px;padding-top:3px}
.feature-nav-item:hover .feature-num{opacity:.5}
.feature-nav-item.active .feature-num{color:var(--accent-blue);opacity:1}
.feature-nav-item h3{font-size:16px;font-weight:600;margin-bottom:4px;transition:color var(--dur-fast) ease}
.feature-nav-item.active h3{color:var(--accent-blue)}
.feature-nav-item p{font-size:14px;color:var(--text-muted);line-height:1.5}

/* Enterprise section (factory.ai style) */
.enterprise-section{padding:120px 0}
.enterprise-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:60px}
.enterprise-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:40px;position:relative;overflow:hidden;transition:all var(--dur-norm) ease}
.enterprise-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--accent-blue),var(--accent-purple),var(--accent-cyan));opacity:0;transition:opacity .3s ease}
.enterprise-card:hover{border-color:var(--border-hover);transform:translateY(-2px);box-shadow:0 12px 40px rgba(0,0,0,.3)}
.enterprise-card:hover::before{opacity:1}
.enterprise-card-label{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:var(--text-muted);margin-bottom:16px;font-weight:600}
.enterprise-card h3{font-size:24px;font-weight:700;margin-bottom:12px;letter-spacing:-.5px}
.enterprise-card p{font-size:15px;color:var(--text-muted);line-height:1.7;margin-bottom:20px}
.enterprise-link{font-size:13px;color:var(--accent-blue);font-weight:500;display:inline-flex;align-items:center;gap:6px;transition:gap .2s ease}
.enterprise-link:hover{gap:10px;color:#60A5FA}
.feature-display{position:sticky;top:120px}
.feature-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:32px;display:none;animation:cardIn .6s var(--ease-out) forwards;position:relative;overflow:hidden}
.feature-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--accent-blue),var(--accent-purple),var(--accent-cyan));transform:scaleX(0);transition:transform .4s var(--ease-out);transform-origin:left}
.feature-card.active{display:block}
.feature-card.active::before{transform:scaleX(1)}
@keyframes cardIn{from{opacity:0;transform:translateY(16px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.feature-card-terminal{background:var(--bg-base);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:16px 20px;font-family:var(--font-mono);font-size:13px;line-height:1.8;margin-top:20px}

/* T3-01: Pipeline */
.pipeline-section{padding:120px 0}
.pipeline{display:flex;align-items:center;justify-content:center;padding:40px 0}
.pipeline-node{display:flex;flex-direction:column;align-items:center;gap:12px;position:relative;z-index:2}
.pipeline-node-icon{width:64px;height:64px;border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center;font-size:24px;border:2px solid var(--border-default);background:var(--bg-surface);transition:all .5s var(--ease-out);position:relative}
.pipeline-node.completed .pipeline-node-icon{border-color:var(--accent-green);background:var(--accent-green-dim);box-shadow:0 0 20px rgba(34,197,94,.2)}
.pipeline-node.active .pipeline-node-icon{border-color:var(--accent-blue);background:var(--accent-blue-dim);box-shadow:0 0 20px rgba(59,130,246,.3);animation:nodeActive 2s ease-in-out infinite}
@keyframes nodeActive{0%,100%{box-shadow:0 0 20px rgba(59,130,246,.2)}50%{box-shadow:0 0 35px rgba(59,130,246,.5)}}
.pipeline-node.pending .pipeline-node-icon{opacity:.4}
.pipeline-node-label{font-size:13px;font-weight:500;color:var(--text-secondary);text-align:center}
.pipeline-node.completed .pipeline-node-label{color:var(--accent-green)}
.pipeline-node.active .pipeline-node-label{color:var(--accent-blue)}
.pipeline-connector{width:100px;height:2px;position:relative;z-index:1}
.pipeline-connector-line{position:absolute;top:0;left:0;right:0;height:2px;background:var(--border-default)}
.pipeline-connector.completed .pipeline-connector-line{background:var(--accent-green)}
.pipeline-connector.active .pipeline-connector-line{background:linear-gradient(90deg,var(--accent-green),var(--accent-blue))}
.pipeline-connector.active .pipeline-connector-line::after{content:'';position:absolute;top:-3px;width:8px;height:8px;border-radius:50%;background:var(--accent-blue);box-shadow:0 0 12px var(--accent-blue);animation:pulseTravelRight 2s ease-in-out infinite}
@keyframes pulseTravelRight{0%{left:0;opacity:0}10%{opacity:1}90%{opacity:1}100%{left:100%;opacity:0}}
.pipeline-stats{display:flex;justify-content:center;gap:48px;margin-top:48px}
.pipeline-stat{text-align:center}
.pipeline-stat-value{font-size:36px;font-weight:700;font-family:var(--font-mono);letter-spacing:-1px}
.pipeline-stat-label{font-size:13px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-top:4px}

/* T1-02 + T3-15: Cards with hover lift + parallax tilt */
.cards-section{padding:120px 0}
/* Bento grid layout */
.bento-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:60px}
.bento-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:28px;transition:all var(--dur-norm) var(--ease-out);position:relative;overflow:hidden}
.bento-card::after{content:'';position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.03),transparent);transition:left .6s ease}
.bento-card:hover::after{left:150%}
.bento-card:hover{border-color:var(--border-hover);box-shadow:0 8px 30px rgba(0,0,0,.3);transform:translateY(-2px)}
.bento-wide{grid-column:span 2;padding:36px}
.bento-card h3{font-size:18px;font-weight:600;margin-bottom:8px}
.bento-card p{font-size:14px;color:var(--text-muted);line-height:1.6}
.bento-card-visual{margin-bottom:20px;padding:16px 0}
.bento-card-accent{width:32px;height:3px;border-radius:2px;margin-bottom:20px;opacity:.7}

/* T3-02: Heatmap */
.heatmap-section{padding:120px 0}
.heatmap-wrapper{margin-top:60px;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:40px}
.heatmap-grid{display:grid;grid-template-columns:repeat(52,1fr);gap:3px;margin-top:24px}
.heatmap-cell{aspect-ratio:1;border-radius:2px;background:var(--bg-elevated);transition:all var(--dur-fast) ease;cursor:pointer;opacity:0;animation:heatFade .3s ease forwards}
.heatmap-cell:hover{outline:1px solid var(--text-muted);transform:scale(1.5);z-index:1;position:relative}
.heatmap-cell.l1{background:rgba(59,130,246,.15)}.heatmap-cell.l2{background:rgba(59,130,246,.3)}
.heatmap-cell.l3{background:rgba(59,130,246,.5)}.heatmap-cell.l4{background:var(--accent-blue)}
@keyframes heatFade{to{opacity:1}}
.heatmap-legend{display:flex;align-items:center;gap:4px;justify-content:flex-end;margin-top:12px;font-size:12px;color:var(--text-muted)}
.heatmap-legend-cell{width:12px;height:12px;border-radius:2px}


/* T-NEW: Text scramble animation */
.scramble-text{position:relative;display:inline-block}

/* Testimonial */
.testimonials-section{padding:120px 0}
.testimonial-card{max-width:700px;margin:60px auto 0;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:48px;text-align:center;position:relative}
.testimonial-card::before{content:'"';position:absolute;top:20px;left:40px;font-size:80px;font-weight:800;color:var(--accent-blue-dim);line-height:1}
.testimonial-text{font-size:20px;line-height:1.7;color:var(--text-primary);margin-bottom:28px;position:relative}
.testimonial-author{display:flex;align-items:center;gap:12px;justify-content:center}
.testimonial-avatar{width:44px;height:44px;border-radius:50%;background:var(--accent-purple-dim);display:flex;align-items:center;justify-content:center;font-weight:600;color:var(--accent-purple);font-size:16px}
.testimonial-meta{text-align:left}
.testimonial-name{font-weight:600;font-size:15px}
.testimonial-role{font-size:13px;color:var(--text-muted)}

/* CTA */
.cta-section{padding:120px 0 160px;text-align:center;position:relative}
.cta-section::before{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:80%;height:400px;background:radial-gradient(ellipse,rgba(59,130,246,.08),transparent);pointer-events:none}
.cta-section h2{font-size:clamp(36px,4vw,56px);font-weight:800;letter-spacing:-2px;margin-bottom:16px}
.cta-section p{font-size:18px;color:var(--text-secondary);max-width:500px;margin:0 auto 36px}
.cta-actions{display:flex;gap:12px;justify-content:center}

/* T3-13: Confetti canvas */
#confetti-canvas{position:fixed;inset:0;z-index:300;pointer-events:none}

/* Footer */
footer{border-top:1px solid rgba(63,63,70,.3);padding:60px 0 40px;position:relative;z-index:1}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px}
.footer-brand{display:flex;flex-direction:column;gap:12px}
.footer-brand p{font-size:14px;color:var(--text-muted);max-width:300px;line-height:1.6}
.footer-col h4{font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--text-muted);margin-bottom:16px}
.footer-col ul{list-style:none}.footer-col li{margin-bottom:10px}
.footer-col a{color:var(--text-secondary);font-size:14px;transition:color var(--dur-fast) ease}
.footer-col a:hover{color:var(--text-primary)}
.footer-bottom{margin-top:48px;padding-top:24px;border-top:1px solid rgba(63,63,70,.2);display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--text-muted)}

/* T-NEW: Glitch text effect on hover (for CTA) */
.glitch-hover:hover{animation:glitch .3s ease}
@keyframes glitch{0%{text-shadow:2px 0 var(--accent-blue),-2px 0 var(--accent-purple)}25%{text-shadow:-2px 0 var(--accent-blue),2px 0 var(--accent-purple)}50%{text-shadow:0 2px var(--accent-blue),0 -2px var(--accent-purple)}75%{text-shadow:1px -1px var(--accent-blue),-1px 1px var(--accent-purple)}100%{text-shadow:0 0 transparent}}

/* T-NEW: Noise texture overlay */
.noise-overlay{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.03;background:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}

/* Conveyor Belt Animation — Robot Arm Version */
.conveyor-section{padding:120px 0}
.conveyor-wrapper{position:relative;margin-top:60px;padding:40px 0 60px}
.conveyor-svg-container{width:100%;max-width:1100px;margin:0 auto}
.conveyor-svg-container svg{width:100%;height:auto;display:block}

/* Gradient separator */
.gradient-separator{height:1px;background:linear-gradient(90deg,transparent,var(--accent-blue),var(--accent-purple),var(--accent-cyan),transparent);opacity:.3;margin:0 auto;max-width:800px}

/* Integrations section (factory.ai style) */
.integration-item{display:flex;gap:32px;padding:36px 0;align-items:flex-start;position:relative;transition:all .3s ease}
.integration-item:hover{padding-left:8px}
.integration-number{font-family:var(--font-mono);font-size:14px;font-weight:600;color:var(--text-muted);min-width:32px;padding-top:6px;opacity:.3;transition:all .3s ease}
.integration-item:hover .integration-number{color:var(--accent-blue);opacity:.9}
.integration-body{flex:1}
.integration-title{font-size:clamp(22px,2.5vw,32px);font-weight:700;letter-spacing:-.5px;margin-bottom:12px;color:var(--text-primary);transition:color var(--dur-norm) ease}
.integration-item:hover .integration-title{color:var(--accent-blue)}
.integration-desc{font-size:15px;color:var(--text-muted);line-height:1.7;max-width:640px}
.integration-link{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:14px;font-weight:500;color:var(--accent-blue);transition:gap .2s ease,color var(--dur-fast) ease}
.integration-link:hover{gap:10px;color:#60A5FA}
.integration-divider{height:1px;background:linear-gradient(90deg,rgba(63,63,70,.5),rgba(63,63,70,.15));margin-left:64px;position:relative}
.integration-divider::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(59,130,246,.3),rgba(168,85,247,.15),transparent);opacity:0;transition:opacity .6s ease}
.integration-item:hover+.integration-divider::after,.integration-divider:hover::after{opacity:1}

/* Floating code badges */
.floating-badge{position:absolute;padding:6px 16px;background:rgba(24,24,27,.8);border:1px solid var(--border-default);border-radius:var(--radius-full);font-size:11px;font-family:var(--font-mono);color:var(--text-muted);white-space:nowrap;pointer-events:none;backdrop-filter:blur(8px);z-index:3}
.fb-1{top:12%;right:3%;animation:floatA 7s ease-in-out infinite}
.fb-2{top:40%;left:2%;animation:floatB 8s ease-in-out infinite}
.fb-3{bottom:18%;right:6%;animation:floatC 6s ease-in-out infinite}
@keyframes floatA{0%,100%{transform:translateY(0) rotate(-.5deg);opacity:.35}50%{transform:translateY(-14px) rotate(.5deg);opacity:.7}}
@keyframes floatB{0%,100%{transform:translateY(0) rotate(.5deg);opacity:.25}50%{transform:translateY(-10px) rotate(-.5deg);opacity:.55}}
@keyframes floatC{0%,100%{transform:translateY(0) rotate(-.3deg);opacity:.3}50%{transform:translateY(-12px) rotate(.3deg);opacity:.6}}

/* Terminal scan line */
.terminal-scan{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(59,130,246,.25),transparent);animation:scanDown 4s ease-in-out infinite;pointer-events:none;z-index:5}
@keyframes scanDown{0%{top:0;opacity:0}5%{opacity:1}95%{opacity:1}100%{top:100%;opacity:0}}

/* Animated border on heatmap */
.heatmap-wrapper{position:relative}
.heatmap-wrapper::before{content:'';position:absolute;inset:-1px;border-radius:var(--radius-xl);background:conic-gradient(from var(--hm-angle,0deg) at 50% 50%,transparent 0%,var(--accent-blue) 8%,transparent 16%);opacity:0;transition:opacity .5s ease;z-index:-1;padding:1px}
.heatmap-wrapper:hover::before{opacity:.5}

/* Hero logo 3D tilt container */
.hero-logo-wrapper{transition:transform .15s ease}

/* Responsive */
@media(max-width:1024px){
  .features-grid{grid-template-columns:1fr;gap:40px}.features-nav{position:static}
  .bento-grid{grid-template-columns:repeat(2,1fr)}.bento-wide{grid-column:span 1}
  .footer-grid{grid-template-columns:1fr 1fr}
  .floating-badge{display:none}
  .integration-item{gap:20px}
  .enterprise-grid{grid-template-columns:1fr;gap:20px}
  #cycleDiagram{width:400px;height:400px}
}
@media(max-width:640px){.bento-grid{grid-template-columns:1fr}.bento-wide{grid-column:span 1}.hero-actions{flex-direction:column}.nav-links{display:none}section{padding:80px 0}.heatmap-grid{grid-template-columns:repeat(26,1fr)}.conveyor-svg-container{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .integration-item{flex-direction:column;gap:8px}
  .integration-number{min-width:auto}
  .integration-divider{margin-left:0}
  .enterprise-grid{grid-template-columns:1fr}
  .enterprise-card{padding:28px}
  .feature-num{display:none}
  #cycleDiagram{width:320px;height:320px}
}
/* Contact modal */
.contact-overlay{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);backdrop-filter:blur(6px);opacity:0;pointer-events:none;transition:opacity .25s ease}
.contact-overlay.open{opacity:1;pointer-events:auto}
.contact-modal{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:40px;max-width:440px;width:90%;position:relative;transform:translateY(20px) scale(.97);transition:transform .25s ease}
.contact-overlay.open .contact-modal{transform:translateY(0) scale(1)}
.contact-modal h3{font-size:22px;font-weight:700;color:var(--text-primary);margin-bottom:6px}
.contact-modal .modal-sub{font-size:14px;color:var(--text-secondary);margin-bottom:24px}
.contact-modal .close-btn{position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted);font-size:20px;cursor:pointer;padding:4px 8px;border-radius:4px;transition:color .15s}
.contact-modal .close-btn:hover{color:var(--text-primary)}
.contact-form label{display:block;font-size:13px;color:var(--text-secondary);margin-bottom:4px;font-weight:500}
.contact-form input{display:block;width:100%;padding:10px 14px;font-size:14px;background:var(--bg-base);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:var(--text-primary);margin-bottom:16px;outline:none;transition:border-color .15s}
.contact-form input:focus{border-color:var(--accent-blue)}
.contact-form input::placeholder{color:var(--text-muted)}
.contact-form .submit-btn{width:100%;padding:12px;font-size:15px;font-weight:600;border:none;border-radius:var(--radius-sm);background:linear-gradient(135deg,var(--accent-blue),var(--accent-purple));color:#fff;cursor:pointer;transition:opacity .15s}
.contact-form .submit-btn:hover{opacity:.9}
.contact-form .submit-btn:disabled{opacity:.5;cursor:not-allowed}
.contact-form .form-msg{text-align:center;font-size:13px;margin-top:12px;min-height:20px}
.contact-form .form-msg.success{color:#22C55E}
.contact-form .form-msg.error{color:#EF4444}
</style>
</head>
