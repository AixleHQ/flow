<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aixle Flow — AI-native orchestration layer</title>
<meta name="description" content="Flow connects your agents and your team on one governed surface — routing each step to the right worker, enforcing your policy at every handoff, keeping the whole run traceable.">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/icon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&family=Figtree:ital,wght@0,300;0,400;1,300&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   AIXLE — design tokens (from Aixle-Design-System.md)
   ============================================================ */
:root{
  /* brand core */
  --aix-orange:#E0582E; --aix-black:#0A0908; --aix-white:#D1CFCD;
  /* neutral ramp */
  --ink-00:#D1CFCD; --ink-06:#9F9D9C; --ink-07:#908E8C; --ink-08:#7F7E7C;
  --ink-10:#5D5B5A; --ink-12:#393837; --ink-13:#292726; --ink-14:#191817; --ink-15:#0A0908;
  /* semantic */
  --bg:var(--ink-15); --surface:var(--ink-14); --elevated:#1C1A18; --charcoal:#121110;
  --fg:var(--ink-00); --fg-secondary:var(--ink-06); --fg-muted:var(--ink-07); --fg-subtle:var(--ink-08);
  --fg-on-light:#0A0908;
  --border:var(--ink-13); --border-strong:var(--ink-12);
  --border-light:rgba(209,207,205,.12);
  --accent:var(--aix-orange); --orange-hover:#EC6A41; --orange-press:#C44A24;
  --btn-primary-bg:#D1CFCD; --btn-primary-fg:#0A0908; --btn-primary-hover:#E3E1DF;
  --grey-btn:#B6B6B6;
  /* type */
  --font-display:"Hanken Grotesk",-apple-system,BlinkMacSystemFont,sans-serif;
  --font-sans:"Hanken Grotesk",-apple-system,BlinkMacSystemFont,sans-serif;
  --font-text:"Figtree",-apple-system,BlinkMacSystemFont,sans-serif;
  --font-mono:"Spline Sans Mono",ui-monospace,SFMono-Regular,monospace;
  --fs-display:clamp(56px,8.5vw,128px);
  --fs-h1:clamp(40px,5vw,60px);
  --fs-h2:clamp(32px,4vw,48px);
  --fs-h3:clamp(28px,3vw,40px);
  --fs-sub:clamp(20px,2.2vw,24px);
  --fs-quote:clamp(32px,5.5vw,64px);
  --fs-body-lg:18px; --fs-body:16px; --fs-small:14px; --fs-eyebrow:12px; --fs-micro:10px;
  /* spacing & layout */
  --sp-1:8px; --sp-2:16px; --sp-3:24px; --sp-4:32px; --sp-5:40px; --sp-6:56px; --sp-7:64px; --sp-8:80px; --sp-9:96px; --sp-10:128px;
  --section-y:clamp(72px,9vw,128px);
  --gutter:clamp(24px,5vw,104px);
  --content:1712px;
  /* radii */
  --r-pill:100px; --r-card:40px; --r-md:16px; --r-sm:8px;
  /* elevation */
  --shadow-md:0 12px 32px -12px rgba(0,0,0,.7);
  --shadow-lg:0 30px 80px -24px rgba(0,0,0,.85);
  /* motion */
  --ease:cubic-bezier(.4,0,.2,1); --ease-out:cubic-bezier(.16,1,.3,1); --dur:220ms;
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:hidden}
body{
  background:var(--bg); color:var(--fg);
  font-family:var(--font-text); font-weight:300; font-size:var(--fs-body);
  line-height:1.45; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
::selection{background:rgba(224,88,46,.28)}

/* ---------- shared layout ---------- */
.container{width:100%;max-width:var(--content);margin:0 auto;padding-inline:var(--gutter)}
.section{padding-block:var(--section-y)}
.section.charcoal{background:var(--charcoal)}
.section.surface{background:var(--surface)}

/* ---------- type primitives ---------- */
.kicker{
  font-family:var(--font-sans); font-size:var(--fs-eyebrow); font-weight:700;
  letter-spacing:.1em; line-height:1; text-transform:none; color:var(--fg-secondary);
  margin-bottom:var(--sp-3);
}
.kicker.hot{color:var(--accent)}
h1,h2,h3{font-family:var(--font-display);color:var(--fg)}
h1,h2{font-weight:300;letter-spacing:-.02em}
h3{font-weight:400}
h1{font-size:var(--fs-h1);line-height:1.05;letter-spacing:-.01em}
.big-head{font-size:var(--fs-h2);line-height:1.08;letter-spacing:-.01em;max-width:30ch}
h3{font-size:var(--fs-h3);line-height:1.08}
.dim{color:var(--fg-secondary)}
.lead{font-size:var(--fs-body-lg);line-height:1.55;color:var(--fg);max-width:52ch;margin-top:var(--sp-3)}
.lead-muted{font-size:var(--fs-body-lg);line-height:1.55;color:var(--fg-secondary);max-width:60ch;margin-top:var(--sp-3)}
.section-head{margin-bottom:var(--sp-9)}
.mono-foot{font-family:var(--font-mono);font-size:var(--fs-small);color:var(--fg-muted);letter-spacing:.01em}

/* ---------- buttons (pill / sharp) ---------- */
.btn{
  display:inline-flex;align-items:center;gap:9px;
  font-family:var(--font-sans);font-size:var(--fs-small);font-weight:600;letter-spacing:.01em;
  padding:14px 26px;border-radius:var(--r-pill);border:1px solid transparent;
  transition:background var(--dur) var(--ease),color var(--dur) var(--ease),
             border-color var(--dur) var(--ease),transform var(--dur) var(--ease);
  white-space:nowrap;
}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--accent);color:#0A0908;font-weight:600;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 4px 20px -6px rgba(224,88,46,.55)}
.btn-primary:hover{background:var(--orange-hover);transform:translateY(-1px);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 6px 26px -6px rgba(224,88,46,.7)}
.btn-light{background:var(--btn-primary-bg);color:var(--btn-primary-fg)}
.btn-light:hover{background:var(--btn-primary-hover)}
.btn-outline{background:transparent;color:var(--fg);border-color:var(--border-strong)}
.btn-outline:hover{border-color:var(--fg-secondary);background:rgba(209,207,205,.04)}
.btn-sm{padding:10px 18px;font-size:13px}
.btn svg{width:16px;height:16px;flex:none}
.btn-row{display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:var(--sp-5)}

/* icon helper */
.ic{display:inline-flex;align-items:center;justify-content:center}
.ic svg{stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* ============================================================
   NAV
   ============================================================ */
.nav-wrap{position:fixed;inset:0 0 auto 0;z-index:100;transition:background var(--dur) var(--ease),border-color var(--dur) var(--ease)}
.nav-wrap.scrolled{background:rgba(10,9,8,.72);backdrop-filter:blur(14px);border-bottom:1px solid var(--border)}
.nav{max-width:var(--content);margin:0 auto;padding:18px var(--gutter);display:flex;align-items:center;justify-content:space-between}
.logo{display:inline-flex;align-items:center;gap:9px;background:none;border:0;padding:0;font-size:21px}
.logo .dot{width:9px;height:9px;border-radius:50%;background:var(--accent)}
.logo-img{height:.82em;width:auto;display:block}
.logo .flow{font-family:var(--font-display);font-weight:700;font-size:1em;letter-spacing:-.01em;color:var(--fg)}
.nav-links{display:flex;align-items:center;gap:var(--sp-4)}
.nav-link{background:none;border:0;color:var(--fg-secondary);font-family:var(--font-text);font-size:var(--fs-body);font-weight:300;display:inline-flex;align-items:center;gap:6px;transition:color var(--dur) var(--ease)}
.nav-link:hover{color:var(--fg)}
.has-flyout{position:relative}
.has-flyout::after{content:"";position:absolute;left:0;right:0;top:100%;height:16px}
.nav-caret svg{width:14px;height:14px}
.flyout{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(14px);
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);
  padding:18px;min-width:210px;display:flex;flex-direction:column;gap:4px;
  opacity:0;visibility:hidden;transition:opacity var(--dur) var(--ease),transform var(--dur) var(--ease);box-shadow:var(--shadow-md)}
.has-flyout:hover .flyout{opacity:1;visibility:visible;transform:translateX(-50%) translateY(10px)}
.flyout-eyebrow{font-family:var(--font-sans);font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.1em;color:var(--fg-subtle);margin:10px 0 4px}
.flyout-eyebrow:first-child{margin-top:0}
.flyout a{font-size:var(--fs-small);color:var(--fg-secondary);padding:6px 0;transition:color var(--dur) var(--ease)}
.flyout a:hover{color:var(--fg)}
.nav-burger{display:none;background:none;border:0;color:var(--fg);padding:4px}
.nav-burger svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round}

/* mobile sheet */
.sheet{position:fixed;inset:0;z-index:200;background:var(--bg);padding:18px var(--gutter);
  display:flex;flex-direction:column;transform:translateX(100%);transition:transform var(--dur) var(--ease-out);visibility:hidden}
.sheet.open{transform:translateX(0);visibility:visible}
.sheet-top{display:flex;align-items:center;justify-content:space-between}
.icon-btn{background:none;border:0;color:var(--fg);padding:4px}
.icon-btn svg{width:26px;height:26px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round}
.sheet-links{display:flex;flex-direction:column;gap:4px;margin-top:var(--sp-8)}
.sheet-links button{background:none;border:0;text-align:left;color:var(--fg);
  font-family:var(--font-display);font-weight:400;font-size:32px;padding:14px 0;border-bottom:1px solid var(--border)}
.sheet-cta{margin-top:auto;margin-bottom:24px;justify-content:center}

/* ============================================================
   HERO
   ============================================================ */
.hero{position:relative;padding-top:clamp(140px,16vh,200px);padding-bottom:var(--section-y);overflow:hidden}
.hero-bg{position:absolute;inset:0;pointer-events:none;opacity:.5}
.hero-bg svg{position:absolute;right:-12%;top:-10%;width:min(900px,80vw);height:auto}
.hero-inner{max-width:760px;position:relative}
.hero h1{font-size:var(--fs-display);line-height:1.04;letter-spacing:-.02em;margin-bottom:var(--sp-4)}
.hero .sub{font-size:var(--fs-sub);line-height:1.4;color:var(--fg-secondary);max-width:58ch;font-weight:300}
.hero-tagline{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:var(--sp-7);
  font-family:var(--font-mono);font-size:var(--fs-small);color:var(--fg-muted)}
.hero-tagline b{color:var(--fg);font-weight:500}
.hero-tagline .sep{color:var(--ink-10)}

/* hero: content left, autoplaying walkthrough right */
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(32px,4vw,64px);align-items:center}
.hero-grid .hero-inner{max-width:none;min-width:0}
.hero-grid .hero h1,.hero-grid h1{font-size:clamp(38px,4.4vw,66px)}
.hero-grid .sub{font-size:clamp(16px,1.4vw,18px);max-width:46ch}
.hero-grid .hero-tagline{margin-top:var(--sp-5)}
.hero-demo{position:relative;min-width:0;max-width:100%;overflow:hidden}
.hero-demo .sc-cap{font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle);margin:0 0 10px}
/* render the window at a native landscape size, then scale it down to fit the column */
.hero-demo .sc-stage{position:relative;width:100%;overflow:hidden}
.hero-demo .sc-win{width:1080px;transform-origin:top left;box-shadow:var(--shadow-lg),0 0 70px -22px rgba(224,88,46,.4)}
.hero-demo .sc-body{min-height:520px}

/* ---------- live orchestration console (hero centerpiece) ---------- */
/* hero product shot */
.hero-shot{position:relative;margin-top:var(--sp-8);border:1px solid var(--border-strong);
  border-radius:var(--r-md);overflow:hidden;background:var(--charcoal);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 50px 110px -42px rgba(0,0,0,.9),0 24px 130px -28px rgba(224,88,46,.22);
  animation:floaty 7s ease-in-out infinite;will-change:transform}
.shot-chrome{display:flex;align-items:center;gap:14px;height:42px;padding:0 16px;
  background:var(--charcoal);border-bottom:1px solid var(--border)}
.shot-dots{display:flex;gap:7px}
.shot-dots i{width:11px;height:11px;border-radius:50%;background:#2A2826;display:block}
.shot-addr{flex:1;text-align:center;font-family:var(--font-mono);font-size:12px;color:var(--fg-subtle)}
.shot-meta{font-family:var(--font-mono);font-size:10px;color:var(--fg-subtle)}
.hero-shot img{display:block;width:100%;height:auto}
/* static in-page product shot */
.shot{position:relative;margin-top:var(--sp-7);border:1px solid var(--border-strong);
  border-radius:var(--r-md);overflow:hidden;background:var(--charcoal);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 40px 100px -42px rgba(0,0,0,.9),0 18px 110px -34px rgba(224,88,46,.15)}
.shot img{display:block;width:100%;height:auto}
/* animated run panel (how it works) */
.howui-screen{background:var(--bg);padding:clamp(20px,2.6vw,34px)}
.hu-bar{display:flex;justify-content:space-between;align-items:center;font-family:var(--font-mono);font-size:12px;color:var(--fg-subtle);padding-bottom:18px;border-bottom:1px solid var(--border)}
.hu-status{display:inline-flex;align-items:center;gap:7px;color:var(--fg-secondary)}
.hu-status i{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px rgba(224,88,46,.7);animation:lpblink 1.8s ease-in-out infinite}
.hu-status b{color:var(--accent);font-weight:500}
.hu-phases{display:flex;align-items:center;gap:10px;margin:22px 0 6px}
.hu-phase{flex:1;border:1px solid var(--border-strong);border-radius:var(--r-sm);padding:14px 16px;display:flex;flex-direction:column;gap:5px;transition:border-color .35s var(--ease),background .35s var(--ease)}
.hu-pk{font-family:var(--font-sans);font-weight:600;font-size:15px;color:var(--fg-secondary);transition:color .35s var(--ease);display:flex;align-items:center;gap:7px}
.hu-pl{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.02em;color:var(--fg-subtle)}
.hu-phase.active{border-color:rgba(224,88,46,.55);background:rgba(224,88,46,.07)}
.hu-phase.active .hu-pk{color:var(--accent)}
.hu-phase.done .hu-pk{color:var(--fg)}
.hu-phase.done .hu-pk::before{content:"✓";color:var(--fg-subtle);font-weight:700;font-size:12px}
.hu-conn{width:18px;height:1px;background:var(--border-strong);flex:none}
.hu-loop{font-family:var(--font-mono);color:var(--fg-subtle);font-size:18px;flex:none;margin-left:2px;transition:color .3s,transform .6s var(--ease-out)}
.hu-loop.spin{color:var(--accent);transform:rotate(-360deg)}
.hu-steps{margin-top:22px;display:flex;flex-direction:column;gap:2px;min-height:138px}
.hu-step{display:flex;align-items:center;gap:12px;padding:9px 2px;transition:opacity .35s var(--ease)}
.hu-step .hu-b{width:15px;height:15px;border-radius:50%;flex:none;border:1.5px solid var(--border-strong);position:relative;transition:border-color .35s,box-shadow .35s,background .35s}
.hu-step .hu-t{font-family:var(--font-mono);font-size:13.5px;color:var(--fg-subtle);transition:color .35s var(--ease)}
.hu-step.pending{opacity:.5}
.hu-step.active .hu-b{border-color:var(--accent);box-shadow:0 0 0 4px rgba(224,88,46,.14);background:radial-gradient(circle,var(--accent) 0 36%,transparent 42%)}
.hu-step.active .hu-t{color:var(--fg)}
.hu-step.done .hu-b{border-color:rgba(224,88,46,.45);background:rgba(224,88,46,.12)}
.hu-step.done .hu-b::after{content:"✓";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--accent)}
.hu-step.done .hu-t{color:var(--fg-secondary)}
@media(prefers-reduced-motion:reduce){.hu-status i{animation:none}}
/* lifecycle animation: Plan -> Execute -> Evolve */
/* ---------- how it works: app screencast demo ---------- */
.sc-wrap{margin-top:var(--sp-7)}
.sc-win{position:relative;border:1px solid var(--border-strong);border-radius:var(--r-card);overflow:hidden;background:var(--bg);box-shadow:var(--shadow-lg),0 0 60px -22px rgba(224,88,46,.4)}
.sc-chrome{display:flex;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid var(--border);background:var(--charcoal)}
.sc-dots{display:inline-flex;gap:6px}
.sc-dots i{width:11px;height:11px;border-radius:50%;background:var(--border-strong)}
.sc-addr{font-family:var(--font-mono);font-size:12px;color:var(--fg-subtle);background:var(--bg);border:1px solid var(--border);border-radius:100px;padding:3px 13px}
.sc-rec{margin-left:auto;display:inline-flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:11px;color:var(--fg-secondary)}
.sc-rec .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 rgba(224,88,46,.6);animation:screc 2.2s var(--ease) infinite}
.sc-rec b{color:var(--accent);font-weight:500;letter-spacing:.04em}
@keyframes screc{0%{box-shadow:0 0 0 0 rgba(224,88,46,.5)}70%{box-shadow:0 0 0 6px rgba(224,88,46,0)}100%{box-shadow:0 0 0 0 rgba(224,88,46,0)}}

.sc-body{display:flex;min-height:clamp(400px,44vw,540px)}
.sc-side{width:194px;flex:none;border-right:1px solid var(--border);background:var(--charcoal);padding:14px 10px;display:flex;flex-direction:column;gap:1px;overflow:auto}
.sc-ws{display:flex;align-items:center;gap:10px;padding:4px 8px 12px}
.sc-ws .av{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--accent),#b8431f);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;font-size:12px;color:#1a0d07;flex:none}
.sc-ws .nm{font-family:var(--font-display);font-weight:600;font-size:13px;color:var(--fg);line-height:1.2}
.sc-ws .sub{font-family:var(--font-mono);font-size:9.5px;color:var(--fg-subtle);text-transform:uppercase;letter-spacing:.08em}
.sc-navsec{font-family:var(--font-mono);font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:var(--fg-subtle);padding:12px 10px 5px}
.sc-nav{display:flex;align-items:center;gap:10px;padding:6px 10px;border-radius:8px;font-family:var(--font-text);font-size:12.5px;color:var(--fg-subtle);transition:color .25s,background .25s,box-shadow .25s}
.sc-nav .i{width:13px;height:13px;border-radius:4px;border:1.5px solid var(--border-strong);flex:none;transition:border-color .25s,background .25s}
.sc-nav.on{background:rgba(224,88,46,.10);color:var(--fg);box-shadow:inset 2px 0 0 var(--accent)}
.sc-nav.on .i{border-color:var(--accent);background:rgba(224,88,46,.4)}

.sc-main{flex:1;position:relative;overflow:hidden;background:var(--bg)}
.sc-scene{position:absolute;inset:0;padding:clamp(16px,2vw,26px);opacity:0;visibility:hidden;transform:translateY(10px);transition:opacity .5s var(--ease),transform .5s var(--ease),visibility .5s;overflow:auto}
.sc-scene.on{opacity:1;visibility:visible;transform:none}
.sc-ph{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
.sc-ph h4{font-family:var(--font-display);font-weight:400;font-size:18px;color:var(--fg)}
.sc-ph .meta{font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle)}

/* scrubber: clickable chapter tabs */
.sc-bar{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}
.sc-seg{flex:1;min-width:118px;display:flex;flex-direction:column;gap:10px;background:var(--charcoal);border:1px solid var(--border);border-radius:var(--r-sm);padding:11px 13px 12px;cursor:pointer;text-align:left;transition:border-color .2s var(--ease),background .2s var(--ease),transform .15s var(--ease)}
.sc-seg:hover{border-color:var(--border-strong);transform:translateY(-2px)}
.sc-seg:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.sc-seg.on{border-color:rgba(224,88,46,.5);background:rgba(224,88,46,.07)}
.sc-seg .tk{height:3px;border-radius:100px;background:var(--border-strong);overflow:hidden;position:relative}
.sc-seg .fl{position:absolute;inset:0 100% 0 0;background:var(--border-strong);transition:right .45s var(--ease)}
.sc-seg.on .fl{right:0;background:var(--accent)}
.sc-seg.done .fl{right:0}
.sc-seg .lb{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:11.5px;color:var(--fg-subtle);transition:color .2s}
.sc-seg .lb .n{font-size:10px;color:var(--fg-subtle);transition:color .2s}
.sc-seg:hover .lb{color:var(--fg-secondary)}
.sc-seg.on .lb{color:var(--fg)}
.sc-seg.on .lb .n{color:var(--accent)}

/* generic app bits */
.sc-input{font-family:var(--font-text);font-size:13px;color:var(--fg);background:var(--bg);border:1px solid var(--border-strong);border-radius:var(--r-sm);padding:10px 12px;min-height:20px}
.sc-input.focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(224,88,46,.12)}
.sc-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-subtle);margin-bottom:6px;display:block}
.sc-sel{font-family:var(--font-text);font-size:12.5px;color:var(--fg-secondary);background:var(--bg);border:1px solid var(--border);border-radius:var(--r-sm);padding:9px 12px;display:flex;align-items:center;justify-content:space-between;gap:8px}
.sc-sel .cv{color:var(--fg)}
.sc-sel::after{content:"";width:7px;height:7px;border-right:1.5px solid var(--fg-subtle);border-bottom:1.5px solid var(--fg-subtle);transform:rotate(45deg) translateY(-2px)}
.sc-btn{font-family:var(--font-sans);font-weight:600;font-size:13px;padding:10px 18px;border-radius:100px;border:0;cursor:default}
.sc-btn.pri{background:var(--accent);color:#1a0d07}
.sc-btn.ghost{background:none;border:1px solid var(--border-strong);color:var(--fg-secondary)}
.sc-btn.pulse{animation:scpulse 1.4s var(--ease) infinite}
@keyframes scpulse{0%,100%{box-shadow:0 0 0 0 rgba(224,88,46,0)}50%{box-shadow:0 0 0 6px rgba(224,88,46,.22)}}
.sc-typed,.sc-q{display:inline}
.sc-typed .th,.sc-q .th{visibility:hidden}
.sc-cur{display:inline-block;width:2px;height:1.05em;background:var(--accent);border-radius:1px;margin:0 1px;vertical-align:-0.16em;animation:scblink 1s step-end infinite}
.sc-cur.hide{opacity:0;animation:none}
@keyframes scblink{50%{opacity:0}}

/* scene 1: modal */
.sc-dim{position:absolute;inset:0;background:rgba(8,7,6,.55);display:flex;align-items:center;justify-content:center;padding:14px}
.sc-modal{width:min(440px,100%);background:var(--surface);border:1px solid var(--border-strong);border-radius:var(--r-md);box-shadow:var(--shadow-lg);overflow:hidden}
.sc-modal-h{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--border)}
.sc-modal-h h5{font-family:var(--font-display);font-weight:500;font-size:15px;color:var(--fg)}
.sc-modal-h .x{font-family:var(--font-mono);color:var(--fg-subtle);font-size:15px}
.sc-modal-b{padding:18px;display:flex;flex-direction:column;gap:14px}
.sc-2col{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sc-modal-f{display:flex;justify-content:flex-end;gap:10px;padding:14px 18px;border-top:1px solid var(--border)}
.sc-faint-head{font-family:var(--font-display);font-weight:400;font-size:17px;color:var(--fg-subtle);position:absolute;top:24px;left:26px}

/* scene 2: kanban + run */
.sc-kanban{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.sc-kanban>div{background:var(--charcoal);border:1px solid var(--border);border-radius:var(--r-md);padding:11px 11px 13px}
.sc-col-h{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-subtle);margin-bottom:11px;padding-bottom:9px;border-bottom:1px solid var(--border)}
.sc-col-h .ct{margin-left:auto;color:var(--fg);background:var(--bg);border:1px solid var(--border-strong);border-radius:100px;padding:1px 8px;font-size:10px;transition:all .3s}
.sc-kcol{display:flex;flex-direction:column;gap:8px;min-height:138px}
.sc-card{position:relative;background:var(--elevated);border:1px solid var(--border-strong);border-radius:var(--r-sm);padding:10px 11px;transition:box-shadow .4s var(--ease),border-color .4s}
.sc-card .t{font-family:var(--font-text);font-size:12.5px;color:var(--fg);margin-bottom:5px}
.sc-card .m{font-family:var(--font-mono);font-size:10px;color:var(--fg-subtle);display:flex;gap:8px}
.sc-card.live{border-color:rgba(224,88,46,.5);box-shadow:0 0 0 1px rgba(224,88,46,.25)}
.sc-card.flying{z-index:6;border-color:rgba(224,88,46,.5);box-shadow:0 16px 36px -12px rgba(0,0,0,.7)}
.sc-run{border:1px solid var(--border);border-radius:var(--r-md);background:var(--charcoal);overflow:hidden}
.sc-run-h{display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:11.5px;color:var(--fg-secondary)}
.sc-run-h b{color:var(--fg);font-weight:500}
.sc-runtag{margin-left:auto;font-family:var(--font-mono);font-size:10px;padding:2px 9px;border-radius:100px;border:1px solid var(--border-strong);color:var(--fg-subtle)}
.sc-runtag.run{color:var(--accent);border-color:rgba(224,88,46,.4);background:rgba(224,88,46,.08)}
.sc-runtag.ok{color:var(--accent);border-color:rgba(224,88,46,.4);background:rgba(224,88,46,.1)}
.sc-run-b{display:grid;grid-template-columns:1fr 1fr;gap:0}
.sc-wsteps{padding:14px;display:flex;flex-direction:column;gap:9px;border-right:1px solid var(--border)}
.sc-wstep{display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:11.5px;color:var(--fg-subtle);transition:color .3s}
.sc-wstep .b{width:13px;height:13px;border-radius:50%;border:1.5px solid var(--border-strong);flex:none;position:relative;transition:all .3s}
.sc-wstep.run{color:var(--accent)}
.sc-wstep.run .b{border-color:var(--accent);box-shadow:0 0 0 4px rgba(224,88,46,.14);background:radial-gradient(circle,var(--accent) 0 36%,transparent 42%)}
.sc-wstep.done{color:var(--fg-secondary)}
.sc-wstep.done .b{border-color:rgba(224,88,46,.45);background:rgba(224,88,46,.16)}
.sc-wstep.done .b::after{content:"✓";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:8px;color:var(--accent)}
.sc-rep{padding:14px}
.sc-rep-ttl{font-family:var(--font-mono);font-size:10px;color:var(--fg-subtle);text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px}
.sc-rep-row{display:flex;justify-content:space-between;gap:10px;font-family:var(--font-mono);font-size:11px;color:var(--fg-secondary);padding:5px 0;border-bottom:1px solid var(--border);opacity:0;transform:translateY(4px);transition:opacity .4s,transform .4s}
.sc-rep-row.in{opacity:1;transform:none}
.sc-rep-row b{color:var(--fg);font-weight:500}

/* scene 3: assets / markdown */
.sc-assets{display:grid;grid-template-columns:200px 1fr;gap:18px}
.sc-files{display:flex;flex-direction:column;gap:4px}
.sc-file{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:8px;font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle)}
.sc-file .d{width:9px;height:9px;border-radius:2px;border:1px solid var(--border-strong);flex:none}
.sc-file.on{background:rgba(224,88,46,.1);color:var(--fg)}
.sc-file.on .d{border-color:var(--accent);background:rgba(224,88,46,.4)}
.sc-md{font-family:var(--font-text);color:var(--fg-secondary);max-width:560px}
.sc-md-sec{opacity:0;transform:translateY(8px);transition:opacity .5s var(--ease),transform .5s var(--ease)}
.sc-md-sec.in{opacity:1;transform:none}
.sc-md h3{font-family:var(--font-display);font-weight:400;font-size:20px;color:var(--fg);margin-bottom:4px}
.sc-md .sub{font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle);margin-bottom:16px}
.sc-md h6{font-family:var(--font-mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);margin:18px 0 8px}
.sc-tbl{width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:11.5px}
.sc-tbl th{text-align:left;color:var(--fg-subtle);font-weight:400;padding:5px 8px;border-bottom:1px solid var(--border-strong)}
.sc-tbl td{padding:5px 8px;border-bottom:1px solid var(--border);color:var(--fg-secondary)}
.sc-tbl td:first-child{color:var(--fg)}
.sc-tbl .up{color:var(--accent)}
.sc-tbl .dn{color:var(--fg-subtle)}

/* scene 4: sessions */
.sc-sess{display:grid;grid-template-columns:230px 1fr;gap:18px}
.sc-cfg{display:flex;flex-direction:column;gap:14px}
.sc-chips{display:flex;flex-wrap:wrap;gap:6px}
.sc-chip{font-family:var(--font-mono);font-size:10.5px;padding:5px 10px;border-radius:100px;border:1px solid var(--border);color:var(--fg-subtle)}
.sc-chip.on{border-color:var(--accent);background:rgba(224,88,46,.1);color:var(--accent)}
.sc-toggle{display:inline-flex;border:1px solid var(--border);border-radius:100px;padding:2px;gap:2px}
.sc-toggle span{font-family:var(--font-mono);font-size:10.5px;padding:4px 11px;border-radius:100px;color:var(--fg-subtle)}
.sc-toggle span.on{background:rgba(224,88,46,.14);color:var(--accent)}
.sc-chat{display:flex;flex-direction:column;gap:12px;border-left:1px solid var(--border);padding-left:18px}
.sc-msg{max-width:90%}
.sc-msg.u{align-self:flex-end}
.sc-bub{font-family:var(--font-text);font-size:12.5px;line-height:1.5;padding:10px 13px;border-radius:12px;color:var(--fg)}
.sc-msg.u .sc-bub{background:rgba(224,88,46,.12);border:1px solid rgba(224,88,46,.3)}
.sc-msg.a .sc-bub{background:var(--charcoal);border:1px solid var(--border)}
.sc-status{font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle);display:flex;align-items:center;gap:8px;opacity:0;transition:opacity .4s}
.sc-status.in{opacity:1}
.sc-status .sp{width:11px;height:11px;border-radius:50%;border:1.5px solid var(--border-strong);border-top-color:var(--accent);animation:scspin .8s linear infinite}
@keyframes scspin{to{transform:rotate(360deg)}}
.sc-cn-row{display:flex;justify-content:space-between;gap:10px;font-family:var(--font-mono);font-size:11px;color:var(--fg-secondary);padding:4px 0;border-bottom:1px solid var(--border);opacity:0;transform:translateX(-6px);transition:opacity .35s,transform .35s}
.sc-cn-row.in{opacity:1;transform:none}
.sc-cn-row b{color:var(--fg);font-weight:500}
.sc-cn-row .rk{color:var(--fg-subtle);width:18px;flex:none}
.sc-take{margin-top:10px;font-family:var(--font-text);font-size:12px;color:var(--fg-secondary);border-left:2px solid var(--accent);padding-left:11px;opacity:0;transform:translateY(4px);transition:opacity .45s,transform .45s}
.sc-take.in{opacity:1;transform:none}

/* scene 5: overview */
.sc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.sc-stat{background:var(--charcoal);border:1px solid var(--border);border-radius:var(--r-md);padding:15px}
.sc-stat .k{font-family:var(--font-mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--fg-subtle);margin-bottom:8px}
.sc-stat .sc-stat-n{font-family:var(--font-display);font-weight:300;font-size:28px;color:var(--fg);line-height:1}
.sc-ov2{display:grid;grid-template-columns:1.3fr 1fr;gap:16px}
.sc-panel{border:1px solid var(--border);border-radius:var(--r-md);background:var(--charcoal);padding:15px}
.sc-panel h6{font-family:var(--font-mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-subtle);margin-bottom:12px}
.sc-act{display:flex;align-items:center;gap:10px;padding:7px 0;font-family:var(--font-text);font-size:12px;color:var(--fg-secondary);opacity:0;transform:translateX(-6px);transition:opacity .4s,transform .4s}
.sc-act.in{opacity:1;transform:none}
.sc-act .dt{width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;opacity:.7}
.sc-act .tm{margin-left:auto;font-family:var(--font-mono);font-size:10px;color:var(--fg-subtle)}
.sc-runbar{height:10px;border-radius:100px;background:var(--bg);overflow:hidden;display:flex;margin:6px 0 14px}
.sc-runbar-fill{width:0;transition:width .9s var(--ease)}
.sc-runbar-fill.ok{background:var(--accent)}
.sc-runbar-fill.fail{background:var(--border-strong)}
.sc-legend{display:flex;flex-direction:column;gap:8px;font-family:var(--font-mono);font-size:11px;color:var(--fg-secondary)}
.sc-legend .row{display:flex;align-items:center;gap:9px}
.sc-legend .sw{width:10px;height:10px;border-radius:3px;flex:none}
.sc-legend .sw.ok{background:var(--accent)}
.sc-legend .sw.fail{background:var(--border-strong)}
.sc-legend b{color:var(--fg);font-weight:500;margin-left:auto}

@media(max-width:820px){
  .sc-side{display:none}
  .sc-run-b{grid-template-columns:1fr}.sc-wsteps{border-right:0;border-bottom:1px solid var(--border)}
  .sc-assets,.sc-sess{grid-template-columns:1fr}
  .sc-chat{border-left:0;padding-left:0;border-top:1px solid var(--border);padding-top:14px}
  .sc-stats{grid-template-columns:repeat(2,1fr)}.sc-ov2{grid-template-columns:1fr}
  .sc-bar{flex-wrap:wrap}.sc-seg{flex:1 1 30%}
}
@media(prefers-reduced-motion:reduce){
  .sc-rec .dot,.sc-btn.pulse,.sc-cur,.sc-status .sp{animation:none}
}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@media(prefers-reduced-motion:reduce){.hero-shot{animation:none}}
.console{margin-top:var(--sp-8);background:var(--elevated);border:1px solid var(--border);border-radius:var(--r-card);overflow:hidden;box-shadow:var(--shadow-lg)}
.console-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:14px 22px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:12px;color:var(--fg-muted);flex-wrap:wrap}
.live{display:inline-flex;align-items:center;gap:8px;color:var(--fg)}
.live b{font-weight:500}
.live .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 rgba(224,88,46,.6);animation:pulse 2.4s var(--ease) infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(224,88,46,.5)}70%{box-shadow:0 0 0 7px rgba(224,88,46,0)}100%{box-shadow:0 0 0 0 rgba(224,88,46,0)}}
.console-body{display:grid;grid-template-columns:1.35fr 1fr}
.console-left{padding:24px;border-right:1px solid var(--border)}
.pl-head{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle);margin-bottom:18px}
.pl-row{display:flex;align-items:stretch;gap:0;flex-wrap:wrap;margin-bottom:28px}
.pl-step{flex:1;min-width:72px;padding:12px 10px;border:1px solid var(--border);border-radius:var(--r-sm);position:relative;background:var(--bg)}
.pl-step.active{border-color:var(--accent)}
.pl-conn{align-self:center;width:14px;height:1px;background:var(--border-strong)}
.ps-l{font-family:var(--font-sans);font-size:13px;font-weight:500;color:var(--fg)}
.ps-s{font-family:var(--font-mono);font-size:10px;color:var(--fg-muted);margin-top:4px}
.ps-bar{position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--accent);animation:fill 3.2s var(--ease) infinite}
@keyframes fill{0%{width:0}60%{width:100%}100%{width:100%}}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--r-sm);overflow:hidden}
.stat{background:var(--elevated);padding:14px 14px}
.sl{font-family:var(--font-mono);font-size:10px;color:var(--fg-subtle);letter-spacing:.04em}
.sv{font-family:var(--font-display);font-size:24px;font-weight:400;color:var(--fg);margin-top:4px;line-height:1}
.sv u{font-family:var(--font-mono);font-size:11px;text-decoration:none;color:var(--fg-muted);margin-left:2px}
.sd{font-family:var(--font-mono);font-size:10px;color:var(--accent);margin-top:5px}
.sd.dim{color:var(--fg-subtle)}
.console-right{padding:24px;display:flex;flex-direction:column}
.log-head,.log-foot{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle)}
.log{flex:1;margin:14px 0;font-family:var(--font-mono);font-size:12px;line-height:1.9;color:var(--fg-secondary);overflow:hidden}
.log .row{display:flex;gap:12px}
.log .t{color:var(--ink-10);flex:none}
.log .a{color:var(--accent)}
.caret{display:inline-block;width:7px;height:13px;background:var(--accent);vertical-align:-2px;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}

/* ============================================================
   THE GAP
   ============================================================ */
.gap2{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sp-2)}
.gap2-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-card);padding:var(--sp-6);transition:border-color var(--dur) var(--ease)}
.gap2-card:hover{border-color:var(--border-strong)}
.gn{font-family:var(--font-mono);font-size:var(--fs-small);color:var(--accent);margin-bottom:var(--sp-4)}
.gap2-card h3{font-size:var(--fs-sub);margin-bottom:14px}
.gap2-card p{color:var(--fg-secondary);max-width:46ch}
.gap-viz{height:72px;margin-bottom:18px;display:flex;align-items:center}
.gap-viz svg{width:100%;height:56px;display:block}
.gv-node{fill:none;stroke:var(--border-strong);stroke-width:1.4}
.gv-dot{fill:var(--fg-subtle)}
.gv-line{fill:none;stroke:var(--border-strong);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.gv-dash{fill:none;stroke:var(--fg-subtle);stroke-width:1.4;stroke-dasharray:4 4;stroke-linecap:round}
.gv-lbl{font-family:var(--font-mono);font-size:12px;fill:var(--fg-subtle)}
.gv-flow{fill:var(--accent);animation:gvGate 4.6s var(--ease) infinite}
.gv-pulse{animation:gvPulse 3.6s var(--ease) infinite}
.gv-crawl{animation:gvCrawl 2.6s linear infinite}
.gv-trace{animation:gvTrace 4s var(--ease) infinite}
.gv-q{animation:gvBlink 4s var(--ease) infinite}
@keyframes gvGate{0%{transform:translateX(0);opacity:0}12%{opacity:1}88%{opacity:1}100%{transform:translateX(216px);opacity:0}}
@keyframes gvPulse{0%,100%{opacity:.28}50%{opacity:1}}
@keyframes gvCrawl{to{stroke-dashoffset:-16}}
@keyframes gvTrace{0%,100%{opacity:.3}30%{opacity:1}}
@keyframes gvBlink{0%,60%,100%{opacity:.4}80%{opacity:1}}
.gtag{font-family:var(--font-mono);font-size:12px;color:var(--fg-subtle);margin-top:var(--sp-4);padding-top:18px;border-top:1px solid var(--border)}

/* ============================================================
   WHAT IT IS
   ============================================================ */
.witis{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-9);align-items:center}
.flist{margin-top:var(--sp-7);display:flex;flex-direction:column}
.flist-item{display:grid;grid-template-columns:auto 1fr;gap:0 22px;padding:26px 0;border-top:1px solid var(--border)}
.flist-item:last-child{border-bottom:1px solid var(--border)}
.fn{font-family:var(--font-mono);font-size:13px;color:var(--accent);padding-top:5px}
.flist-item h3{font-size:var(--fs-sub);grid-column:2}
.flist-item p{grid-column:2;color:var(--fg-secondary);margin-top:8px;max-width:46ch}
.graph-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-card);overflow:hidden}
.graph-head{display:flex;justify-content:space-between;padding:16px 22px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle)}
.graph-stage{position:relative;aspect-ratio:1/.92}
.graph-stage svg{position:absolute;inset:0;width:100%;height:100%}

/* ---- layer-as-a-plane (How we fill the gap) ---- */
.gh-live{display:inline-flex;align-items:center;gap:6px;color:var(--fg-subtle)}
.gh-live i{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:lpblink 2.4s ease-in-out infinite}
@keyframes lpblink{0%,100%{opacity:.4}50%{opacity:1}}
.gap-vis{max-width:480px;width:100%;margin-inline:auto}
.gap-stage{position:relative}
.gap-svg{width:100%;height:auto;display:block;overflow:visible}
/* boxes — match handoffs cards (elevated + border-strong) and the Where-it-fits node shadow */
.gap-card{fill:var(--elevated);stroke:var(--border-strong);stroke-width:1;filter:drop-shadow(0 8px 16px rgba(0,0,0,.55))}
.gap-card.flow{fill:#1c1310;stroke:rgba(224,88,46,.55);filter:drop-shadow(0 0 22px rgba(224,88,46,.35))}
/* connectors — match the Where-it-fits ring-conn */
.gap-wire{fill:none;stroke:rgba(224,88,46,.5);stroke-width:1.3;filter:drop-shadow(0 0 3px rgba(224,88,46,.45))}
.gap-token{fill:var(--accent);filter:drop-shadow(0 0 8px rgba(224,88,46,.95))}
/* type — same families/weights as the other visuals */
.gap-task{font-family:var(--font-sans);font-weight:500;font-size:13px;fill:var(--fg);text-anchor:middle}
.gap-t{font-family:var(--font-sans);font-weight:500;fill:var(--fg)}
.gap-t.hub{font-size:16px;text-anchor:middle}
.gap-eyebrow{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.16em;fill:var(--accent);text-anchor:middle}
.gap-hub-sub{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.04em;fill:var(--fg-subtle);text-anchor:middle}
.gap-name{font-family:var(--font-sans);font-weight:500;font-size:13px;fill:var(--fg)}
.gap-name.sm{font-size:11.5px}
.gap-flow{font-family:var(--font-display);font-weight:700;font-size:22px;letter-spacing:-.01em;fill:var(--fg)}
.gap-ic{fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
@media(prefers-reduced-motion:reduce){.gap-token{opacity:0}}
.gnode{position:absolute;transform:translate(-50%,-50%);font-family:var(--font-mono);font-size:11px;color:var(--fg-secondary);
  background:var(--surface);border:1px solid var(--border-strong);border-radius:var(--r-pill);padding:6px 12px;white-space:nowrap}
.gnode.center{font-family:var(--font-sans);font-size:11px;font-weight:600;letter-spacing:.08em;color:var(--bg);
  background:var(--fg);border-color:var(--fg);text-align:center;line-height:1.2;padding:14px 16px;border-radius:var(--r-md)}

/* ============================================================
   HOW IT WORKS
   ============================================================ */
.hiw{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-2)}
.hiw-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-card);padding:var(--sp-6);transition:border-color var(--dur) var(--ease)}
.hiw-card:hover{border-color:var(--border-strong)}
.hk{font-family:var(--font-sans);font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.1em;color:var(--accent);margin-bottom:var(--sp-5)}
.hiw-card h3{font-size:var(--fs-sub);margin-bottom:12px}
.hiw-card p{color:var(--fg-secondary)}
.htag{font-family:var(--font-mono);font-size:12px;color:var(--fg-subtle);margin-top:var(--sp-4);padding-top:18px;border-top:1px solid var(--border)}

/* ============================================================
   WHERE IT FITS — interactive ring
   ============================================================ */
.ring-wrap{display:grid;grid-template-columns:1fr 1.1fr;gap:var(--sp-9);align-items:center}
.phase{padding:24px;border:1px solid var(--border);border-radius:var(--r-md);margin-bottom:var(--sp-2);cursor:pointer;
  transition:border-color var(--dur) var(--ease),background var(--dur) var(--ease)}
.phase:hover{border-color:var(--border-strong)}
.phase.active{border-color:var(--accent);background:rgba(224,88,46,.04)}
.phase-top{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle);margin-bottom:10px}
.phase h3{font-size:var(--fs-sub);margin-bottom:8px}
.pitems{font-family:var(--font-mono);font-size:12px;color:var(--fg-muted);margin-bottom:10px}
.pdesc{color:var(--fg-secondary);font-size:var(--fs-small);max-width:46ch}
.sprint-btn{margin-top:var(--sp-4)}
.ring{position:relative;aspect-ratio:1/1;max-width:560px;margin-inline:auto;width:100%}
.ring svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ring-track{fill:none;stroke:rgba(209,207,205,.15);stroke-width:1.4}
.ring-conn{stroke:rgba(224,88,46,.5);stroke-width:1.3;filter:drop-shadow(0 0 3px rgba(224,88,46,.45));animation:connPulse 3.8s var(--ease) infinite}
.ring-arc{fill:none;stroke:var(--accent);stroke-width:3.4;stroke-linecap:round;filter:drop-shadow(0 0 7px rgba(224,88,46,.85))}
.rnode{position:absolute;transform:translate(-50%,-50%);z-index:2;min-width:100px;padding:11px 16px;
  border-radius:14px;text-align:center;background:var(--charcoal);border:1px solid var(--border);
  box-shadow:0 10px 26px -16px rgba(0,0,0,.85);
  transition:border-color var(--dur) var(--ease),background var(--dur) var(--ease),box-shadow var(--dur) var(--ease),transform var(--dur) var(--ease)}
.rn{font-family:var(--font-mono);font-size:12px;color:var(--fg-subtle);line-height:1.15}
.rl{font-family:var(--font-sans);font-size:15px;font-weight:500;color:var(--fg);white-space:nowrap;margin-top:3px}
.rnode.dim .rl{color:var(--fg-secondary)}
.rnode.on{border-color:rgba(224,88,46,.55);background:#1c1310;box-shadow:0 0 22px -6px rgba(224,88,46,.45)}
.rnode.on .rn{color:var(--accent)}
.rnode.lead{background:var(--accent);border-color:var(--accent);box-shadow:0 0 36px -4px rgba(224,88,46,.7);transform:translate(-50%,-50%) scale(1.05)}
.rnode.lead .rn{color:rgba(10,9,8,.6)}
.rnode.lead .rl{color:#0A0908;font-weight:600}
.ring-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:3;
  width:40%;aspect-ratio:1;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;
  background:radial-gradient(circle at 50% 36%,#171310 0%,#0c0a09 60%,#0a0908 100%);
  border:1px solid rgba(224,88,46,.55);
  box-shadow:0 0 64px -6px rgba(224,88,46,.32),inset 0 0 26px -6px rgba(224,88,46,.45),0 0 0 1px rgba(224,88,46,.07)}
.rc-pillar{font-family:var(--font-mono);font-size:12px;font-weight:500;letter-spacing:.04em;color:var(--accent)}
.rc-name{font-family:var(--font-display);font-size:clamp(20px,2.4vw,26px);font-weight:400;color:var(--fg);margin:5px 0}
.rc-sub{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--fg-subtle)}
.ring-center::after{content:"";position:absolute;inset:0;border-radius:50%;border:1px solid rgba(224,88,46,.5);pointer-events:none;animation:corePing 4.6s var(--ease-out) infinite}
@keyframes connPulse{0%,100%{opacity:.5}50%{opacity:1}}
@keyframes corePing{0%{transform:scale(1);opacity:.55}70%{opacity:0}100%{transform:scale(1.65);opacity:0}}

/* ============================================================
   HANDOFFS
   ============================================================ */
.handoffs-wrap{display:grid;grid-template-columns:1fr 1.05fr;gap:var(--sp-9);align-items:center}
.handoffs-head{max-width:680px;margin:0 auto;text-align:center}
.handoffs-head .big-head{max-width:none;margin-inline:auto}
.handoffs-head .lead-muted{margin-inline:auto}
.feat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-8);max-width:920px;margin:var(--sp-8) auto 0}
.feat-list{display:flex;flex-direction:column;gap:var(--sp-5);margin-top:var(--sp-8)}
.feat{padding-left:var(--sp-4);border-left:1px solid var(--border-strong);transition:border-color var(--dur) var(--ease)}
.feat.active{border-left:2px solid var(--accent);padding-left:calc(var(--sp-4) - 1px)}
.feat-row .feat{padding:var(--sp-4) 0 0;border-left:none;border-top:1px solid var(--border-strong)}
.feat-row .feat.active{border-left:none;border-top:2px solid var(--accent);padding-top:calc(var(--sp-4) - 1px)}
.feat h3{font-family:var(--font-sans);font-weight:600;font-size:var(--fs-body-lg);line-height:1.2;color:var(--fg)}
.feat p{color:var(--fg-secondary);margin-top:8px;max-width:46ch}
.flowcard{background:transparent;border:0;border-radius:0;padding:0;max-width:920px;margin:var(--sp-6) auto 0}
.flowcard svg{width:100%;height:auto;display:block}
.flowcard .hand-svg{overflow:visible}
/* surfaces */
.flowcard .hl-agents{fill:rgba(224,88,46,.05);stroke:rgba(224,88,46,.22);stroke-width:1}
.flowcard .hl-humans{fill:rgba(209,207,205,.025);stroke:var(--border);stroke-width:1}
.flowcard .hl-lbl{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.16em}
.flowcard .hl-lbl.a{fill:var(--accent)}
.flowcard .hl-lbl.h{fill:var(--fg-subtle)}
/* cards */
.flowcard .hcard-bg{fill:var(--elevated);stroke:var(--border-strong);stroke-width:1}
.flowcard .hcard-bg.human{fill:#171413}
.flowcard .hc-title{font-family:var(--font-sans);font-weight:500;font-size:12.5px;fill:var(--fg)}
.flowcard .hc-sub{font-family:var(--font-mono);font-size:10px;letter-spacing:.13em;fill:var(--fg-subtle)}
/* connector + traveling point — reuses the "Where it fits" ring-arc styling */
.flowcard .htoken{fill:var(--accent);filter:drop-shadow(0 0 8px rgba(224,88,46,.95))}
.flowcard .hdot-o{fill:none;stroke:var(--accent);stroke-width:2}
.flowcard .hdot-i{fill:var(--accent);filter:drop-shadow(0 0 5px rgba(224,88,46,.8))}
/* pill */
.flowcard .hpill-bg{fill:var(--charcoal);stroke:rgba(224,88,46,.55);stroke-width:1;filter:drop-shadow(0 0 18px rgba(224,88,46,.35))}
.flowcard .hpill-d{fill:var(--accent)}
.flowcard .hpill-t{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.02em;fill:var(--accent)}
@media(prefers-reduced-motion:reduce){.flowcard .htoken{opacity:0}}

/* ============================================================
   PRODUCT PREVIEW (how it works)
   ============================================================ */
.preview{margin-top:var(--sp-8);border:1px solid var(--border);border-radius:var(--r-card);background:var(--surface);overflow:hidden;box-shadow:var(--shadow-lg)}
.pv-bar{display:flex;align-items:center;justify-content:space-between;padding:15px 22px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:12px;color:var(--fg-muted)}
.pv-bar .b-l{display:flex;align-items:center;gap:10px}
.pv-bar .b-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(224,88,46,.14)}
.pv-body{padding:clamp(28px,3.4vw,52px)}
.pv-flow{display:grid;grid-template-columns:repeat(4,1fr);position:relative}
.pv-flow::before{content:"";position:absolute;left:13px;right:13px;top:13px;height:1px;background:var(--border-strong)}
.pv-node{position:relative;display:flex;flex-direction:column;gap:14px;padding-right:20px}
.pv-bub{width:27px;height:27px;border-radius:50%;border:1px solid var(--border-strong);background:var(--bg);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:11px;color:var(--fg-muted);z-index:1}
.pv-node.done .pv-bub{border-color:var(--fg-subtle);color:var(--fg-secondary)}
.pv-node.active .pv-bub{border-color:var(--accent);color:var(--accent);box-shadow:0 0 0 4px rgba(224,88,46,.12)}
.pv-node .t{font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--fg)}
.pv-node.active .t{color:var(--accent)}
.pv-node .s{font-family:var(--font-mono);font-size:11px;color:var(--fg-muted)}
.pv-detail{margin-top:clamp(28px,3.4vw,44px);background:var(--bg);border:1px solid var(--border);border-radius:var(--r-md);padding:clamp(20px,2.4vw,30px);display:grid;grid-template-columns:1.5fr 1fr;gap:var(--sp-6);align-items:center}
.pv-detail .dh{font-family:var(--font-sans);font-size:var(--fs-body-lg);font-weight:600;color:var(--fg)}
.pv-detail .dmeta{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:14px;font-family:var(--font-mono);font-size:12px;color:var(--fg-muted)}
.pv-detail .dmeta b{color:var(--fg-secondary);font-weight:400}
.pv-detail .dmeta .ok{color:var(--accent)}
.pv-pills{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
.pv-pill{font-family:var(--font-sans);font-size:12px;font-weight:600;padding:9px 16px;border-radius:var(--r-pill);white-space:nowrap}
.pv-pill.solid{background:var(--btn-primary-bg);color:var(--btn-primary-fg)}
.pv-pill.ghost{border:1px solid var(--border-strong);color:var(--fg-secondary)}

/* ============================================================
   OPEN SOURCE / SELF-HOST
   ============================================================ */
.selfhost-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,5vw,88px);align-items:center}
.kpis{display:flex;gap:clamp(20px,4vw,48px);flex-wrap:wrap;margin-top:var(--sp-5)}
.kpi .v{font-family:var(--font-display);font-size:clamp(2rem,3vw,2.6rem);font-weight:300;letter-spacing:-.02em;color:var(--fg)}
.kpi .l{font-size:13px;color:var(--fg-muted);margin-top:4px;max-width:22ch}
.os-meta{font-family:var(--font-mono);font-size:var(--fs-small);color:var(--fg-muted);margin-top:var(--sp-5)}
.code-block{position:relative;background:var(--bg);border:1px solid var(--border-strong);border-radius:var(--r-md);overflow:hidden;font-family:var(--font-mono);font-size:14px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 40px 100px -42px rgba(0,0,0,.9),0 18px 110px -34px rgba(224,88,46,.18)}
.code-bar{display:flex;align-items:center;gap:14px;height:40px;padding:0 16px;background:var(--charcoal);border-bottom:1px solid var(--border)}
.code-bar .shot-dots i{width:11px;height:11px;border-radius:50%;background:#2A2826;display:block}
.code-title{font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle)}
.code-row{display:flex;gap:12px;padding:16px 22px;color:var(--fg)}
.code-row+.code-row{border-top:1px solid var(--border)}
.code-row .cd{color:var(--accent)}
.code-row .cc{color:var(--fg-subtle)}
.code-foot{display:flex;justify-content:space-between;align-items:center;padding:12px 22px;border-top:1px solid var(--border);font-size:11px;color:var(--fg-subtle)}
.copy-btn{background:none;border:1px solid var(--border-strong);color:var(--fg-secondary);font-family:var(--font-mono);font-size:11px;padding:5px 12px;border-radius:var(--r-pill);transition:border-color var(--dur) var(--ease),color var(--dur) var(--ease)}
.copy-btn:hover{border-color:var(--fg-secondary);color:var(--fg)}
.cv-caret{display:inline-block;width:7px;height:15px;margin-left:7px;background:var(--accent);vertical-align:-2px;animation:cvBlink 1.5s steps(1,end) infinite}
@keyframes cvBlink{0%,49%{opacity:1}50%,100%{opacity:0}}
html.js .code-block .code-row{opacity:0;transform:translateY(7px);transition:opacity .55s var(--ease-out),transform .55s var(--ease-out)}
html.js .reveal.in .code-block .code-row{opacity:1;transform:none}
html.js .reveal.in .code-block .code-row:nth-child(2){transition-delay:.25s}
html.js .reveal.in .code-block .code-row:nth-child(3){transition-delay:.5s}
html.js .reveal.in .code-block .code-row:nth-child(4){transition-delay:.75s}
.contact-cta{text-align:center;max-width:640px;margin:0 auto}
.contact-cta h2{margin-bottom:var(--sp-3)}
.contact-cta .lead{margin-bottom:var(--sp-5);margin-inline:auto}
.contact-cta .btn-row{justify-content:center}
.btn-lg{padding:16px 30px;font-size:15px}

/* ============================================================
   COMPARISON
   ============================================================ */
.cmp-scroll{overflow-x:auto;border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg);-webkit-overflow-scrolling:touch}
.cmp{border-collapse:collapse;width:100%;min-width:920px}
.cmp th,.cmp td{text-align:left;padding:15px 16px;border-bottom:1px solid var(--border);vertical-align:middle}
.cmp thead th{position:sticky;top:0;background:var(--surface);font-family:var(--font-display);font-size:12px;font-weight:700;letter-spacing:.04em;color:var(--fg-secondary);white-space:nowrap}
.cmp thead th.cap{color:var(--fg-subtle)}
.cmp thead th.us{color:var(--fg)}
.cmp .us-col{background:rgba(224,88,46,.06)}
.cmp tbody th{font-family:var(--font-text);font-weight:400;font-size:14px;color:var(--fg);white-space:normal;min-width:210px;position:sticky;left:0;background:var(--bg)}
.cmp td{font-family:var(--font-text);font-weight:300;font-size:12.5px;color:var(--fg-muted);white-space:nowrap}
.cmp .v{display:inline-flex;align-items:center;gap:7px}
.cmp .mk{flex:0 0 auto;width:16px;height:16px}
.mk.yes{color:var(--accent)}
.mk.no{color:var(--ink-12)}
.mk.part{color:var(--fg-subtle)}
.cmp .us-col .note{color:var(--fg-secondary)}
.cmp .us-col td,.cmp td.us-col{color:var(--fg)}
.cmp-caveat{margin-top:22px;font-size:14px;color:var(--fg-muted);max-width:760px;line-height:1.55}
.cmp-caveat b{color:var(--fg-secondary);font-family:var(--font-display);font-weight:500}

/* ============================================================
   CONTACT
   ============================================================ */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-9);align-items:center}
.contact-card{background:var(--surface);border:1px solid var(--border-strong);border-radius:var(--r-md);padding:clamp(28px,3vw,40px);
  box-shadow:0 30px 80px -42px rgba(0,0,0,.85),0 0 90px -44px rgba(224,88,46,.14)}
.contact-card form{display:flex;flex-direction:column;gap:var(--sp-3)}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3)}
.field{display:flex;flex-direction:column}
.field label{font-family:var(--font-sans);font-size:12px;font-weight:500;color:var(--fg-secondary);margin-bottom:8px}
.field input,.field textarea{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-sm);
  color:var(--fg);font-family:var(--font-text);font-size:var(--fs-body);font-weight:300;padding:14px 16px;width:100%;
  transition:border-color var(--dur) var(--ease),box-shadow var(--dur) var(--ease)}
.field input::placeholder,.field textarea::placeholder{color:var(--fg-subtle)}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(224,88,46,.12)}
.field textarea{min-height:120px;resize:vertical}
.contact-card .btn{margin-top:var(--sp-2);width:100%;justify-content:center}
.contact-fine{font-family:var(--font-mono);font-size:11px;color:var(--fg-subtle);margin-top:4px;text-align:center}

/* ============================================================
   FOOTER
   ============================================================ */
.footer{background:var(--surface);padding-block:var(--sp-9) var(--sp-6);border-top:1px solid var(--border)}
.footer-grid{display:grid;grid-template-columns:1.6fr repeat(2,1fr);gap:var(--sp-6);padding-bottom:var(--sp-8)}
.footer-brand{display:flex;flex-direction:column}
.footer-brand .brand-row{display:inline-flex;align-items:center;gap:12px;font-size:30px}
.footer-brand .logo-img{height:.82em;width:auto;display:block}
.footer-brand .flow{font-family:var(--font-display);font-weight:700;font-size:1em;color:var(--fg);letter-spacing:-.01em}
.footer-brand h3{font-size:var(--fs-sub);max-width:18ch;margin-top:var(--sp-3);color:var(--fg)}
.footer-col h4{font-family:var(--font-sans);font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.1em;color:var(--fg-subtle);margin-bottom:var(--sp-3)}
.footer-col a{display:block;color:var(--fg-secondary);font-size:var(--fs-small);padding:6px 0;transition:color var(--dur) var(--ease)}
.footer-col a:hover{color:var(--fg)}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:var(--sp-5);border-top:1px solid var(--border);font-family:var(--font-mono);font-size:12px;color:var(--fg-muted);flex-wrap:wrap;gap:16px}
.socials{display:flex;gap:18px}
.socials a{color:var(--fg-muted);transition:color var(--dur) var(--ease)}
.socials a:hover{color:var(--fg)}
.socials svg{width:17px;height:17px;fill:currentColor}

/* ============================================================
   toast + reveal
   ============================================================ */
.toast{position:fixed;left:50%;bottom:32px;transform:translate(-50%,16px);background:var(--fg);color:var(--bg);
  font-family:var(--font-sans);font-size:var(--fs-small);font-weight:500;padding:13px 24px;border-radius:var(--r-pill);
  opacity:0;visibility:hidden;transition:opacity var(--dur) var(--ease),transform var(--dur) var(--ease-out);z-index:300;box-shadow:var(--shadow-md)}
.toast.show{opacity:1;visibility:visible;transform:translate(-50%,0)}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .9s var(--ease-out),transform .9s var(--ease-out)}
.reveal.in{opacity:1;transform:none}
html.js :is(.section-head>*,.witis>div:first-child>*,.handoffs-head>*,.selfhost-grid>div:first-child>*,.contact-cta>*,.flist-item,.feat-row .feat,.hiw-card,.gap2-card,.footer-col,.stat,.hero-inner>*){opacity:0;transform:translateY(24px);transition:opacity 1.05s var(--ease-out),transform 1.05s var(--ease-out)}
html.js :is(.section-head>*,.witis>div:first-child>*,.handoffs-head>*,.selfhost-grid>div:first-child>*,.contact-cta>*,.flist-item,.feat-row .feat,.hiw-card,.gap2-card,.footer-col,.stat,.hero-inner>*).in{opacity:1;transform:none}

/* ============================================================
   responsive
   ============================================================ */
@media(max-width:980px){
  .nav-links{display:none}
  .nav-burger{display:inline-flex}
  .console-body{grid-template-columns:1fr}
  .console-left{border-right:0;border-bottom:1px solid var(--border)}
  .hero-grid{grid-template-columns:minmax(0,1fr);gap:var(--sp-7)}
  .hero-grid .sub{max-width:58ch}
  .witis,.os-wrap,.selfhost-grid,.contact-grid,.ring-wrap,.handoffs-wrap{grid-template-columns:1fr;gap:var(--sp-7)}
  .feat-row{grid-template-columns:1fr;gap:var(--sp-6)}
  .hiw{grid-template-columns:1fr}
  .pv-detail{grid-template-columns:1fr;gap:var(--sp-4)}
  .pv-pills{justify-content:flex-start}
  .pv-flow{grid-template-columns:repeat(2,1fr);gap:var(--sp-6) 0}
  .pv-flow::before{display:none}
  .hiw{gap:var(--sp-3)}
  .footer-grid{grid-template-columns:1fr 1fr;gap:var(--sp-6)}
}
@media(max-width:640px){
  .gap2{grid-template-columns:1fr}
  .stats{grid-template-columns:repeat(2,1fr)}
  .pv-flow{grid-template-columns:repeat(2,1fr);gap:var(--sp-5) 0}
  .pv-flow::before{display:none}
  .field-row{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .hero-bg{opacity:.32}
}
@media(max-width:600px){
  .hero{padding-top:clamp(104px,22vw,140px)}
  /* where-it-fits wheel: keep nodes legible on small screens */
  .rnode{min-width:0;padding:7px 10px;border-radius:11px}
  .rn{font-size:10px}
  .rl{font-size:12px}
  .ring-center{width:46%}
  /* walkthrough scrubber: two per row */
  .sc-seg{flex:1 1 44%;min-width:0;padding:10px 11px}
  .sc-seg .lb{font-size:10.5px}
  /* stats: stack cleanly */
  .stats{grid-template-columns:1fr}
  .pv-flow{gap:var(--sp-5) 0}
}
@media(prefers-reduced-motion:reduce){
  *{animation:none!important}
  html{scroll-behavior:auto}
  .reveal{opacity:1;transform:none;transition:none}
  html.js :is(.section-head>*,.witis>div:first-child>*,.handoffs-head>*,.selfhost-grid>div:first-child>*,.contact-cta>*,.flist-item,.feat-row .feat,.hiw-card,.gap2-card,.footer-col,.stat,.hero-inner>*){opacity:1;transform:none;transition:none}
  html.js .code-block .code-row{opacity:1;transform:none;transition:none}
}
</style>
<script>document.documentElement.classList.add('js')</script>
