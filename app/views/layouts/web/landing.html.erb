  function cell(state,note){var m=state==='y'?Y:state==='p'?P:N;return '<span class="v">'+m+(note?'<span class="note">'+note+'</span>':'')+'</span>';}
  // [capability, [aixle{state,note}], VK, Cond, Devin, Cursor, Copilot, OH, Factory]
  var rows=[
    ['Open source &amp; self-hostable',     ['y',''],         ['p','OSS, sunsetting'],['n',''],         ['n',''],        ['n',''],        ['n',''],        ['y',''],        ['n','']],
    ['Runs in your own infra',              ['y','Docker / K8s'],['y','local worktrees'],['p','local Mac'],['n','cloud'],   ['n','cloud'],   ['n','cloud'],   ['y','self-host'],['p','cloud-first']],
    ['Agent-agnostic runtimes',             ['y','4, swappable'],['y','many'],         ['p','Claude-centric'],['n','Devin'],['n','Cursor'], ['n','Copilot'], ['p','model-flex'],['n','Droid only']],
    ['Kanban board as mission control',     ['y',''],         ['y',''],              ['n','session list'],['n',''],        ['n',''],        ['n',''],        ['n',''],        ['n','']],
    ['Event-driven workflows (DAG)',        ['y','Temporal'], ['n',''],              ['n',''],         ['p','task plans'],['n',''],       ['p','issue→PR'],['p','single-agent'],['p','task runs']],
    ['Automation triggers',                 ['y','unified'],  ['n',''],              ['n',''],         ['p','API/Slack'],['p','API/Slack'],['y','issue assign'],['n',''],     ['p','API']],
    ['Approval &amp; CI gates',             ['y','+ HITL'],   ['n',''],              ['n',''],         ['p','manual'],  ['n',''],        ['p','PR review'],['n',''],        ['n','']],
    ['MCP + governed custom tools',         ['y','scoped'],   ['p','MCP only'],      ['p','MCP only'], ['p','MCP'],     ['p','MCP'],     ['y','MCP'],     ['y','MCP + tools'],['y','MCP']],
    ['Bring-your-own API keys',             ['y',''],         ['y',''],              ['p','BYO keys'], ['n','subscription'],['n','per-seat'],['n','seat license'],['y',''],   ['n','per-seat']],
    ['Durable runs (survive restart)',      ['y','Temporal'], ['n',''],              ['n',''],         ['p','cloud-managed'],['p','cloud'],['p','cloud'],   ['n',''],        ['p','cloud']],
    ['GitHub-native (CI feeds gates)',      ['y','+ GitLab'], ['p','PR push'],       ['p','local git'],['y',''],        ['y',''],        ['y','deep'],    ['y',''],        ['y','']]
  ];
  var html=rows.map(function(r){
    var tds=['<th scope="row">'+r[0]+'</th>'];
    tds.push('<td class="us-col">'+cell(r[1][0],r[1][1])+'</td>');
    for(var i=2;i<r.length;i++) tds.push('<td>'+cell(r[i][0],r[i][1])+'</td>');
    return '<tr>'+tds.join('')+'</tr>';
  }).join('');
  var b=document.getElementById('cmp-body'); if(b) b.innerHTML=html;
})();

/* ---------- what it is: features + graph ---------- */
const FEATS=[
 {n:'01',h:'Assigns every step',p:'It routes each step to the agent or person best suited to it, and keeps shared context attached as the work moves.'},
 {n:'02',h:'Enforces policy',p:'Every action passes a runtime gate. Limits, approvals, and identity are checked before the step runs, not after.'},
 {n:'03',h:'Moves work between them',p:'Handoffs between agents and humans happen automatically, with full state and a complete trace of every decision.'}];
document.getElementById('feats').innerHTML=FEATS.map(f=>`<div class="flist-item"><span class="fn">${f.n}</span><h3>${f.h}</h3><p>${f.p}</p></div>`).join('');
/* ---------- how it works ---------- */
const HIW=[
 {k:'Plan',h:'Design the workflow',p:'Lay out the steps, the agents and people on each one, and the policy that guards them. The design is the contract the runtime enforces.',t:'steps · roles · policy'},
 {k:'Execute',h:'Conduct every run',p:'Flow routes each step, checks policy, and moves work between agents and humans live, holding for approval exactly where you asked it to.',t:'route · check · hand off'},
 {k:'Evolve',h:'Improve every cycle',p:'Every run leaves a full trace. Flow surfaces where time and quality leak, so the next version of the workflow is the obvious one.',t:'trace · evaluate · refine'}];
document.getElementById('hiw').innerHTML=HIW.map(c=>`<div class="hiw-card reveal"><p class="hk">${c.k}</p><h3>${c.h}</h3><p>${c.p}</p><p class="htag">${c.t}</p></div>`).join('');

/* ---------- app screencast demo (how-it-works = interactive, hero = autoplay) ---------- */
function initScDemo(root, interactive){
  if(!root)return;
  const scenes=[...root.querySelectorAll('.sc-scene')];
  const segs=[...root.querySelectorAll('.sc-seg')];
  const navs=[...root.querySelectorAll('.sc-nav')];
  const recT=root.querySelector('#scTime');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NAV={1:'Tasks',2:'Tasks',3:'Assets',4:'Sessions',5:'Overview'};
  const REC={1:'00:06',2:'00:23',3:'00:41',4:'00:58',5:'01:14'};
  const DWELL={1:5000,2:7400,3:4400,4:7000,5:4800};
  let cur=0, timers=[], playing=false;
  const after=(ms,fn)=>{const t=setTimeout(fn,ms);timers.push(t);return t;};
  const clear=()=>{timers.forEach(clearTimeout);timers=[];};
  function flipMove(card,target){
    const first=card.getBoundingClientRect();
    card.classList.add('flying');
    target.prepend(card);
    const last=card.getBoundingClientRect();
    const dx=first.left-last.left, dy=first.top-last.top;
    if(!dx&&!dy){ after(640,()=>card.classList.remove('flying')); return; }
    card.style.transition='none';
    card.style.transform='translate('+dx+'px,'+dy+'px)';
    void card.offsetWidth;                 // force reflow so the start position sticks
    card.style.transition='transform .68s var(--ease)';
    card.style.transform='translate(0,0)';
    after(720,()=>{ card.style.transition=''; card.style.transform=''; card.classList.remove('flying'); });
  }
  const sceneEl=n=>scenes.find(s=>+s.dataset.scene===n);
  // typewriter that reserves the final layout (no line-reflow / jumping)
  const setTyped=(wrap,txt)=>{wrap.querySelector('.tv').textContent=txt;wrap.querySelector('.th').textContent='';const c=wrap.querySelector('.sc-cur');if(c)c.classList.add('hide');};
  function typeInto(wrap,txt,speed,done){
    const tv=wrap.querySelector('.tv'),th=wrap.querySelector('.th'),cur=wrap.querySelector('.sc-cur');
    tv.textContent=''; th.textContent=txt; if(cur)cur.classList.remove('hide');
    let i=0;
    (function t(){ if(i<=txt.length){ tv.textContent=txt.slice(0,i); th.textContent=txt.slice(i); i++; after(speed,t); }
      else{ if(cur)cur.classList.add('hide'); if(done)done(); } })();
  }

  const play={
    1(sc){
      const wrap=sc.querySelector('.sc-typed'), btn=sc.querySelector('.sc-createbtn'), txt='Report June 8';
      btn.classList.remove('pulse');
      if(reduce){setTyped(wrap,txt);btn.classList.add('pulse');return;}
      typeInto(wrap,txt,70,()=>after(560,()=>btn.classList.add('pulse')));
    },
    2(sc){
      const steps=[...sc.querySelectorAll('.sc-wstep')];
      const rows=[...sc.querySelectorAll('.sc-rep-row')];
      const card=sc.querySelector('.sc-move');
      const ip=sc.querySelector('[data-c="ip"]'), dn=sc.querySelector('[data-c="done"]');
      const ipCol=sc.querySelector('[data-col="ip"]'), dnCol=sc.querySelector('[data-col="done"]');
      const tag=sc.querySelector('.sc-runtag');
      steps.forEach(s=>s.className='sc-wstep'); rows.forEach(r=>r.classList.remove('in'));
      card.classList.add('live'); card.classList.remove('flying'); card.style.transform=''; card.style.transition='';
      if(card.parentElement!==ipCol)ipCol.prepend(card);
      ip.textContent='1'; dn.textContent='4'; tag.textContent='running'; tag.className='sc-runtag run';
      if(reduce){steps.forEach(s=>s.className='sc-wstep done');rows.forEach(r=>r.classList.add('in'));tag.textContent='complete';tag.className='sc-runtag ok';dnCol.prepend(card);card.classList.remove('live');ip.textContent='0';dn.textContent='5';return;}
      let i=0;
      (function run(){
        if(i>0)steps[i-1].className='sc-wstep done';
        if(i<steps.length){ steps[i].className='sc-wstep run'; const j=i; if(rows[j])after(360,()=>{if(rows[j])rows[j].classList.add('in');}); i++; after(820,run); }
        else{
          tag.textContent='complete'; tag.className='sc-runtag ok';
          after(700,()=>{ card.classList.remove('live'); ip.textContent='0'; dn.textContent='5'; flipMove(card,dnCol); });
        }
      })();
    },
    3(sc){
      const secs=[...sc.querySelectorAll('.sc-md-sec')];
      secs.forEach(s=>s.classList.remove('in'));
      if(reduce){secs.forEach(s=>s.classList.add('in'));return;}
      secs.forEach((s,i)=>after(150*i+140,()=>s.classList.add('in')));
    },
    4(sc){
      const q=sc.querySelector('.sc-q'), status=sc.querySelector('.sc-status');
      const rows=[...sc.querySelectorAll('.sc-cn-row')], take=sc.querySelector('.sc-take');
      const txt='Show me the top ten countries by traffic.';
      status.classList.remove('in'); rows.forEach(r=>r.classList.remove('in')); take.classList.remove('in');
      if(reduce){setTyped(q,txt);status.classList.add('in');rows.forEach(r=>r.classList.add('in'));take.classList.add('in');return;}
      typeInto(q,txt,48,()=>{
        after(420,()=>{ status.classList.add('in');
          after(1050,()=>{ rows.forEach((r,k)=>after(130*k,()=>r.classList.add('in')));
            after(130*rows.length+450,()=>take.classList.add('in')); }); });
      });
    },
    5(sc){
      const nums=[...sc.querySelectorAll('.sc-stat-n')], acts=[...sc.querySelectorAll('.sc-act')], bars=[...sc.querySelectorAll('.sc-runbar-fill')];
      acts.forEach(a=>a.classList.remove('in')); bars.forEach(b=>b.style.width='0');
      const fmt=(v,dec,pre)=>pre+(dec?v.toFixed(2):Math.round(v).toLocaleString());
      if(reduce){
        nums.forEach(n=>{const dec=n.dataset.val.indexOf('.')>=0;n.textContent=fmt(parseFloat(n.dataset.val),dec,n.dataset.pre||'');});
        acts.forEach(a=>a.classList.add('in')); bars.forEach(b=>b.style.width=b.dataset.w); return;
      }
      nums.forEach(n=>{
        const dec=n.dataset.val.indexOf('.')>=0, pre=n.dataset.pre||'', target=parseFloat(n.dataset.val), S=32; let k=0;
        (function up(){ k++; const v=target*(k/S); n.textContent=fmt(v,dec,pre); if(k<S)after(26,up); else n.textContent=fmt(target,dec,pre); })();
      });
      acts.forEach((a,i)=>after(150*i+220,()=>a.classList.add('in')));
      bars.forEach(b=>after(320,()=>b.style.width=b.dataset.w));
    }
  };

  function show(n){
    clear(); cur=n;
    scenes.forEach(s=>s.classList.toggle('on',+s.dataset.scene===n));
    segs.forEach(s=>{
      const k=+s.dataset.scene, fl=s.querySelector('.fl');
      s.classList.toggle('on',k===n);
      s.classList.toggle('done',k<n);
      if(!fl)return;
      if(k!==n){ fl.style.transition='none'; fl.style.right=(k<n?'0':'100%'); return; }
      // active segment: progress bar fills over this scene's real dwell time
      fl.style.transition='none'; fl.style.right='100%';
      void fl.offsetWidth; // restart the fill from empty
      if(playing&&!reduce){ fl.style.transition='right '+(DWELL[n]||5000)+'ms linear'; fl.style.right='0'; }
      else { fl.style.transition='right .3s var(--ease)'; fl.style.right='0'; }
    });
    navs.forEach(v=>v.classList.toggle('on',v.dataset.nav===NAV[n]));
    if(recT)recT.textContent=REC[n];
    play[n](sceneEl(n));
    if(playing&&!reduce) after(DWELL[n]||5000,()=>show(n%5+1));
  }

  if(interactive){
    segs.forEach(s=>s.addEventListener('click',()=>{ if(!reduce)playing=true; show(+s.dataset.scene); }));
    root.addEventListener('keydown',e=>{
      if(e.key==='ArrowRight'||e.key==='ArrowLeft'){ e.preventDefault(); if(!reduce)playing=true; show(Math.min(5,Math.max(1,cur+(e.key==='ArrowRight'?1:-1)))); }
    });
  }
  show(1);

  // start autoplay once the demo scrolls into view
  if('IntersectionObserver' in window && !reduce){
    let started=false;
    const io=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting&&!started){ started=true; playing=true; show(1); } }),{threshold:.3});
    io.observe(root);
  }
}
initScDemo(document.getElementById('scDemo'), true);   // how it works — clickable chapters + autoplay
initScDemo(document.getElementById('scHero'), false);  // hero — autoplay only, non-interactive

/* ---------- scale the hero walkthrough down to a landscape thumbnail ---------- */
(function(){
  const stage=document.querySelector('.hero-demo .sc-stage');
  const win=stage&&stage.querySelector('.sc-win');
  if(!win)return;
  const designW=1080;
  function fit(){
    const s=Math.min(1, stage.clientWidth/designW);
    win.style.transform='scale('+s+')';
    stage.style.height=(win.offsetHeight*s)+'px';
  }
  fit();
  addEventListener('resize',fit);
  if('ResizeObserver' in window){ new ResizeObserver(fit).observe(stage); }
  // re-fit once fonts/layout settle
  setTimeout(fit,150); addEventListener('load',fit);
})();

/* ---------- where it fits: ring ---------- */
const RING_RAW=[
 {n:'01',label:'Goals',phase:'plan'},{n:'02',label:'Policies',phase:'plan'},{n:'03',label:'Identity',phase:'plan'},{n:'04',label:'Context',phase:'plan'},
 {n:'05',label:'Orchestration',phase:'execute'},{n:'06',label:'Monitoring',phase:'execute'},{n:'07',label:'Compliance',phase:'execute'},
 {n:'08',label:'Evaluation',phase:'evolve'},{n:'09',label:'Escalation',phase:'evolve'},{n:'10',label:'Evolution',phase:'evolve'}];
const RNODES=RING_RAW.map(n=>{const a=(parseInt(n.n,10)-1)*36*Math.PI/180;return{...n,x:50+42*Math.sin(a),y:50-42*Math.cos(a),sx:280+235*Math.sin(a),sy:280-235*Math.cos(a)};});
const PHASES={
 plan:{idx:'01',name:'Plan',range:'01 → 04',items:'Goals · Policies · Identity · Context',desc:'Set the goals, policy, identity, and context every run inherits before any work begins.',lead:'01',center:{pillar:'Pillar 01',name:'Goals',sub:'AIXLE PLANS'}},
 execute:{idx:'02',name:'Execute',range:'05 → 07',items:'Orchestration · Monitoring · Compliance',desc:'Put people, agents, and systems to work together — watched and governed in real time.',lead:'05',center:{pillar:'Pillar 05',name:'Orchestration',sub:'AIXLE ORCHESTRATES'}},
 evolve:{idx:'03',name:'Evolve',range:'08 → 10',items:'Evaluation · Escalation · Evolution',desc:'Read every run back — evaluate the outcome, escalate what needs a human, and evolve the workflow.',lead:'08',center:{pillar:'Pillar 08',name:'Evaluation',sub:'AIXLE EVOLVES'}}};
const order=['plan','execute','evolve'];
let phase='execute';
const ring=document.getElementById('ring'),ringsvg=document.getElementById('ringsvg'),ringcenter=document.getElementById('ringcenter'),phaselist=document.getElementById('phaselist');
// static node divs
RNODES.forEach(n=>{const d=document.createElement('div');d.className='rnode';d.dataset.n=n.n;d.dataset.phase=n.phase;d.style.left=n.x+'%';d.style.top=n.y+'%';d.innerHTML=`<div class="rn">${n.n}</div><div class="rl">${n.label}</div>`;ring.appendChild(d);});
function renderPhaseList(){
  phaselist.innerHTML=order.map(k=>{const ph=PHASES[k];return `<div class="phase ${phase===k?'active':''}" onclick="setPhase('${k}')"><div class="phase-top"><span>Phase ${ph.idx}</span><span>${ph.range}</span></div><h3>${ph.name}</h3><p class="pitems">${ph.items}</p><p class="pdesc">${ph.desc}</p></div>`;}).join('')
   +`<a class="btn btn-primary sprint-btn" href="https://aixle.com" target="_blank" rel="noopener">Explore the Aixle platform <span class="ic"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span></a>`;
}
function setPhase(p){phase=p;renderRing();renderPhaseList();}
function renderRing(){
  const P=PHASES[phase];
  const active=RNODES.filter(n=>n.phase===phase);
  const f=active[0],l=active[active.length-1];
  ringsvg.innerHTML=`<circle cx="280" cy="280" r="235" class="ring-track"/>`
    +active.map(n=>`<line x1="280" y1="280" x2="${n.sx}" y2="${n.sy}" class="ring-conn"/>`).join('')
    +`<path class="ring-arc" d="M ${f.sx} ${f.sy} A 235 235 0 0 1 ${l.sx} ${l.sy}"/>`;
  ring.querySelectorAll('.rnode').forEach(d=>{
    const on=d.dataset.phase===phase;
    d.className='rnode '+(on?(d.dataset.n===P.lead?'lead':'on'):'dim');
  });
  ringcenter.innerHTML=`<div class="rc-pillar">${P.center.pillar}</div><div class="rc-name">${P.center.name}</div><div class="rc-sub">${P.center.sub}</div>`;
}
renderRing();renderPhaseList();

