<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= yield(:title) %> — Aixle</title>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/icon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<%= render "shared/web_fonts" %>
<style>
:root {
  --bg-base: #09090B;
  --bg-surface: #18181B;
  --bg-elevated: #27272A;
  --border-default: #3F3F46;
  --text-primary: #FAFAFA;
  --text-secondary: #A1A1AA;
  --text-muted: #71717A;
  --accent-blue: #3B82F6;
  --font-sans: Inter, "Inter Fallback", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --radius-md: 8px;
  --radius-lg: 12px;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:var(--font-sans);background:var(--bg-base);color:var(--text-primary);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--accent-blue);text-decoration:none}
a:hover{color:#60A5FA}

nav{padding:16px 0;background:rgba(9,9,11,.9);border-bottom:1px solid rgba(63,63,70,.3)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:900px;margin:0 auto;padding:0 24px}
.nav-logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px;color:var(--text-primary);text-decoration:none}
.nav-logo .brand-lockup{display:block;height:24px;width:calc(24px * 354 / 62.5)}
.brand-lockup__flow{fill:#e0582e}
.nav-back{color:var(--text-secondary);font-size:14px;font-weight:500;transition:color .15s ease}
.nav-back:hover{color:var(--text-primary)}

.legal-content{max-width:900px;margin:0 auto;padding:60px 24px 120px}
.legal-content h1{font-size:clamp(28px,4vw,40px);font-weight:700;letter-spacing:-1px;margin-bottom:8px}
.legal-meta{font-size:14px;color:var(--text-muted);margin-bottom:48px}
.legal-content h2{font-size:22px;font-weight:600;margin-top:48px;margin-bottom:16px;letter-spacing:-.3px}
.legal-content h3{font-size:17px;font-weight:600;margin-top:32px;margin-bottom:12px}
.legal-content p{font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:16px}
.legal-content ul,.legal-content ol{margin:12px 0 20px 24px;color:var(--text-secondary);font-size:15px;line-height:1.8}
.legal-content li{margin-bottom:8px}
.legal-content strong{color:var(--text-primary);font-weight:600}
.legal-table{overflow-x:auto;margin:20px 0 28px}
.legal-content table{width:100%;min-width:520px;border-collapse:collapse;font-size:14px;color:var(--text-secondary)}
.legal-content th,.legal-content td{border:1px solid var(--border-default);padding:10px 12px;text-align:left;vertical-align:top;line-height:1.7}
.legal-content th{background:var(--bg-surface);color:var(--text-primary);font-weight:600}
.legal-content .clause{scroll-margin-top:24px}
.legal-content .clause-sub{margin-left:28px}
.legal-content .clause-sub2{margin-left:56px}
.legal-content h2,.legal-content h3{scroll-margin-top:24px}
.legal-note{font-size:14px;font-style:italic}
.legal-toc{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:20px 24px;margin-bottom:40px}
.legal-toc h2{font-size:15px;margin:0 0 10px}
.legal-toc ol{list-style:none;margin:0;columns:2;column-gap:32px;font-size:14px}
.legal-toc li{margin-bottom:4px;break-inside:avoid}
.legal-documents{list-style:none;margin:0 0 24px!important;display:grid;gap:16px}
.legal-documents li{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:20px 24px;margin:0}
.legal-documents h2{margin:0 0 6px;font-size:19px}
.legal-documents p{margin:0 0 6px}

footer{border-top:1px solid rgba(63,63,70,.3);padding:40px 0;text-align:center}
.footer-inner{max-width:900px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--text-muted)}
.footer-links{display:flex;gap:20px}
.footer-links a{color:var(--text-muted);transition:color .15s ease}
.footer-links a:hover{color:var(--text-primary)}

@media(max-width:640px){
  .legal-content{padding:40px 16px 80px}
  .legal-content h1{font-size:28px}
  .legal-content .clause-sub{margin-left:16px}
  .legal-content .clause-sub2{margin-left:32px}
  .legal-toc ol{columns:1}
  .footer-inner{flex-direction:column;gap:12px}
}
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <%= render "shared/brand_lockup" %>
    </a>
    <a href="/" class="nav-back">&larr; Back to home</a>
  </div>
</nav>

<div class="legal-content">
  <%= yield %>
</div>

<footer>
  <div class="footer-inner">
    <span>&copy; <%= Date.current.year %> Dualboot Partners, LLC. All rights reserved.</span>
    <div class="footer-links">
      <%= link_to "Legal", legal_path %>
      <%= link_to "Privacy", legal_privacy_policy_path %>
      <%= link_to "Terms of Service", legal_terms_of_service_path %>
      <%= link_to "Terms of Use", legal_terms_of_use_path %>
    </div>
  </div>
</footer>

</body>
</html>
