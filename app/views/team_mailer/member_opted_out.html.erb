<!-- Preheader (hidden preview text) -->
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
  <%= @member.name %> asked to stay out of teams.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
</div>

<!-- Card -->
<tr>
  <td style="background-color:#121110; border:1px solid #292726; border-radius:8px; padding:44px 44px 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

      <!-- Heading -->
      <tr>
        <td role="heading" aria-level="1" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:20px; line-height:28px; font-weight:600; letter-spacing:-0.01em; color:#d1cfcd; padding-bottom:16px;">
          <%= @member.name %> left the teams of <%= @project.name %>
        </td>
      </tr>

      <!-- Body -->
      <tr>
        <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:14px; line-height:22px; color:#9f9d9c; padding-bottom:28px;">
          <strong style="color:#d1cfcd; font-weight:600;"><%= @member.name %></strong> turned on "Don't let anyone add me to a team", which took them out of <%= @teams.map { |team| team.name }.to_sentence %>. Runs of <%= @teams.one? ? "that team" : "those teams" %> no longer go to them.
        </td>
      </tr>

      <tr>
        <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:12px; line-height:18px; color:#5d5b5a; border-top:1px solid #292726; padding-top:24px;">
          Check that every team still has someone who can take its runs: <a href="<%= @teams_url %>" style="color:#9f9d9c;">the project's teams</a>.
        </td>
      </tr>

    </table>
  </td>
</tr>
