<%#
# User Show

Customises Administrate's stock show page for users by adding an
Impersonate / Stop Impersonate action to the header.

Administrate 1.0 exposes `content_for` slots in its page templates
(`:header_middle`, `:header_last`, `:before_main`, `:after_main`), so we inject
our action into one of those slots and render the gem's template instead of
copying the whole page. This keeps us in sync with future Administrate updates.
%>

<% content_for(:header_last) do %>
  <% unless page.resource.super_admin? %>
    <% if impersonated? && current_user.id == page.resource.id %>
      <%= button_to(
        t("administrate.actions.stop_impersonate"),
        stop_impersonate_admin_user_path(page.resource),
        method: :post,
        class: "button button--danger"
      ) %>
    <% elsif !impersonated? && current_user.id != page.resource.id %>
      <%= button_to(
        t("administrate.actions.impersonate"),
        impersonate_admin_user_path(page.resource),
        method: :post,
        class: "button"
      ) %>
    <% end %>
  <% end %>
<% end %>

<%# `page` is passed to the show view as a local (namespace/resource_name are helpers), so forward it. %>
<%= render template: "administrate/application/show", locals: { page: page } %>
