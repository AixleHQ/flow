<%#
# Session admission

Capacity is not edited here. A company's limit is set on the company's own page
and a project's on the project's; the scope default comes from the deployment's
environment. This page reports what they resolve to.
%>

<header class="main-content__header">
  <h1 class="main-content__page-title">Session admission</h1>
</header>

<section class="main-content__body">
  <table>
    <tbody>
      <tr>
        <th>Queues</th>
        <td>
          One queue per project (<%= @scope_defaults["Project"] %> each unless the project sets its own).
          Explicit project limits are reservations drawn from the company that owns the project;
          a company with no limit of its own is unbounded, and unbilled.
          Sessions launched outside a project (agent logins) queue per user, <%= SessionAdmissionService::AUTH_POOL_LIMIT %> at a time, outside any company's limit.
        </td>
      </tr>
      <tr>
        <th>Company limits</th>
        <td>
          <% if @company_limits.any? %>
            <% @company_limits.each do |limit| %>
              <%= link_to limit.scope_record&.name || "Company ##{limit.scope_id}",
                          admin_company_path(limit.scope_id) %>: <%= limit.max_sessions %><br>
            <% end %>
          <% else %>
            none — every company is unbounded and unbilled. Set one on a company's own page.
          <% end %>
          <% @overcommitted.each do |row| %>
            <strong><%= @company_names[row[:company_id]] || "Company ##{row[:company_id]}" %> has
            <%= row[:reserved] %> reserved by its projects, above its limit of <%= row[:limit] %>.</strong>
            The company limit is honoured and those reservations are not.<br>
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Project reservations</th>
        <td>
          <% if @overrides.any? %>
            <%= @overrides.map { |limit| "##{limit.scope_id}: #{limit.max_sessions}" }.join(", ") %>
            (<%= link_to "edit", admin_session_concurrency_limits_path %>)
          <% else %>
            none — <%= link_to "add one", admin_session_concurrency_limits_path %>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <h2>Queue health</h2>
  <table>
    <tbody>
      <% @health.each do |key, value| %>
        <tr>
          <th><%= key.to_s.humanize %></th>
          <td><%= value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
