<%
  font = "font-family:#{email_font};"
%>
<!-- Preheader (hidden preview text) -->
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
  Confirm the address to put your request to the workspace's administrators.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
</div>

<!-- Card -->
<tr>
  <td style="background-color:#121110; border:1px solid #292726; border-radius:8px; padding:44px 44px 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

      <!-- Heading -->
      <tr>
        <td role="heading" aria-level="1" style="<%= font %> font-size:20px; line-height:28px; font-weight:600; letter-spacing:-0.01em; color:#d1cfcd; padding-bottom:16px;">
          Confirm your AWS Marketplace request
        </td>
      </tr>

      <!-- Body -->
      <tr>
        <td style="<%= font %> font-size:14px; line-height:22px; color:#9f9d9c; padding-bottom:28px;">
          Someone bought an AWS Marketplace subscription to Aixle Flow and asked for it to be
          applied to the workspace that already uses this email domain. The link below opens a
          page where confirming proves that the address is yours and puts the request to that
          workspace's administrators. The link expires in <strong style="color:#d1cfcd; font-weight:600;"><%= @ttl_hours %> hours</strong>.
        </td>
      </tr>

      <!-- CTA -->
      <tr>
        <td style="padding-bottom:32px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td bgcolor="#cf6b4a" style="background-color:#cf6b4a; border-radius:5px;">
                <a href="<%= @url %>" target="_blank" role="button" aria-label="Confirm the request"
                   style="display:inline-block; padding:11px 24px; <%= font %> font-size:14px; font-weight:600; line-height:20px; color:#0a0908; text-decoration:none; border-radius:5px;">
                  Confirm the request
                </a>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td style="<%= font %> font-size:12px; line-height:18px; color:#5d5b5a; border-top:1px solid #292726; padding-top:24px;">
          Nobody has been asked anything yet, and nobody will be until you confirm. If that was
          not you, ignore this message — and nothing about your workspace changes.
        </td>
      </tr>

    </table>
  </td>
</tr>
