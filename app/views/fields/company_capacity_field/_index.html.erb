<% if field.unbilled? %>
  <span title="No limit: this company is unbounded and nothing is invoiced for it"
        style="display:inline-block;padding:1px 8px;border-radius:999px;font-size:11px;font-weight:600;
               color:var(--app-warning-fg);background:var(--app-warning-bg);border:1px solid var(--app-warning-border);">
    No limit — unbilled
  </span>
<% elsif field.unlimited? %>
  <span style="opacity:.6">No limit</span>
<% else %>
  <%= field.limit %>
<% end %>
