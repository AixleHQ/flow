<%#
# Javascript

Administrate's own scripts, then the admin's (app/frontend/entrypoints/admin.ts:
the light/dark switch) on every admin page. A page adds its own through
`content_for(:javascript)`.

Administrate bundles the CSS anchor positioning polyfill, which runs in every
browser and swaps the <link> to Administrate's stylesheet for a blob: copy. On
the next Turbo visit the head no longer matches, so Turbo appends the original
after the skin and Administrate's `[type=text] { background-color: #fff }`
wins again. `elements: []` leaves stylesheets alone; the one thing it
positions, the search hint popover, has native support in current browsers.
%>

<%= javascript_tag nonce: true do %>
  window.ANCHOR_POSITIONING_POLYFILL_OPTIONS = { elements: [] };
<% end %>

<% Administrate::Engine.javascripts.each do |js_path| %>
  <%= javascript_include_tag js_path, "data-turbo-track": "reload", defer: true %>
<% end %>

<%= vite_client_tag %>
<%= vite_javascript_tag "admin.ts" %>

<%= yield :javascript %>

<% if Rails.env.test? %>
  <%= javascript_tag do %>
    $.fx.off = true;
    $.ajaxSetup({ async: false });
  <% end %>
<% end %>
