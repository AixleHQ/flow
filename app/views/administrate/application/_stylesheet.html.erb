<%#
# Stylesheet

Administrate's own stylesheets, then the Aixle Flow skin over them
(app/frontend/entrypoints/admin.css) and the brand fonts, on every admin page.
A page adds its own through `content_for(:stylesheet)`.
%>

<% Administrate::Engine.stylesheets.each do |css_path| %>
  <%= stylesheet_link_tag css_path %>
<% end %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600&family=Figtree:wght@400;500;600&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">
<%= vite_stylesheet_tag "admin.css" %>

<%= yield :stylesheet %>
