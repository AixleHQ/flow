#!/usr/bin/env bash

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

DOCKER_COMPOSE="${DOCKER_COMPOSE:-docker compose}"
fail=0
warn=0

ok() { echo "[OK]   $1"; }
fail_msg() { echo "[FAIL] $1"; fail=1; }
warn_msg() { echo "[WARN] $1"; warn=1; }

echo "=== Aixle dev doctor ==="
echo ""

echo "-- Tooling --"
if docker info >/dev/null 2>&1; then
  ok "Docker daemon running"
else
  fail_msg "Docker daemon not running"
fi

if $DOCKER_COMPOSE version >/dev/null 2>&1; then
  ok "docker compose available"
else
  fail_msg "docker compose not available"
fi

echo ""
echo "-- Environment files --"
if [ -f .env.development ]; then
  ok ".env.development exists"
else
  warn_msg ".env.development missing (make setup creates it)"
fi

if [ -f test/playwright/helpers/.env ]; then
  ok "Playwright .env exists"
else
  warn_msg "test/playwright/helpers/.env missing (make setup creates it)"
fi

echo ""
echo "-- Dependencies --"
if [ -d node_modules ] && [ -n "$(ls -A node_modules 2>/dev/null)" ]; then
  ok "node_modules present"
else
  warn_msg "node_modules missing or empty — run make setup"
fi

if docker volume ls -q 2>/dev/null | grep -q bundle_cache; then
  ok "bundle_cache volume exists"
else
  warn_msg "bundle_cache volume not found — run make setup"
fi

if [ -f tmp/bootstrap.stamp ]; then
  ok "bootstrap stamp present ($(cat tmp/bootstrap.stamp | cut -c1-8)...)"
else
  warn_msg "bootstrap stamp missing — deps will install on next make up"
fi

echo ""
echo "-- Services --"
if ! docker info >/dev/null 2>&1; then
  echo "(skipped — Docker not running)"
else
  running=$($DOCKER_COMPOSE ps --status running -q 2>/dev/null | wc -l | tr -d ' ')
  if [ "$running" -gt 0 ]; then
    ok "$running container(s) running"
    $DOCKER_COMPOSE ps --format 'table {{.Name}}\t{{.Status}}' 2>/dev/null || $DOCKER_COMPOSE ps
  else
    warn_msg "No containers running — run make up"
  fi

  echo ""
  echo "-- Health --"
  if curl -sf http://localhost:4000/up >/dev/null 2>&1; then
    ok "Web responding at http://localhost:4000/up"
  else
    warn_msg "Web not responding at http://localhost:4000/up"
  fi

  if curl -sf http://localhost:8080 >/dev/null 2>&1; then
    ok "Temporal UI at http://localhost:8080"
  else
    warn_msg "Temporal UI not responding at http://localhost:8080"
  fi
fi

echo ""
echo "-- Env placeholders --"
bin/check-env 2>/dev/null | tail -n +2 || true

echo ""
if [ "$fail" -gt 0 ]; then
  echo "Doctor finished with failures."
  exit 1
fi

if [ "$warn" -gt 0 ]; then
  echo "Doctor finished with warnings."
else
  echo "Doctor finished — all checks passed."
fi

exit 0
