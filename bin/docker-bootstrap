#!/usr/bin/env bash
set -e

MODE="${1:-check}"
STAMP_FILE="tmp/bootstrap.stamp"

stamp_hash() {
  cat Gemfile.lock yarn.lock | sha256sum | awk '{print $1}'
}

update_stamp() {
  mkdir -p tmp
  stamp_hash > "$STAMP_FILE"
}

deps_current() {
  [ -f "$STAMP_FILE" ] && [ "$(stamp_hash)" = "$(cat "$STAMP_FILE")" ]
}

install_ruby_deps() {
  if [ "$MODE" = "install" ]; then
    bundle install
  else
    bundle check || bundle install
  fi
}

install_js_deps() {
  if [ "$MODE" = "install" ]; then
    yarn install
  elif yarn install --immutable 2>/dev/null; then
    :
  else
    yarn install
  fi
}

if [ "$MODE" = "check" ] && deps_current; then
  echo "Dependencies up to date (lockfiles unchanged), skipping bundle/yarn"
else
  install_ruby_deps
  install_js_deps
  update_stamp
fi

if [ -n "${DB_HOST:-}" ]; then
  until pg_isready -h "$DB_HOST" -U "${DB_USERNAME:-postgres}" >/dev/null 2>&1; do
    sleep 1
  done
fi

bundle exec rails db:prepare
