#!/usr/bin/env ruby

# Start Ruby Temporal worker

require_relative "../config/environment"

if Settings.sentry.temporal_dsn.present? && !Rails.env.development?
  Sentry.init do |config|
    config.dsn = Settings.sentry.temporal_dsn
    config.release = Settings.app.version
    config.environment = Rails.env
    config.send_default_pii = true
    config.enable_logs = true
    config.traces_sample_rate = 1.0
    config.profiles_sample_rate = 1.0
  end
end

logger = Logger.new($stdout)
TemporalWorkflowRegistry.workflows_data

begin
  logger.info("Ruby worker - registered workflows: [#{TemporalService.workflows.map{|wf| wf.new.name }.join(', ')}]")
  logger.info("Ruby worker - registered activities: [#{TemporalService.activities.map{|act| act.new.name }.join(', ')}]")

  logger.info("Ruby worker - start syncing schedules")
  TemporalService.sync_schedules
  logger.info("Ruby worker - schedules synced")

  logger.info("Ruby worker - listening for tasks")
  TemporalService.worker.run(shutdown_signals: ['SIGINT', 'SIGTERM'])
rescue Interrupt
  logger.info("Ruby worker - interrupted")
  exit 0
rescue StandardError => e
  logger.error("Ruby worker - fatal error: #{e.message}")
  logger.error(e.backtrace.join("\n"))
  Sentry.capture_exception(e, tags: { component: "temporal_worker" })
  exit 1
end

