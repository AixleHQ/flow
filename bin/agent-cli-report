#!/usr/bin/env bash
# Compares every CLI pin in config/agent_runtimes.json with the vendor's newest release
# and prints a Markdown report: one table, then the vendor's release notes for each
# release between the pin and the newest. The weekly canary posts it as an issue; run it
# locally to see the same thing. Needs jq, curl and an authenticated gh.
#
# Optional environment: SHIPPED_DIR (one file per image holding the version the canary
# built), RUN_ID with GITHUB_REPOSITORY (adds each canary build's result), TITLE_TAG.
set -euo pipefail
cd "$(dirname "$0")/.."

# One runtime's notes must not crowd out the rest of an issue body.
chars_per_runtime=8000
lines_per_release=30

# True when $1 is a strictly later version than $2.
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

newest_version() {
  local runtime="$1" repo prefix tag
  repo="$(jq -r '.cli_releases.github // empty' <<<"$runtime")"
  prefix="$(jq -r '.cli_releases.tag_prefix // empty' <<<"$runtime")"
  if [ "$(jq -r '.cli_latest != null' <<<"$runtime")" = "true" ]; then
    bin/agent-cli-latest "$(jq -r .id <<<"$runtime")"
  elif [ -n "$repo" ]; then
    tag="$(gh api "repos/${repo}/releases/latest" --jq .tag_name)"
    echo "${tag#"$prefix"}"
  fi
}

builds=""
if [ -n "${RUN_ID:-}" ]; then
  builds="$(gh api "repos/${GITHUB_REPOSITORY}/actions/runs/${RUN_ID}/jobs" --paginate \
    --jq '.jobs[] | [.name, (.conclusion // "running")] | @tsv')"
fi

table=""
notes=""
outdated=0
while IFS= read -r runtime; do
  label="$(jq -r .label <<<"$runtime")"
  image="$(jq -r .image <<<"$runtime")"
  pin="$(jq -r '.cli_version // empty' <<<"$runtime")"
  newest="$(newest_version "$runtime" || true)"

  shipped="—"
  [ -n "${SHIPPED_DIR:-}" ] && [ -f "${SHIPPED_DIR}/${image}" ] && shipped="\`$(head -1 "${SHIPPED_DIR}/${image}")\`"
  build="—"
  if [ -n "$builds" ]; then
    case "$(awk -F'\t' -v name="Build ${label}" '$1 == name { print $2 }' <<<"$builds")" in
      success) build="✅" ;;
      "") build="—" ;;
      *) build="❌" ;;
    esac
  fi

  if [ -z "$pin" ]; then
    table+="| ${label} | unpinned (vendor newest) | — | ${shipped} | ${build} |"$'\n'
    continue
  fi
  if [ -z "$newest" ]; then
    table+="| ${label} | \`${pin}\` | unknown | ${shipped} | ${build} |"$'\n'
    continue
  fi
  if ! newer "$newest" "$pin"; then
    table+="| ${label} | \`${pin}\` | \`${newest}\` ✓ | ${shipped} | ${build} |"$'\n'
    continue
  fi

  outdated=$((outdated + 1))
  table+="| **${label}** | \`${pin}\` | **\`${newest}\`** ⬆ | ${shipped} | ${build} |"$'\n'

  repo="$(jq -r '.cli_releases.github // empty' <<<"$runtime")"
  prefix="$(jq -r '.cli_releases.tag_prefix // empty' <<<"$runtime")"
  npm="$(jq -r '.cli_latest.npm // empty' <<<"$runtime")"
  changelog="$(jq -r '.cli_releases.url // empty' <<<"$runtime")"
  notes+=$'\n'"### ${label}: \`${pin}\` → \`${newest}\`"$'\n\n'
  if [ -z "$repo" ]; then
    if [ -n "$changelog" ]; then
      notes+="Release notes: ${changelog}"$'\n'
    else
      notes+="No release notes source; versions: https://www.npmjs.com/package/${npm}?activeTab=versions"$'\n'
    fi
    continue
  fi

  runtime_notes=""
  while IFS=$'\t' read -r tag url body; do
    version="${tag#"$prefix"}"
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    newer "$version" "$pin" || continue
    newer "$version" "$newest" && continue
    text="$(base64 -d <<<"$body" | tr -d '\r' | awk -v n="$lines_per_release" 'NR <= n')"
    block="<details><summary><a href=\"${url}\">${tag}</a></summary>"$'\n\n'"${text}"$'\n\n'"</details>"$'\n'
    if [ $(( ${#runtime_notes} + ${#block} )) -gt "$chars_per_runtime" ]; then
      runtime_notes+="Older releases: https://github.com/${repo}/releases"$'\n'
      break
    fi
    runtime_notes+="$block"
  done < <(gh api "repos/${repo}/releases?per_page=100" \
    --jq '.[] | select((.draft or .prerelease) | not) | [.tag_name, .html_url, ((.body // "") | @base64)] | @tsv')
  notes+="$runtime_notes"
done < <(jq -c '.runtimes[]' config/agent_runtimes.json)

report="$(
  echo "<!-- outdated: ${outdated} -->"
  echo "## Agent CLI pins${TITLE_TAG:+ — ${TITLE_TAG}}"
  echo
  echo "Each pin in \`config/agent_runtimes.json\` against the vendor's newest release, and what the"
  echo "canary built. Raise a pin by editing \`cli_version\` (docs/architecture/agent-runtime-registry.md);"
  echo "a green canary build says the newest release builds."
  echo
  echo "| Runtime | Pinned | Newest | Canary built | Canary build |"
  echo "| --- | --- | --- | --- | --- |"
  printf '%s' "$table"
  printf '%s' "$notes"
)"
# GitHub caps an issue body at 65,536 characters.
printf '%s\n' "${report:0:60000}"
