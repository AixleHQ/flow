#!/usr/bin/env bash
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

copy_if_missing() {
  local target="$1"
  local source="$2"
  local label="$3"

  if [ ! -f "$target" ] && [ -f "$source" ]; then
    cp "$source" "$target"
    echo "Created $label from $(basename "$source")"
  fi
}

copy_if_missing ".env.development" ".env.example" ".env.development"
copy_if_missing "test/playwright/helpers/.env" "test/playwright/helpers/.env.example" "test/playwright/helpers/.env"
