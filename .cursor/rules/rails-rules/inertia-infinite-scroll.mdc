# Inertia Infinite Scroll / Pagination

Server-side pagination via `PaginationConcern` + `InertiaRails.scroll`, client-side rendering via `<InfiniteScroll>`.

## Stack

| Layer | Tool |
|-------|------|
| Pagination | `PaginationConcern` (wraps Pagy 9.x) — included in `Web::ApplicationController` and `Api::V1::ApplicationController` |
| Filtering | Ransack via `q_params` — see `ransack-filtering` rule |
| Server prop | `inertia_scroll(scope) { \|records\| ... }` from `PaginationConcern` |
| Client component | `<InfiniteScroll>` from `@inertiajs/react` |

## Controller Pattern

`PaginationConcern` is already included at `Web::ApplicationController` — no need to include anything. Use `inertia_scroll` which wraps `pagy` + `InertiaRails.scroll`:

```ruby
def index
  scope = Post.includes(:author)
              .ransack(q_params)
              .result
              .order(created_at: :desc)

  render inertia: "Posts/Index", props: {
    posts: inertia_scroll(scope) { |records|
      records.map { |p| PostResource.new(p).to_h }
    },
    filters: q_params,
  }
end
```

**`inertia_scroll(scope, limit: 20) { |records| ... }`** — paginates with Pagy, wraps in `InertiaRails.scroll`. Default limit is 20.

**Key points:**
- Ransack handles filtering — see `ransack-filtering` rule for predicates
- `q_params` returns `params[:q] || {}` (defined in `ApplicationController`)
- Pass `filters: q_params` back so frontend controls reflect current state

## Frontend Pattern

```tsx
import { InfiniteScroll } from '@inertiajs/react'

export default function Index({ posts }: Props) {
  return (
    <InfiniteScroll data="posts" loading={() => <LoadingSkeleton />}>
      {posts.map(post => <PostCard key={post.id} post={post} />)}
    </InfiniteScroll>
  )
}
```

### `<InfiniteScroll>` Props

| Prop | Type | Default | Behavior |
|------|------|---------|----------|
| `data` | `string` | required | Prop name to paginate |
| `loading` | `() => ReactNode` | — | Fallback while loading next page |
| `manual` | `boolean` | `false` | Show "Load more" button instead of auto-scroll |
| `manualAfter` | `number` | — | Auto-scroll first N pages, then manual button |
| `preserveUrl` | `boolean` | `false` | Don't update URL with page params |
| `next` | `(ctx) => ReactNode` | — | Custom render for manual trigger: `{ loading, fetch, hasMore }` |

## Resetting on Filter/Search Change

Use `router.get` with Ransack `q` params — full navigation resets scroll state automatically:

```tsx
const onFilterChange = (key: string, value: string | null) => {
  const q = { ...filters };
  if (value) {
    q[key] = value;
  } else {
    delete q[key];
  }
  router.get(currentUrl, { q }, { preserveState: true, preserveScroll: true });
};
```

**Rule:** Any filter/sort/search change via `router.get` resets the scroll prop automatically — no manual `reset` needed.

## JSON API Pagination

For non-Inertia JSON endpoints, use `paginate` + `PaginatedResource`:

```ruby
pagy, records = paginate(scope)
render json: PaginatedResource.build(pagy, records) { |r| SomeResource.new(r).to_h }
```

## Anti-Patterns

```ruby
# ❌ Hard limit instead of pagination
sessions = Session.order(created_at: :desc).limit(200)

# ✅ inertia_scroll
sessions: inertia_scroll(scope) { |r| r.map { ... } }

# ❌ Manual where chains for filtering
scope = scope.where(state: params[:state]) if params[:state].present?

# ✅ Ransack
scope = Model.ransack(q_params).result

# ❌ include Pagy::Backend in individual controllers
include Pagy::Backend

# ✅ PaginationConcern is already included at Web::ApplicationController
```

## Combining with Other Prop Types

Wrap non-scroll Hash/Array props in lambdas (see `inertia-drawer-data-pattern` rule):

```ruby
render inertia: "Page", props: {
  project: -> { ProjectResource.new(project).to_h },
  sessions: inertia_scroll(scope) { |r| r.map { |s| SessionResource.new(s).to_h } },
  stats: InertiaRails.defer { expensive_stats },
}
```
