#!/bin/bash
# Git credential helper for GitHub and GitLab repositories attached to a session.
#
# Same contract as git-credential-aixle-azure: git writes `protocol=`, `host=`,
# `path=` … then a blank line, and expects `username=`/`password=` back for `get`.
# Nothing else may reach stdout.
#
# The token never lands anywhere git can persist it — `store` and `erase` are
# no-ops and nothing goes into .git/config or the remote URL. Each `get` asks the
# platform for a fresh, short-lived credential narrowed to the one repository, so
# a long session outlives the hour a GitHub installation token lasts.
#
# Which repository this is for comes from configuration written at clone time
# (`credential.<url>.aixleRepositoryId`), never from the URL, so a rewritten
# remote cannot ask for another repository's credential; the platform also checks
# the URL against the repository it names.
set -euo pipefail

ACTION="${1:-}"
if [ "$ACTION" != "get" ]; then
  cat >/dev/null || true
  exit 0
fi

: "${AIXLE_GIT_CREDENTIALS_URL:?not set — this session has no GitHub or GitLab repositories}"
: "${AIXLE_GIT_KEY:?not set — this session has no GitHub or GitLab repositories}"
: "${SESSION_ID:?not set}"

protocol=""; host=""; path=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    protocol) protocol="$value" ;;
    host)     host="$value" ;;
    path)     path="$value" ;;
  esac
done

[ "$protocol" = "https" ] || exit 0

REPO_ID="$(git config --get "credential.https://${host}/${path}.aixleRepositoryId" 2>/dev/null || true)"
if [ -z "$REPO_ID" ]; then
  REPO_ID="$(git config --get-urlmatch credential.aixleRepositoryId "https://${host}/${path}" 2>/dev/null || true)"
fi
[ -n "$REPO_ID" ] || exit 0

body="$(curl -fsS --max-time 20 -X POST \
  -H "X-Session-Id: ${SESSION_ID}" \
  -H "X-Git-Key: ${AIXLE_GIT_KEY}" \
  -H "Content-Type: application/json" \
  --data "$(printf '{"repository_id":"%s","url":"https://%s/%s"}' "$REPO_ID" "$host" "$path")" \
  "${AIXLE_GIT_CREDENTIALS_URL}")" || exit 0

if command -v jq >/dev/null 2>&1; then
  username="$(printf '%s' "$body" | jq -r '.username // ""')"
  password="$(printf '%s' "$body" | jq -r '.password // empty')"
else
  username="$(printf '%s' "$body" | sed -n 's/.*"username":"\([^"]*\)".*/\1/p')"
  password="$(printf '%s' "$body" | sed -n 's/.*"password":"\([^"]*\)".*/\1/p')"
fi
[ -n "${password:-}" ] || exit 0

printf 'username=%s\n' "${username:-x-access-token}"
printf 'password=%s\n' "$password"
