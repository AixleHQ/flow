{
  "security.workspace.trust.enabled": false,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "window.restoreWindows": "none",
  "files.hotExit": "off",
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "workbench.tips.enabled": false,
  "workbench.statusBar.visible": false,
  "workbench.activityBar.location": "hidden",
  "workbench.layoutControl.enabled": false,
  "telemetry.telemetryLevel": "off",
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "breadcrumbs.enabled": false,
  "explorer.openEditors.visible": 0,
  "timeline.enabled": false,
  "extensions.ignoreRecommendations": true,
  "terminal.integrated.fontSize": 13,
  "chat.enabled": false,
  "chat.disableAIFeatures": true,
  "window.commandCenter": false,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.claude/**": true,
    "**/tmp/**": true,
    "**/cache/**": true,
    "**/.openvscode-server/**": true
  },
  "files.exclude": {
    "**/.*/**": true,
    "**/.DS_Store": true,
    "**/CLAUDE.md": true,
    "**/CLAUDE.local.md": true,
    "**/OPENAI.md": true,
    "**/AGENTS.md": true,
    "**/GEMINI.md": true
  },
  "workbench.colorCustomizations": {
    "editor.background": "#0D0D0D",
    "editorWidget.background": "#101010",
    "sideBar.background": "#1e1e1e",
    "sideBar.foreground": "#D4D4D8",
    "sideBarTitle.foreground": "#D4D4D8",
    "sideBarSectionHeader.background": "#252525",
    "activityBar.background": "#1e1e1e",
    "activityBar.foreground": "#D4D4D8",
    "titleBar.activeBackground": "#1e1e1e",
    "titleBar.activeForeground": "#D4D4D8",
    "titleBar.inactiveBackground": "#1e1e1e",
    "panel.background": "#0D0D0D",
    "panel.border": "#3F3F46",
    "terminal.background": "#000000",
    "terminal.foreground": "#D4D4D8",
    "tab.activeBackground": "#1A1A1A",
    "tab.activeForeground": "#D4D4D8",
    "tab.inactiveBackground": "#0D0D0D",
    "tab.inactiveForeground": "#A1A1AA",
    "tab.border": "#1e1e1e",
    "editorGroupHeader.tabsBackground": "#1e1e1e",
    "statusBar.background": "#1e1e1e",
    "statusBar.foreground": "#A1A1AA",
    "statusBar.noFolderBackground": "#1e1e1e",
    "focusBorder": "#3B82F6",
    "button.background": "#3B82F6",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#2563EB",
    "list.activeSelectionBackground": "#3B82F633",
    "list.activeSelectionForeground": "#D4D4D8",
    "list.hoverBackground": "#FFFFFF14",
    "list.focusOutline": "#3B82F6",
    "input.background": "#101010",
    "input.border": "#3F3F46",
    "input.foreground": "#D4D4D8",
    "dropdown.background": "#101010",
    "dropdown.border": "#3F3F46",
    "editor.lineHighlightBackground": "#1A1A1A",
    "editor.selectionBackground": "#3B82F633",
    "editorCursor.foreground": "#3B82F6",
    "scrollbarSlider.background": "#27272A80",
    "scrollbarSlider.hoverBackground": "#3F3F46"
  }
}