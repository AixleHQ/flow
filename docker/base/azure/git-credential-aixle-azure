#!/bin/bash
# Git credential helper for Azure DevOps repositories.
#
# Git speaks a line-oriented protocol on stdin/stdout: it writes `protocol=`,
# `host=`, `path=` … then a blank line, and expects `username=`/`password=` back
# for `get`. Nothing else may reach stdout — a stray echo is parsed as a
# credential field and breaks authentication with no useful error.
#
# The token never lands anywhere Git can persist it: `store` is a deliberate
# no-op, `erase` only clears this process's view, and nothing is written to
# .git/config or the remote URL. That is the difference from the GitHub and
# GitLab clone path, which embeds a token in the remote and leaves it in the
# checkout.
#
# Authentication to the platform is a DERIVED per-session key, not the session's
# mcp_key — see app/services/azure_devops/git_session_key.rb for why.
#
# Which repository this is asking for comes from configuration, not from the
# URL: git config sets `credential.<url>.aixleRepositoryId` per repository, so a
# rewritten remote cannot ask for another repository's credentials.
set -euo pipefail

ACTION="${1:-}"

# store: accepted and discarded. Returning an error here makes Git report a
# failure after a perfectly good fetch; persisting would defeat the point.
# erase: the credential is per-process and short-lived, so there is nothing to
# remove. Both read their stdin so Git never blocks writing to a closed pipe.
if [ "$ACTION" != "get" ]; then
  cat >/dev/null || true
  exit 0
fi

: "${AIXLE_AZURE_GIT_URL:?not set — this session has no Azure DevOps repositories}"
: "${AIXLE_AZURE_GIT_KEY:?not set — this session has no Azure DevOps repositories}"
: "${SESSION_ID:?not set}"

# Read Git's request. Only the fields we act on are kept.
protocol=""; host=""; path=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    protocol) protocol="$value" ;;
    host)     host="$value" ;;
    path)     path="$value" ;;
  esac
done

# Refuse to answer for anything but https on the Azure host. Without this the
# helper would hand an Azure token to whatever host Git happened to be talking
# to, including after a redirect.
if [ "$protocol" != "https" ] || [ "${host%%:*}" != "dev.azure.com" ]; then
  exit 0
fi

# The local repository id, written into the repository's own git config at
# provisioning time. `git config` is read with the repository's URL context so
# the right entry is selected when a session holds several Azure repositories.
REPO_ID="${AIXLE_AZURE_REPOSITORY_ID:-}"
if [ -z "$REPO_ID" ]; then
  REPO_ID="$(git config --get "credential.https://${host}/${path}.aixleRepositoryId" 2>/dev/null || true)"
fi
if [ -z "$REPO_ID" ]; then
  REPO_ID="$(git config --get-urlmatch credential.aixleRepositoryId "https://${host}/${path}" 2>/dev/null || true)"
fi
[ -n "$REPO_ID" ] || exit 0

body="$(curl -fsS --max-time 20 -X POST \
  -H "X-Session-Id: ${SESSION_ID}" \
  -H "X-Azure-Git-Key: ${AIXLE_AZURE_GIT_KEY}" \
  -H "Content-Type: application/json" \
  --data "$(printf '{"repository_id":"%s","url":"https://%s/%s"}' "$REPO_ID" "$host" "$path")" \
  "${AIXLE_AZURE_GIT_URL}")" || exit 0

# jq is present in the agent images; the fallback keeps the helper working on a
# custom image without it. Neither ever prints the token anywhere but stdout.
if command -v jq >/dev/null 2>&1; then
  scheme="$(printf '%s' "$body" | jq -r '.scheme // "bearer"')"
  username="$(printf '%s' "$body" | jq -r '.username // ""')"
  password="$(printf '%s' "$body" | jq -r '.password // empty')"
else
  scheme="$(printf '%s' "$body" | sed -n 's/.*"scheme":"\([^"]*\)".*/\1/p')"
  username="$(printf '%s' "$body" | sed -n 's/.*"username":"\([^"]*\)".*/\1/p')"
  password="$(printf '%s' "$body" | sed -n 's/.*"password":"\([^"]*\)".*/\1/p')"
fi
[ -n "${password:-}" ] || exit 0

# Microsoft documents two shapes and they are not interchangeable: Entra tokens
# authenticate as `Authorization: Bearer`, PATs as Basic with any non-empty
# username. Git 2.46+ carries the bearer form natively through `authtype`;
# older Git only understands username/password, and Azure accepts an Entra
# token there as the password with a placeholder username.
if [ "${scheme}" = "bearer" ] && [ "${AIXLE_AZURE_GIT_AUTHTYPE:-0}" = "1" ]; then
  printf 'capability[]=authtype\n'
  printf 'authtype=Bearer\n'
  printf 'credential=%s\n' "$password"
  printf 'ephemeral=1\n'
else
  printf 'username=%s\n' "${username:-aixle}"
  printf 'password=%s\n' "$password"
fi
