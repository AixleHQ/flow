# AWS Configuration
# AWS credentials should be provided via environment variables:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#
# Optional: AWS_REGION can also be set via environment variable

aws_region          = "us-east-1"
tfstate_bucket_name = "palad-tfstate-prod"

# EKS Cluster Configuration
create_eks_cluster = true
eks_cluster_name   = "palad-eks"
eks_cluster_version = "1.35"

# Networking: 2 AZ deployment, single NAT gateway, dedicated VPC for EKS
eks_az_count = 2
eks_vpc_cidr = "10.10.0.0/16"
eks_private_subnet_cidrs = ["10.10.1.0/24", "10.10.2.0/24", "10.10.3.0/24"]
eks_public_subnet_cidrs  = ["10.10.101.0/24", "10.10.102.0/24", "10.10.103.0/24"]

# Public + private endpoint, public endpoint restricted to your CIDR(s)
eks_public_access_cidrs = ["34.1.250.211/32"]

# Route53 alias records to EKS ingress NLB (service tag lookup: namespace/name)
create_eks_dns_records = true
eks_ingress_namespace  = "palad"
eks_ingress_service_name = "traefik"

# Route53 alias records to the staging EKS ingress NLB
create_eks_staging_dns_records = true
eks_staging_ingress_namespace  = "palad-staging"
eks_staging_ingress_service_name = "traefik"

# Dedicated admin DNS record (overrides wildcard for traefik.aixle.com)
create_eks_admin_dns_record   = true
eks_admin_ingress_namespace   = "palad"
eks_admin_ingress_service_name = "traefik-admin"
eks_admin_dns_name            = "traefik.aixle.com"
eks_admin_temporal_dns_name   = "temporal.aixle.com"
eks_admin_grafana_dns_name    = "grafana.aixle.com"
eks_admin_headlamp_dns_name   = "headlamp.aixle.com"

# Traefik IRSA identity for Route53 DNS challenge
eks_traefik_namespace            = "palad"
eks_traefik_service_account_name = "traefik"
eks_staging_traefik_namespace            = "palad-staging"
eks_staging_traefik_service_account_name = "traefik"

# Managed node group (x86, on-demand)
eks_node_group_name     = "palad-on-demand"
eks_node_instance_types = ["t3.large"]
eks_node_ami_type       = "AL2023_x86_64_STANDARD"
eks_node_capacity_type  = "ON_DEMAND"
eks_node_min_size       = 2
eks_node_desired_size   = 2
eks_node_max_size       = 8

# Managed data services (production)
create_managed_data_services = true

# S3 assets bucket for Shrine uploads
create_assets_bucket               = true
assets_bucket_name                 = "palad-assets-prod"
assets_bucket_force_destroy        = false
assets_bucket_versioning_enabled   = true
assets_bucket_cors_allowed_origins = ["https://dev.aixle.com"]

# IRSA role for workloads that upload/read assets from S3
create_assets_irsa               = true
assets_irsa_namespace            = "palad"
assets_irsa_service_account_names = ["palad-web", "palad-worker"]

# CloudFront distribution for static Rails/Vite assets
create_assets_cloudfront_distribution = true
assets_cloudfront_domain_name         = "static.palad.ai"
assets_cloudfront_additional_aliases  = ["static.aixle.com"]
assets_cloudfront_origin_domain_name  = "dev.aixle.com"
assets_cloudfront_price_class         = "PriceClass_100"

# RDS PostgreSQL for Rails app
rds_instance_identifier      = "palad-app-prod"
rds_engine_version           = "18.2"
rds_instance_class           = "db.t4g.medium"
rds_allocated_storage        = 20
rds_max_allocated_storage    = 100
rds_port                     = 5432
rds_db_name                  = "palad_production"
rds_master_username          = "postgres"
rds_master_password          = "replace_with_secure_password_min_16_chars"
rds_backup_retention_period  = 7
rds_backup_window            = "03:00-04:00"
rds_maintenance_window       = "Mon:04:00-Mon:05:00"
rds_deletion_protection      = true
rds_skip_final_snapshot      = true
rds_final_snapshot_identifier = null
rds_apply_immediately        = false

# Dedicated RDS PostgreSQL for Temporal
create_temporal_rds_instance       = true
temporal_rds_instance_identifier   = "palad-temporal-prod"
temporal_rds_engine_version        = "18.2"
temporal_rds_instance_class        = "db.t4g.medium"
temporal_rds_allocated_storage     = 20
temporal_rds_max_allocated_storage = 100
temporal_rds_port                  = 5432
temporal_rds_db_name               = "temporal"
temporal_rds_master_username       = "postgres"
temporal_rds_master_password       = "replace_with_secure_password_min_16_chars"
temporal_rds_backup_retention_period = 7
temporal_rds_backup_window         = "04:00-05:00"
temporal_rds_maintenance_window    = "Mon:05:00-Mon:06:00"
temporal_rds_deletion_protection   = true
temporal_rds_skip_final_snapshot   = true
temporal_rds_final_snapshot_identifier = null
temporal_rds_apply_immediately     = false

# ElastiCache Redis for Rails cache/cable/jobs
redis_replication_group_id       = "palad-redis-prod"
redis_engine_version             = "7.1"
redis_node_type                  = "cache.t3.small"
redis_port                       = 6379
redis_parameter_group_name       = "default.redis7"
redis_num_cache_clusters         = 1
redis_transit_encryption_enabled = false
redis_auth_token                 = null
redis_snapshot_retention_limit   = 1
redis_maintenance_window         = "mon:05:00-mon:06:00"
redis_apply_immediately          = false

# GitHub Actions self-hosted CI runner on EC2
# GitHub App bootstrap secrets are stored in SSM Parameter Store by Terraform when enabled.
create_ci_runner_instance = false
ci_runner_instance_name   = "palad-ci-runner"
ci_runner_name_prefix     = "palad-ci"
ci_runner_instance_type   = "t3.large"
ci_runner_count           = 1
ci_runner_root_volume_size = 100
ci_runner_subnet_type     = "private"
ci_runner_subnet_index    = 0
ci_runner_labels          = ["palad-ci"]
ci_runner_github_owner    = "palad-ai"
ci_runner_github_repo     = "palad-app"
ci_runner_manage_bootstrap_parameters = true
ci_runner_github_app_id_ssm_parameter_name = "/palad/github-runner/app-id"
ci_runner_github_app_installation_id_ssm_parameter_name = "/palad/github-runner/installation-id"
ci_runner_github_app_private_key_ssm_parameter_name = "/palad/github-runner/private-key"
ci_runner_github_app_id_value = "1234567"
ci_runner_github_app_installation_id_value = "12345678"
ci_runner_github_app_private_key_value = <<EOF
-----BEGIN RSA PRIVATE KEY-----
replace_me
-----END RSA PRIVATE KEY-----
EOF
# Optional SSH fallback. Leave empty to rely on SSM only.
ci_runner_ssh_key_name      = null
ci_runner_ssh_ingress_cidrs = []
