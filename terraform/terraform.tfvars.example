# AWS Configuration
# AWS credentials should be provided via environment variables:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#
# Optional: AWS_REGION can also be set via environment variable

aws_region          = "us-east-1"
tfstate_bucket_name = "palad-tfstate-prod"

# EKS Cluster Configuration
create_eks_cluster = true
eks_cluster_name   = "palad-eks"
eks_cluster_version = "1.35"

# Networking: 2 AZ deployment, single NAT gateway, dedicated VPC for EKS
eks_az_count = 2
eks_vpc_cidr = "10.10.0.0/16"
eks_private_subnet_cidrs = ["10.10.1.0/24", "10.10.2.0/24", "10.10.3.0/24"]
eks_public_subnet_cidrs  = ["10.10.101.0/24", "10.10.102.0/24", "10.10.103.0/24"]

# Public + private endpoint, public endpoint restricted to your CIDR(s)
eks_public_access_cidrs = ["212.58.121.200/32"]

# Route53 alias records to EKS ingress NLB (service tag lookup: namespace/name)
create_eks_dns_records = true
eks_ingress_namespace  = "palad"
eks_ingress_service_name = "traefik"

# Dedicated admin DNS record (overrides wildcard for traefik.palad.ai)
create_eks_admin_dns_record   = true
eks_admin_ingress_namespace   = "palad"
eks_admin_ingress_service_name = "traefik-admin"
eks_admin_dns_name            = "traefik.palad.ai"
eks_admin_temporal_dns_name   = "temporal.palad.ai"

# Traefik IRSA identity for Route53 DNS challenge
eks_traefik_namespace            = "palad"
eks_traefik_service_account_name = "traefik"

# Managed node group (x86, on-demand)
eks_node_group_name     = "palad-on-demand"
eks_node_instance_types = ["t3.large"]
eks_node_ami_type       = "AL2023_x86_64_STANDARD"
eks_node_capacity_type  = "ON_DEMAND"
eks_node_min_size       = 2
eks_node_desired_size   = 2
eks_node_max_size       = 4
