# Format of the STAGING_CREDENTIALS_SECRETS.txt asset that QA agents read with
# loadCredentialsAsset(page) — see README.md. The helpers do not read .env or
# process.env. To use your own copy, fill this in, keep it out of git, and pass
# its absolute path: loadCredentialsAsset(page, '/path/to/file').

# Base URL (optional, defaults to staging).
STAGING_URL="https://staging.flow.aixle.com"

# email:password
STAGING_COMPANY_ADMIN_CREDENTIALS=""
STAGING_COMPANY_EMPLOYEE_CREDENTIALS=""

# email:password of a platform super admin, for loginAsAdmin (optional).
STAGING_ADMIN_CREDENTIALS=""

# user:password for HTTP Basic Auth. Only staging's public, internet-facing entry
# asks for it; leave it empty from inside the VPCs or over the VPN.
STAGING_HTTP_CREDENTIALS=""
