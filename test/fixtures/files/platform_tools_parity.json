  {
    "name": "coder_allocate_machine",
    "kind": "system",
    "display_name": "Coder: Allocate Machine",
    "description": "Allocate a Coder workspace for the current terminal session. Picks an available workspace from the integration's pool (or creates one if a default template is configured), locks it to the current terminal session, and returns the workspace identity (name, id, ssh command, lock expiry).",
    "execution_mode": "app",
    "requires_integration": null,
    "input_schema": {
      "type": "object",
      "required": [],
      "properties": {
        "note": {
          "type": "string",
          "description": "Optional free-form note recorded on the workspace lock (audit / debug aid). Do NOT include the task id or task link — task context is derived server-side."
        }
      }
    }
  },
  {
    "name": "coder_release_machine",
    "kind": "system",
    "display_name": "Coder: Release Machine",
    "description": "Release the Coder workspace lock for the given workspace. Idempotent — returns success whether or not a lock was held. The step's teardown also auto-releases any locks held by this session.",
    "execution_mode": "app",
    "requires_integration": null,
    "input_schema": {
      "type": "object",
      "required": [
        "workspace_name"
      ],
      "properties": {
        "workspace_name": {
          "type": "string",
          "description": "Workspace name returned by coder_allocate_machine."
        }
      }
    }
  },
  {
    "name": "coder_ssh_exec",
    "kind": "system",
    "display_name": "Coder: Run Command (SSH)",
    "description": "Run a shell command on a Coder workspace previously allocated by this step. Returns the exit code, stdout, stderr, and a `truncated` marker if the response exceeded the inline budget.",
    "execution_mode": "app",
    "requires_integration": null,
    "input_schema": {
      "type": "object",
      "required": [
        "workspace_name",
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command to execute (run via sh -c)."
        },
        "workspace_name": {
          "type": "string",
          "description": "Workspace name returned by coder_allocate_machine."
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "Per-call timeout in seconds. Default 60, max 600."
        }
      }
    }
  },
  {
    "name": "fail_session",
