# Full restored .gitignore with web first, then Python merge

# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# web-specific
/web/tmp/
/web/log/
web/.bundle

# Ignore all environment files.
web/.env*
!web/.env.example

# Ignore all logfiles and tempfiles.
web/log/*
web/tmp/*
!/web/log/.keep
!/web/tmp/.keep

# Ignore pidfiles, but keep the directory.
web/tmp/pids/*
!/web/tmp/pids/
!/web/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
web/storage/*
!/web/storage/.keep
web/tmp/storage/*
!/web/tmp/storage/
!/web/tmp/storage/.keep

web/public/assets

# Ignore master key for decrypting credentials and more.
web/config/master.key
web/app/temporal/workflows.yml
web_reference
initializer_reference

web/.yarn/*
!web/.yarn/patches
!web/.yarn/plugins
!web/.yarn/releases
!web/.yarn/sdks
!web/.yarn/versions

# Vite Ruby
web/.vite
web/public/vite*
web/public/cache
web/public/store

# Node modules (all levels)
node_modules/
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local
web/coverage

web/.env.development

# Private individual user cursor rules
.cursor/rules/_*.mdc
web/.byebug_history

web/.ruby-lsp/

web/docker/remote/db_dumps/*
!/web/docker/remote/db_dumps/.keep

# Byte-compiled / optimized / DLL files
ai-engine/app/__pycache__/
ai-engine/app/*.py[cod]
ai-engine/app/*$py.class

# C extensions
ai-engine/app/*.so

