# Full restored .gitignore with web first, then Python merge

# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# web-specific
/tmp/
/log/
.bundle

# Ignore all environment files.
.env*
!.env.example

# Ignore all logfiles and tempfiles.
log/*
tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
storage/*
!/storage/.keep
tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

public/assets

# Ignore master key for decrypting credentials and more.
config/master.key
web_reference
initializer_reference

.yarn/

# Vite Ruby
.vite
public/vite*
public/cache
public/store

# Node modules (all levels)
# No trailing slash: worktrees symlink node_modules at the repo root, and a
# `node_modules/` pattern matches directories only, so the symlink got committed.
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local
coverage

.env.development

# Cursor IDE (rules, skills, local config)
.cursor/
.cursorignore
.cursorindexingignore
.byebug_history
.impeccable/

.ruby-lsp/

docker/remote/db_dumps/*
!/docker/remote/db_dumps/.keep

# IDE
**/.vscode/
ai-engine/app/.idea/
.idea

# OS
**/.DS_Store
.DS_Store
ai-engine/app/Thumbs.db
.agents/

docker/remote/db_dumps/latest.sql.gz

# Personal AI memos
.playwright-mcp/
.stitch/
.claude/
docker/tools/
_bmad/
_bmad-output/
.codegraph/
docs/superpowers/

# local AWS Bedrock-driven development
.aws/
bin/aws-login
bin/dbp-ai
docker/aws-config.workstation.example
